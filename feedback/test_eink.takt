system:
    language = 1
    tick = 1 ms
    target = baremetal
    float = f32

# ==============================================================================
# Hardware-Schnittstellen und Protokoll-Definitionen für E-Ink Display (SSD1680)
# Auflösung: 200x200 Pixel, 1-Bit Monochrom (25 Bytes pro Zeile, 5000 Bytes Frame)
# ==============================================================================

# --- Physische I/O Channels ---
output epd_cs_n     : bool          @ hw("spi0/cs0")       with safe = true
output epd_dc       : bool          @ hw("gpio/epd_dc")    with safe = false
output epd_rst_n    : bool          @ hw("gpio/epd_rst")   with safe = true
output epd_pwr_en   : bool          @ hw("gpio/epd_pwr")   with safe = false
output spi_tx       : stream<u8>    @ hw("spi0/tx")        with max_rate = 2000000 Hz, capacity = 512

input  epd_busy_raw : bool          @ hw("gpio/epd_busy")  with debounce = 3, max_age = 5 ms
input  vdd_sense    : float[V] in 2.0..4.0 V       @ hw("adc/vdd")     with max_age = 50 ms
input  ambient_temp : float[degC] in -30..70 degC @ hw("sensor/temp") with max_age = 500 ms

# --- Operative Steuer-Kommandos ---
command cmd_init
command cmd_trigger_refresh
command cmd_deep_sleep
command cmd_clear_fault

# --- Datenstrukturen für rasterbasiertes Frame-Streaming ---
record PixelRow layout little:
    row_idx : u8 in 0..199
    pixels  : bytes<25>

# Interner Zeilen-Stream zur Entkopplung ohne statischen 5-KB-Frame-Buffer
stream<PixelRow> display_stream with capacity = 16

enum EpdStatus:
    OFF
    BOOTING
    READY
    STREAMING
    REFRESHING
    SLEEPING
    FAULT

# ==============================================================================
# Reine Hilfsfunktionen (Zero-Allocation, deterministische Puffer-Serialisierung)
# ==============================================================================

fn cmd1(c: u8) -> bytes<1>:
    var b : bytes<1> = default
    b.push(c)
    return b

fn make_driver_output(mux_gates: u8) -> bytes<3>:
    var b : bytes<3> = default
    b.push(mux_gates)
    b.push(0x00)
    b.push(0x00)
    return b

fn make_ram_x_window(x_start: u8, x_end: u8) -> bytes<2>:
    var b : bytes<2> = default
    b.push(x_start)
    b.push(x_end)
    return b

fn make_ram_y_window(y_start: u16, y_end: u16) -> bytes<4>:
    var b : bytes<4> = default
    b.push((y_start & 0xFF) as u8)
    b.push(((y_start >> 8) & 0x01) as u8)
    b.push((y_end & 0xFF) as u8)
    b.push(((y_end >> 8) & 0x01) as u8)
    return b

fn make_ram_y_counter(y: u16) -> bytes<2>:
    var b : bytes<2> = default
    b.push((y & 0xFF) as u8)
    b.push(((y >> 8) & 0x01) as u8)
    return b

# ==============================================================================
# Haupttreiber-Maschine: Zustandssteuerung, Booster-Schutz & Refresh-Sequenzierung
# ==============================================================================

machine epd_controller every 1 ms:
    fault -> SAFE_DISCHARGE

    # Lebensdauer- und Diagnose-Tracking.
    # `persist` ist v1.1 (5.9) und wird heute mit SC-3 abgelehnt — die
    # Zaehler stehen hier als das, was der Treiber wirklich braucht.
    persist var total_refreshes : int in 0..1000000 = 0 with min_interval = 10 s
    persist var fault_counter   : int in 0..10000   = 0 with min_interval = 5 s

    pub var status        : EpdStatus = OFF
    pub var rows_written  : int in 0..200 = 0
    pub var last_duration : Duration = 0 ms

    var refresh_start_time : Duration = 0 ms

    initial POWER_OFF

    # --------------------------------------------------------------------------
    # Ruhezustand (Stromlos, Busse inaktiv)
    # --------------------------------------------------------------------------
    state POWER_OFF:
        enter:
            status = OFF
            epd_cs_n = true
            epd_dc = false
            epd_rst_n = false
            epd_pwr_en = false
            rows_written = 0

        when cmd_init: -> POWER_ON_SEQ

    # --------------------------------------------------------------------------
    # Operativer Überwachungszustand (Interlocks aktiv)
    # --------------------------------------------------------------------------
    state OPERATING:
        initial POWER_ON_SEQ

        loop:
            # Spannungsüberwachung: Brownout während Display-Refresh zerstört Panel-Ladungen
            check vdd_sense >= 2.7 V, "Brownout prevention: VDD < 2.7V"

            # Physikalische Grenzen von elektrophoretischen Displays (Partikelkristallisation)
            check ambient_temp >= 0 degC, "Operating temp too low (< 0 degC)"
            check ambient_temp <= 50 degC, "Operating temp too high (> 50 degC)"

            alert ambient_temp < 10 degC, "Low temp: update waveform requires extended timing"

        # ----------------------------------------------------------------------
        # Power-Up & Hardware-Reset-Timing
        # ----------------------------------------------------------------------
        state POWER_ON_SEQ:
            enter:
                status = BOOTING

            sequence:
                epd_pwr_en = true
                wait 10 ms
                epd_rst_n = false
                wait 10 ms
                epd_rst_n = true
                wait 15 ms
                until not epd_busy_raw timeout 100 ms -> SAFE_DISCHARGE
                -> INIT_REGISTERS

        # ----------------------------------------------------------------------
        # Initialisierung der Controller-Register (SSD1680)
        # ----------------------------------------------------------------------
        state INIT_REGISTERS:
            sequence:
                # SW Reset (0x12)
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x12)
                wait 1 ms
                epd_cs_n = true
                wait 5 ms
                until not epd_busy_raw timeout 50 ms -> SAFE_DISCHARGE

                # Driver Output Control (0x01): 200 MUX Gates (0xC7, 0x00, 0x00)
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x01)
                wait 1 ms
                epd_dc = true
                send spi_tx, make_driver_output(199)
                wait 1 ms
                epd_cs_n = true
                wait 1 ms

                # Data Entry Mode (0x11): X-Increment, Y-Increment (0x03)
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x11)
                wait 1 ms
                epd_dc = true
                send spi_tx, cmd1(0x03)
                wait 1 ms
                epd_cs_n = true
                wait 1 ms

                # Set RAM X-Address Range (0x44): 0x00 bis 0x18 (25 Bytes = 200 Pixel)
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x44)
                wait 1 ms
                epd_dc = true
                send spi_tx, make_ram_x_window(0, 24)
                wait 1 ms
                epd_cs_n = true
                wait 1 ms

                # Set RAM Y-Address Range (0x45): 0x0000 bis 0x00C7 (200 Pixel)
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x45)
                wait 1 ms
                epd_dc = true
                send spi_tx, make_ram_y_window(0, 199)
                wait 1 ms
                epd_cs_n = true
                wait 1 ms

                # Border Waveform Control (0x3C): VBD -> VSS
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x3C)
                wait 1 ms
                epd_dc = true
                send spi_tx, cmd1(0x05)
                wait 1 ms
                epd_cs_n = true
                -> READY

        # ----------------------------------------------------------------------
        # Betriebsbereiter Zustand (Warten auf Bilddaten oder Sleep)
        # ----------------------------------------------------------------------
        state READY:
            enter:
                status = READY
                epd_cs_n = true
                epd_dc = false

            # BEFUND (im Sim-Lauf sichtbar geworden): Dieser Guard
            # *konsumiert* die erste Zeile — „untersucht heisst konsumiert"
            # (8.6) —, und `first_row` wird nirgends benutzt. Der Treiber
            # bekommt darum nur 199 der 200 gesendeten Zeilen, `rows_written`
            # erreicht nie 200 und `STREAMING_ROWS` laeuft in sein
            # 10-s-Timeout nach SAFE_DISCHARGE.
            when display_stream as first_row: -> PREPARE_RAM_LOAD
            when cmd_deep_sleep: -> ENTER_SLEEP

        # ----------------------------------------------------------------------
        # SRAM-Adress-Cursor auf Anfang setzen
        # ----------------------------------------------------------------------
        state PREPARE_RAM_LOAD:
            enter:
                status = STREAMING
                rows_written = 0

            sequence:
                # Set RAM X Counter (0x4E) auf 0
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x4E)
                wait 1 ms
                epd_dc = true
                send spi_tx, cmd1(0)
                wait 1 ms
                epd_cs_n = true
                wait 1 ms

                # Set RAM Y Counter (0x4F) auf 0
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x4F)
                wait 1 ms
                epd_dc = true
                send spi_tx, make_ram_y_counter(0)
                wait 1 ms
                epd_cs_n = true
                wait 1 ms

                # Write Black/White RAM Command (0x24)
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x24)
                wait 1 ms
                epd_dc = true
                -> STREAMING_ROWS

        # ----------------------------------------------------------------------
        # Zeilenweises Framebuffer-Streaming über Internal Stream
        # ----------------------------------------------------------------------
        state STREAMING_ROWS:
            on display_stream as row:
                send spi_tx, row.data.pixels
                rows_written += 1

            when rows_written >= 200: -> FINALIZE_TRANSFER
            after 10 s: -> SAFE_DISCHARGE

        state FINALIZE_TRANSFER:
            enter:
                epd_cs_n = true
                epd_dc = false

            when cmd_trigger_refresh: -> EXECUTE_REFRESH
            after 50 ms: -> EXECUTE_REFRESH

        # ----------------------------------------------------------------------
        # Aktualisierungs-Wellenform auslösen (Master Activation)
        # ----------------------------------------------------------------------
        state EXECUTE_REFRESH:
            enter:
                status = REFRESHING
                refresh_start_time = now

            sequence:
                # Display Update Control 2 (0x22): Enable Clock -> Enable Analog -> Display -> Disable
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x22)
                wait 1 ms
                epd_dc = true
                send spi_tx, cmd1(0xF7)
                wait 1 ms
                epd_cs_n = true
                wait 1 ms

                # Master Activation (0x20)
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x20)
                wait 1 ms
                epd_cs_n = true
                wait 10 ms
                -> AWAIT_PANEL_BUSY

        # ----------------------------------------------------------------------
        # Warten auf Panel-Ladungspumpe und Partikel-Refresh
        # ----------------------------------------------------------------------
        state AWAIT_PANEL_BUSY:
            loop:
                # Hardware-Schutz: Hochspannungstransformatoren dürfen nie unbegrenzt feuern
                check time_in_state < 15 s, "Booster charge-pump timeout (panel damaged or busy pin stuck)"
                alert time_in_state > 4 s, "Panel refresh taking longer than nominal (waveform timing extended)"

            when not epd_busy_raw:
                last_duration = now - refresh_start_time
                if total_refreshes < 1000000:
                    total_refreshes += 1
                -> READY

        # ----------------------------------------------------------------------
        # Geordnetes Herunterfahren des Displays in Deep Sleep
        # ----------------------------------------------------------------------
        state ENTER_SLEEP:
            enter:
                status = SLEEPING

            sequence:
                # Deep Sleep Command (0x10): Mode 1 (Preserve RAM, Power off analog)
                epd_cs_n = false
                epd_dc = false
                send spi_tx, cmd1(0x10)
                wait 1 ms
                epd_dc = true
                send spi_tx, cmd1(0x01)
                wait 1 ms
                epd_cs_n = true
                wait 100 ms

                # Rail Isolation
                epd_rst_n = false
                epd_dc = false
                epd_pwr_en = false
                -> POWER_OFF

    # --------------------------------------------------------------------------
    # Sicherheitszustand: Entladen der Hochspannungen & Pin-Isolierung
    # --------------------------------------------------------------------------
    state SAFE_DISCHARGE:
        enter:
            status = FAULT
            epd_cs_n = true
            epd_dc = false
            epd_rst_n = false
            epd_pwr_en = false
            if fault_counter < 10000:
                fault_counter += 1

        when cmd_clear_fault and vdd_sense >= 2.8 V: -> POWER_OFF

# ==============================================================================
# Streckenmodell fuer den Sim-Build (8.3)
#
# Ein Plant-Modell ist eine gewoehnliche Maschine: Es liest die `hw`-Outputs
# des Treibers mit Unit-Delay und schreibt die `sim`-Outputs. Im
# Hardware-Build wird es nicht gelinkt, die Steuerlogik bleibt byteidentisch.
#
# Was das Modell *nicht* sehen kann: die gesendeten Bytes. Ein Ausgabestrom
# wird vom Treiberrand mit `max_rate` geleert (8.8), und das Modell liest
# davon nur `spi_tx.free` — den freien Platz zu Tickbeginn. Ein Panel, das
# auf `0x20` (Master Activation) reagieren muesste, ist so nicht
# nachzubilden. Das Modell nimmt deshalb die Stelle, an der der Treiber
# ohnehin auf BUSY wartet: Nach dem Reset und nach jedem `AWAIT_PANEL_BUSY`
# haelt es BUSY fuer eine feste Dauer. Das genuegt fuer den Zweck — zu
# pruefen, ob die Zustandskette laeuft — und es sagt ehrlich, wo die Grenze
# liegt.
# ==============================================================================

output epd_busy_sim : bool             @ sim("gpio/epd_busy")
output vdd_sim      : float[V]         @ sim("adc/vdd")
output temp_sim     : float[degC]      @ sim("sensor/temp")

machine epd_panel every 1 ms:
    # Restlaufzeit der aktuellen Panel-Beschaeftigung.
    var busy_left : Duration in 0 ms..20 s = 0 ms

    initial UNPOWERED

    loop:
        # Versorgung und Temperatur sind hier konstant; ein Szenario, das
        # Brownout oder Kaeltebetrieb prueft, wuerde genau diese beiden
        # Zeilen ersetzen.
        vdd_sim  = 3.3 V
        temp_sim = 22.0 degC

    state UNPOWERED:
        enter:
            epd_busy_sim = false
        # Der Treiber zieht RST auf low und wieder auf high (POWER_ON_SEQ);
        # das Panel meldet sich danach kurz beschaeftigt.
        when epd_pwr_en and epd_rst_n:
            busy_left = 20 ms
            -> BUSY

    state IDLE:
        enter:
            epd_busy_sim = false
        # Ein Refresh laeuft ueber `EXECUTE_REFRESH` nach `AWAIT_PANEL_BUSY`.
        # Das Modell erkennt ihn daran, dass der Treiber dort steht.
        when epd_controller.status == REFRESHING:
            busy_left = 1200 ms
            -> BUSY
        when not epd_pwr_en: -> UNPOWERED

    state BUSY:
        enter:
            epd_busy_sim = true
        loop:
            if busy_left > 1 ms:
                busy_left -= 1 ms
            else:
                busy_left = 0 ms
        when busy_left == 0 ms: -> SETTLING
        when not epd_pwr_en: -> UNPOWERED

    # BUSY ist gefallen, der Treiber hat es aber noch nicht gesehen: Er
    # steht bis zu seinem naechsten Tick in `REFRESHING`. Ohne diesen
    # Zwischenschritt wuerde `IDLE` sofort einen neuen Refresh erkennen und
    # das Panel endlos beschaeftigen.
    state SETTLING:
        enter:
            epd_busy_sim = false
        when epd_controller.status != REFRESHING: -> IDLE
        when not epd_pwr_en: -> UNPOWERED

# Bildgeber: speist `display_stream` mit 200 Zeilen, sobald der Treiber
# bereit ist. Ein interner Stream wird per `send` gespeist (8.3); der
# Kapazitaet von 16 wegen eine Zeile je Tick, was der Treiber mit einer
# Zeile je Tick abholt.
machine frame_source every 1 ms:
    var next_row : int in 0..200 = 0

    initial WAIT

    state WAIT:
        when epd_controller.status == READY: -> FEED

    # Der Zaehler laeuft bis 200 und der Wechsel erst danach: Beim Stand 200
    # ist die letzte Zeile gesendet, aber der Treiber holt sie erst im
    # folgenden Tick ab (`on` je Aktivierung ein Element). Ein Wechsel bei
    # `>= 200` wuerde den Bildgeber eine Zeile zu frueh stilllegen, und
    # `STREAMING_ROWS` liefe in sein 10-s-Timeout.
    state FEED:
        loop:
            if next_row < 200:
                send display_stream, PixelRow(row_idx = next_row as u8, pixels = default)
                next_row += 1
        when epd_controller.rows_written >= 200: -> DONE

    state DONE:
        loop:
            pass