system:
    language = 1
    tick     = 10 ms

# 12.7: Nach 50 ms beendet das Programm seinen Lauf; der naechste soll zehn
# Sekunden spaeter beginnen. Der Trace endet mit `end after`, danach stehen
# alle Outputs auf `safe`.

input  previous_run : PreviousRun @ hw("sys/previous_run")
output previous_sim : PreviousRun @ sim("sys/previous_run")
output next_run     : NextRun     @ hw("sys/next_run") with safe = NONE
output led          : bool        @ hw("ui/led")       with safe = false

machine m:
    initial RUN

    state RUN:
        enter:
            led = true
        after 50 ms: -> OFF

    state OFF:
        enter:
            led = false
            next_run = AFTER(delay = 10 s)
