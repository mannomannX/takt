system:
    language = 1
    tick     = 10 ms

# `resume` (5.12): WORK merkt sich seinen zuletzt aktiven Kindpfad; der
# Weg ueber PAUSE und zurueck betritt ihn wieder statt `initial`.
# Der Wechsel geht ueber Commands, damit die `after`-Fristen alle auf
# derselben Ebene liegen.

command pause
command work

output phase  : int in 0..9 @ hw("o/phase")  with safe = 0
output paused : bool        @ hw("o/paused") with safe = false

machine m:
    initial WORK

    state WORK resume:
        initial FIRST

        enter:
            paused = false

        when pause: -> PAUSE

        state FIRST:
            enter:
                phase = 1

            after 20 ms: -> SECOND

        state SECOND:
            enter:
                phase = 2

    state PAUSE:
        enter:
            paused = true

        when work: -> WORK
