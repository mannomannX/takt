# 83 — Dauern im Trace (3.3, 9.3, T2): Der Interpreter schreibt eine Dauer
# in ihrer groessten ganzzahligen Einheit, und jeder Rahmen schreibt sie
# ebenso — als Wert und als Feld einer Variante, auch negativ und null.

system:
    language = 1
    tick     = 10 ms

enum Plan: IDLE, WAIT(d: Duration), MOVE(steps: int in 0..100, d: Duration)

output delay  : Duration @ hw("o/delay")  with safe = 0 s
output plan   : Plan     @ hw("o/plan")   with safe = IDLE
output waited : Duration @ hw("o/waited") with safe = 0 s

machine m:
    var k : int in 0..4 = 0

    initial RUN

    state RUN:
        loop:
            var p : Plan = IDLE
            if k == 0:
                delay = 90 min
                p = MOVE(steps = 3, d = 2 s)
            elif k == 1:
                delay = 1500 ms
                p = WAIT(d = 250 us)
            elif k == 2:
                delay = 7 ns
                p = WAIT(d = -3 ms)
            elif k == 3:
                delay = 36 h
            else:
                delay = 0 s
            plan = p
            match p:
                case WAIT(d):
                    waited = d
                case MOVE(steps, d):
                    waited = d
                case _:
                    waited = 0 s
            k = (k + 1) % 5
