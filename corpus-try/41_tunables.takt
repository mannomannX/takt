system:
    language = 1
    tick     = 10 ms

# Tunables (8.4): ein Parameter, der sich waehrend des Laufs aendern darf —
# ein Input mit Halte-Semantik. Der Stimulus setzt ihn mit `tune`-Zeilen;
# ausserhalb der Range wird die Zeile verworfen.

tunable param GAIN : int in 0..100 = 2

output y : int in 0..100000 @ hw("o/y") with safe = 0

machine m:
    var k : int in 0..1000 = 0
    initial RUN
    state RUN:
        loop:
            k = k + 1
            y = k * GAIN
