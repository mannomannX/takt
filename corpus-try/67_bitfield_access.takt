system:
    language = 1
    tick     = 10 ms

# Zugriffsarten an Bitfeldern (3.7, v1.2): `ro` liest nur, `w1c` loescht
# durch Schreiben einer Eins, `rsvd` ist weder lesbar noch schreibbar,
# `active_low` kehrt den logischen Wert an der Grenze um.
#
# Der Unterschied steht in der MIR: `overflow` senkt auf
# `0.with_bit(1, true)` — ohne Lese-Modifiziere-Schreibe, damit ein
# Schreibvorgang keine ungesehenen Ereignisse loescht. `enable` senkt wie
# bisher auf `sr.0.with_bit(2, true)`.

record UartStatus layout little:
    flags : u8 with bits:
        tx_full  : bool at 0 ro
        overflow : bool at 1 w1c
        enable   : bool at 2
        nrst     : bool at 3 active_low
        reserved : u8 at 4..7 rsvd

output sr : UartStatus @ hw("o/sr") with safe = default
output f  : bool       @ hw("o/f")  with safe = false

machine ctrl:
    initial RUN

    state RUN:
        loop:
            f = sr.flags.tx_full
            sr.flags.overflow = true
            sr.flags.enable = true
            sr.flags.nrst = false

        after 1 s: -> RUN
