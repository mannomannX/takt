system:
    language = 1
    tick     = 1 ms

# Das Journal als Log (5.9, Version 2 von `takt-rt-core`): Ein Vorgang
# haengt seinen Eintrag im aktiven Slot an, auf vier Byte ausgerichtet;
# ist der Slot voll oder steht hinter dem letzten gueltigen Eintrag ein
# Rest, loescht er den anderen Slot und beginnt dort. Ein Slot sind hier
# 128 Byte ab `BASE` = 192 in seinem Sektor und fasst drei Eintraege;
# sieben Vorgaenge fuellen Slot 0, Slot 1 und wieder Slot 0. Beim Start
# gewinnt der gueltige Eintrag mit der hoechsten Sequenznummer. Der Slot
# reicht ueber die Chunkgrenze bei 256: Ein im Loeschen abgebrochener
# Sektor laesst seine zweite Haelfte stehen.
#
# `CUT` laesst den Strom nach so vielen Bytes wegbleiben: Der Neustart
# findet den letzten abgeschlossenen oder den gerade geschriebenen Stand,
# und das Programm schreibt von dort weiter bis zum siebten. `FLIP`
# verfaelscht die Nutzlast des letzten Vorgangs nach dem CRC: Der Start
# verwirft ihn und findet den sechsten. `CUT_CHUNK` schneidet den Strom
# im Loeschen nach so vielen Chunks (8.11): Die drei Loeschvorgaenge
# haben je 16, und der dritte trifft Slot 0 mit den Eintraegen der ersten
# Generation.

native fn crc32(b: bytes<64>) -> u32 with cost = {i32: 1000}, stack = 64, total

param CUT       : int in 0..1000 = 0
param CUT_CHUNK : int in 0..1000 = 0
param FLIP      : int in 0..1 = 0

const SLOT   : int = 128
const BASE   : int = 192
const WRITES : int = 7
const LOGIC  : int = 0x7A6B

output flash_cmd        : FlashCmd            @ hw("flash/cmd")    with safe = NONE
output flash_data       : stream<u8>          @ hw("flash/tx")     with max_rate = 4000 Hz, capacity = 96
input  flash_status     : FlashStatus         @ hw("flash/status") with max_age = 10 ms
input  flash_rx         : stream<bytes<4096>> @ hw("flash/rx")     with max_rate = 200 Hz, capacity = 2
output flash_status_sim : FlashStatus         @ sim("flash/status")
output flash_rx_sim     : stream<bytes<4096>> @ sim("flash/rx")    with capacity = 4096
input  flash_seed       : stream<u8>          @ hw("flash/seed")   with max_rate = 200 kHz, capacity = 256
input  flash_seed_addr  : int in 0..4194304   @ hw("flash/seed_addr")

instance flash = flash_model(cmd = flash_cmd, data = flash_data, status = flash_status_sim, rx = flash_rx_sim, seed = flash_seed, seed_addr = flash_seed_addr, sectors = 2, t_erase = 2 ms, t_program = 1 ms, cut_at_byte = CUT, cut_at_chunk = CUT_CHUNK)

# Ein Eintrag, wie `read_entry` ihn prueft.
record Entry:
    good   : bool
    length : int in 0..8
    seqno  : int in 0..1000
    value  : int in 0..1000

# Was das Durchsehen eines Slots ergab (`scan_slot`).
record Scan:
    found : bool
    seqno : int in 0..1000
    value : int in 0..1000
    end   : int in 0..128
    clean : bool

fn le32(v: int) -> bytes<4>:
    var b : bytes<4> = default
    b.push((v & 0xFF) as u8)
    b.push(((v >> 8) & 0xFF) as u8)
    b.push(((v >> 16) & 0xFF) as u8)
    b.push(((v >> 24) & 0xFF) as u8)
    return b

fn read32(page: bytes<4096>, pos: int) -> int:
    return (page[pos] as int) | ((page[pos + 1] as int) << 8) | ((page[pos + 2] as int) << 16) | ((page[pos + 3] as int) << 24)

# Kopf und Nutzlast, auf vier Byte ausgerichtet.
fn entry_len(n: int) -> int:
    return (32 + n + 3) / 4 * 4

# Die Nutzlast des Vorgangs k: `w` und k.
fn payload_of(k: int) -> bytes<8>:
    var b     : bytes<8> = default
    var value : bytes<4> = le32(k)
    b.push(0x77)
    for x in value:
        b.push(x)
    return b

# Der Kopf aus `takt-rt-core`: Magic TKPJ, Version 2, Sequenznummer und
# Logik-Hash als u64, Laenge, CRC32 ueber die ersten 28 Byte und die
# Nutzlast.
fn entry_header(seq: int, payload: bytes<8>) -> bytes<32>:
    var h      : bytes<32> = default
    var buf    : bytes<64> = default
    var magic  : bytes<4> = le32(0x4A504B54)
    var seqb   : bytes<4> = le32(seq)
    var logic  : bytes<4> = le32(LOGIC)
    var length : bytes<4> = le32(payload.len)
    for x in magic:
        h.push(x)
    h.push(2)
    for i in range(3):
        h.push(0)
    for x in seqb:
        h.push(x)
    for i in range(4):
        h.push(0)
    for x in logic:
        h.push(x)
    for i in range(4):
        h.push(0)
    for x in length:
        h.push(x)
    for x in h:
        buf.push(x)
    for x in payload:
        buf.push(x)
    var sum : bytes<4> = le32(crc32(buf) as int)
    for x in sum:
        h.push(x)
    return h

# Der Eintrag an `pos`: gueltig, wenn Magic, Version, Logik-Hash, Laenge
# und CRC passen.
fn entry_at(page: bytes<4096>, pos: int) -> Entry:
    var e      : Entry = default
    var length : int = 0
    var buf    : bytes<64> = default
    if pos + 32 > page.len:
        return e
    if read32(page, pos) != 0x4A504B54:
        return e
    if (read32(page, pos + 4) & 0xFFFF) > 2:
        return e
    if read32(page, pos + 16) != LOGIC or read32(page, pos + 20) != 0:
        return e
    length = read32(page, pos + 24)
    if length > 8 or pos + entry_len(length) > page.len:
        return e
    for i in range(28):
        buf.push(page[pos + i])
    for i in range(8):
        if i < length:
            buf.push(page[pos + 32 + i])
    if (crc32(buf) as int) != read32(page, pos + 28):
        return e
    e.good = true
    e.length = length
    e.seqno = read32(page, pos + 8)
    if length == 5:
        e.value = read32(page, pos + 33)
    return e

# Die Eintraege eines Slots bis zum ersten ungueltigen; angehaengt werden
# darf nur, wenn der Rest dahinter geloescht ist.
fn scan(page: bytes<4096>) -> Scan:
    var s    : Scan = default
    var e    : Entry = default
    var pos  : int = 0
    var more : bool = true
    for i in range(4):
        if more:
            e = entry_at(page, pos)
            if e.good:
                if not s.found or e.seqno > s.seqno:
                    s.found = true
                    s.seqno = e.seqno
                    s.value = e.value
                pos = pos + entry_len(e.length)
            else:
                more = false
    s.end = pos
    s.clean = true
    for i in range(SLOT):
        if i >= pos and page[i] != 0xFF:
            s.clean = false
    return s

machine journal:
    var payload : bytes<8> = default
    var header  : bytes<32> = default
    var a       : Scan = default
    var b       : Scan = default
    var slot    : int in 0..1 = 0
    var free    : int in 0..128 = 0
    var clean   : bool = false
    var append  : bool = false
    var seq     : int in 0..1000 = 0
    var target  : int in 0..1 = 0
    var pos     : int in 0..128 = 0
    var k       : int in 0..1000 = 0
    var cut_k   : int in 0..1000 = 0
    var stage   : int in 0..2 = 0
    var told    : bool = false
    initial BOOT

    # Strom da: beide Slots lesen (`Journal::load`).
    state BOOT:
        sequence:
            flash_cmd = READ(addr = BASE as u32, size = SLOT as u32)
            until flash_rx as p timeout 50 ms
            a = scan(p.data)
            flash_cmd = NONE
            until flash_status == IDLE timeout 50 ms
            flash_cmd = READ(addr = (4096 + BASE) as u32, size = SLOT as u32)
            until flash_rx as q timeout 50 ms
            b = scan(q.data)
            flash_cmd = NONE
            until flash_status == IDLE timeout 50 ms
            -> DECIDE

    # Der Gewinner bestimmt Slot, Anhaengestelle und Sequenznummer; ohne
    # gueltigen Eintrag loescht der erste Vorgang Slot 0.
    state DECIDE:
        enter:
            slot = 1
            seq = 0
            free = 0
            clean = false
            k = 0
            if a.found and (not b.found or a.seqno > b.seqno):
                slot = 0
                seq = a.seqno
                free = a.end
                clean = a.clean
                k = a.value
            elif b.found:
                seq = b.seqno
                free = b.end
                clean = b.clean
                k = b.value
            verify k == seq, "Stand und Sequenznummer laufen auseinander"
            if stage == 1:
                measure after_cut = k
                measure dirty = (0 if a.clean else 1) + (0 if b.clean else 2)
                verify k == cut_k or k == cut_k - 1, "weder der alte noch der neue Stand"
            elif stage == 2:
                measure stand = k
                measure last_slot = slot
                measure last_end = free
                verify k == WRITES - FLIP, "der juengste gueltige Stand fehlt"
                verdict pass "jeder Start findet einen ganzen Stand"
        when stage < 2 and k < WRITES: -> BEGIN
        when stage < 2: -> FINAL

    # Ein Vorgang wie `Journal::begin`: anhaengen, wenn der Eintrag hinter
    # den letzten passt und der Rest geloescht ist, sonst den anderen Slot.
    state BEGIN:
        enter:
            k = k + 1
            payload = payload_of(k)
            header = entry_header(seq + 1, payload)
            if FLIP == 1 and k == WRITES:
                payload[4] = 0xEE
            append = clean and free + entry_len(payload.len) <= SLOT
            target = 1 - slot
            pos = 0
            if append:
                target = slot
                pos = free
        when append: -> APPEND
        when true: -> WIPE

    state WIPE:
        sequence:
            flash_cmd = ERASE(sector = target as u32)
            until flash_status == DONE timeout 50 ms
            flash_cmd = NONE
            until flash_status == IDLE timeout 50 ms
            -> APPEND
        when flash_status == ERROR(code = 1): -> CUT

    # Nutzlast, dann Kopf.
    state APPEND:
        sequence:
            flash_cmd = PROGRAM(addr = (target * 4096 + BASE + pos + 32) as u32, size = payload.len as u32)
            send flash_data, payload
            until flash_status == DONE timeout 50 ms
            flash_cmd = NONE
            until flash_status == IDLE timeout 50 ms
            flash_cmd = PROGRAM(addr = (target * 4096 + BASE + pos) as u32, size = 32)
            send flash_data, header
            until flash_status == DONE timeout 50 ms
            flash_cmd = NONE
            until flash_status == IDLE timeout 50 ms
            -> FINISH
        when flash_status == ERROR(code = 1): -> CUT

    state FINISH:
        enter:
            seq = seq + 1
            slot = target
            free = pos + entry_len(payload.len)
            clean = true
            # Wohin der erste Vorgang nach einem Schnitt ging.
            if stage == 1 and not told:
                measure next_slot = slot
                told = true
        when k < WRITES: -> BEGIN
        when true: -> FINAL

    # Der Strom blieb weg: merken, in welchem Vorgang, und neu starten.
    state CUT:
        enter:
            stage = 1
            cut_k = k
            flash_cmd = NONE
        when flash_status == IDLE: -> BOOT

    state FINAL:
        enter:
            stage = 2
        when true: -> BOOT

campaign power_cut:
    program "110_journal_log.takt"
    sweep CUT = 0..260 step 1
    stop_on never

campaign bit_error:
    program "110_journal_log.takt"
    sweep FLIP = [1]
    stop_on never

campaign erase_cut:
    program "110_journal_log.takt"
    sweep CUT_CHUNK = 1..48 step 1
    stop_on never
