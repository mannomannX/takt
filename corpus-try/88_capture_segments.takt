# 88 — Captures ueber Segmentgrenzen und volle interne Stroeme (6.2, 8.6,
# 8.7): `until s as m` hebt `m` wie eine Variable der Sequenz; es ist in
# *jedem* folgenden Segment lesbar, auch nach einem weiteren `wait` und
# einem weiteren `until`. Ein Guard auf einem Strom nimmt das erste
# passende Element; die spaeteren bleiben fuer das naechste `until` stehen.
# Laeuft ein interner Strom voll, weil sein Leser wartet, faultet der
# Schreiber beim `send` (FB-326); mit `overflow = drop` verwirft er still.

system:
    language = 1
    tick     = 1 ms

record Pulse:
    rising : bool
    pin    : u8

stream<Pulse> pulses with capacity = 64
stream<u8> tight with capacity = 4
stream<u8> lossy with capacity = 2, overflow = drop

output first   : int in 0..255 @ sim("f")
output second  : int in 0..255 @ sim("s")
output edge    : bool          @ sim("e")
output ticks   : int in 0..100 @ sim("t")
output flooded : int in 0..100 @ hw("o/flooded") with safe = 0
output kept    : int in 0..100 @ hw("o/kept")    with safe = 0
output seen    : int in 0..100 @ hw("o/seen")    with safe = 0

machine writer:
    var k : u8 = 0

    initial RUN

    state RUN:
        loop:
            send pulses, Pulse(rising = true, pin = k)
            send pulses, Pulse(rising = false, pin = k.wrap_u8() + 1)
            k = k.wrap_u8() + 2

machine waiter:
    var n : int in 0..100 = 0

    initial WAIT

    state WAIT:
        sequence:
            until pulses as a timeout 5 ms
            until pulses as b timeout 5 ms
            wait 3 ms
            until pulses as c timeout 5 ms
            wait 2 ms
            first = a.data.pin as int
            second = b.data.pin as int
            edge = a.data.rising and not b.data.rising and c.data.rising
            -> DONE

    state DONE:
        loop:
            n = min(n + 1, 100)
            ticks = n

machine flooder:
    var n : int in 0..100 = 0

    initial RUN

    state RUN:
        loop:
            n = min(n + 1, 100)
            send tight, 1
            flooded = n

machine dropper:
    var n : int in 0..100 = 0

    initial RUN

    state RUN:
        loop:
            n = min(n + 1, 100)
            send lossy, 2
            kept = n

machine sleeper:
    var got : int in 0..100 = 0

    initial WAIT

    state WAIT:
        after 30 ms: -> READ

    state READ:
        loop:
            for e in tight:
                got = min(got + 1, 100)
            for e in lossy:
                got = min(got + 10, 100)
            seen = got
