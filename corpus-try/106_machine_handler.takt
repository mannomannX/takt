# 106 — Ein Handler auf Maschinenebene gilt in jedem Zustand (8.7, FB-411).
#
# Der Zaehler steht an zweiter Stelle und wechselt von A nach B; sein
# Handler zaehlt jedes Element in beiden Zustaenden. Die Sema legte ihn
# frueher in den Zustand mit dem Index der Maschine.

system:
    language = 1
    tick     = 1 ms

stream<u8> q with capacity = 16

output n     : int in 0..999 @ sim("o/n")
output phase : int in 0..9   @ sim("o/phase")

machine producer:
    var k : int in 0..255 = 0
    initial RUN

    state RUN:
        loop:
            k = (k + 1) % 256
            send q, k as u8

machine counter:
    var seen : int in 0..999 = 0
    initial A

    on q as e:
        seen = (seen + 1) % 1000
        n = seen

    state A:
        enter:
            phase = 1
        after 3 ms: -> B

    state B:
        enter:
            phase = 2
        after 1 s: -> B
