# 99 — Ein Fault in `exit:` (9.3, FB-289) wird ab dem kleinsten
# gemeinsamen Vorfahren behandelt: Die Zustaende darunter sind verlassen,
# das Ziel des Wechsels ist noch nicht betreten. Sein `exit:` laeuft darum
# nicht, und das Fault-Ziel ist das des Vorfahren — hier RECOVER von WORK,
# nicht SAFE der Maschine.

system:
    language = 1
    tick     = 10 ms

output mark  : int in 0..99 @ sim("o/mark")
output place : int in 0..9  @ sim("o/place")

machine m:
    var n    : int in 0..10 = 0
    var next : int in 0..20 = 11
    fault -> SAFE
    initial WORK

    state WORK:
        fault -> RECOVER
        initial A

        state A:
            enter:
                place = 1
            after 20 ms: -> B
            exit:
                n = next

        state B:
            var seen : int in 0..99 = 42
            enter:
                place = 2
            exit:
                mark = seen

    state RECOVER:
        enter:
            place = 3
            next = next - 1
        after 30 ms: -> WORK

    state SAFE:
        enter:
            place = 9
