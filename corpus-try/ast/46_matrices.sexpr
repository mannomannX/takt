(system
  (language 1)
  (tick 10ms))
(unitvec X m m/s)
(unitvec Z m)
(output s11 :float @hw("o/s11") safe=0)
(output k10 :float @hw("o/k10") safe=0)
(output pdet :float @hw("o/pdet") safe=0)
(output x1 :float @hw("o/x1") safe=0)
(output c10 :float @hw("o/c10") safe=0)
(output pos :float[m] @hw("o/pos") safe=0)
(output vel :float[m/s] @hw("o/vel") safe=0)
(output p11 :float[m^2/s^2] @hw("o/p11") safe=0)
(const I2 :mat<2, 2> (array (array 1 0) (array 0 1)))
(const H2 :mat<1, 2> (array (array 1 0)))
(const F :mat[X, 1/X] (array (array 1 (.as 10ms s)) (array 0[1/s] 1)))
(const H :mat[Z, 1/X] (array (array 1 (.as 0s s))))
(const I :mat[X, 1/X] (array (array 1 (.as 0s s)) (array 0[1/s] 1)))
(const Q :mat[X, X] (array (array 0.001[m^2] 0[m^2/s]) (array 0[m^2/s] 0.001[m^2/s^2])))
(const R :mat[Z, Z] (array (array 0.5[m^2])))
(machine geometry
  (var p :mat<2, 2> (array (array 2 1) (array 1 3)))
  (initial RUN)
  (state RUN
    (loop
      (var s :mat<1, 1> (* (* H2 p) (.transpose H2)))
      (var k (* (* p (.transpose H2)) (.inv s)))
      (= s11 (index s 0 0))
      (= k10 (index k 1 0))
      (= pdet (.det p))
      (var x (call solve p (array (array 1) (array 2))))
      (= x1 (index x 1 0))
      (= c10 (index (.or (.cholesky p) I2) 1 0))
      (= p (+ (* (- I2 (* k H2)) p) I2))
      (= (index p 0 1) (index p 1 0)))))
(machine estimator
  (var x :vec[X] (array 0[m] 1[m/s]))
  (var p :mat[X, X] (array (array 1[m^2] 0[m^2/s]) (array 0[m^2/s] 1[m^2/s^2])))
  (var z :vec[Z] (array 2[m]))
  (initial RUN)
  (state RUN
    (loop
      (= x (* F x))
      (= p (+ (* (* F p) (.transpose F)) Q))
      (var s (+ (* (* H p) (.transpose H)) R))
      (var k (* (* p (.transpose H)) (.inv s)))
      (= x (+ x (* k (- z (* H x)))))
      (= p (* (- I (* k H)) p))
      (= pos (index x 0 0))
      (= vel (index x 1 0))
      (= p11 (index p 1 1)))))
