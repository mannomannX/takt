(system
  (language 1)
  (tick 50us)
  (float f32)
  (output_timing boundary)
  (tick_source "tim1/update"))
(unit rad 1)
(unit rpm 0.104719755 1/s)
(enum MotorState
  (STANDBY)
  (ALIGNMENT)
  (CLOSED_LOOP)
  (BRAKING)
  (SAFE_FAULT))
(record AlphaBetaCurrent
  (alpha: float[A])
  (beta: float[A]))
(record DqCurrent
  (d: float[A])
  (q: float[A]))
(record AlphaBetaVoltage
  (alpha: float[V])
  (beta: float[V]))
(record PhaseDuties
  (u: float in 0..1)
  (v: float in 0..1)
  (w: float in 0..1))
(input i_u :float[A] in (- 45)..45[A] @hw("adc1/i_u") max_age=100us)
(input i_v :float[A] in (- 45)..45[A] @hw("adc1/i_v") max_age=100us)
(input v_dc :float[V] in 0..60[V] @hw("adc1/v_dc") max_age=200us)
(input theta_elec :float in 0..6.2831853 @hw("enc0/theta_e") max_age=100us)
(input omega_mech :float[1/s] in (- 1200)..1200[1/s] @hw("enc0/omega") max_age=200us)
(input temp_inverter :float[degC] in (- 40)..150[degC] @hw("ntc0/temp") max_age=100ms)
(input temp_motor :float[degC] in (- 40)..180[degC] @hw("ntc1/temp") max_age=100ms)
(output gate_en :bool @hw("drv/gate_en") safe=false)
(output pwm_u :float in 0..1 @hw("tim1/ch1_duty") safe=0)
(output pwm_v :float in 0..1 @hw("tim1/ch2_duty") safe=0)
(output pwm_w :float in 0..1 @hw("tim1/ch3_duty") safe=0)
(output brake_relay :bool @hw("gpio/brake") safe=false)
(command cmd_start)
(command cmd_stop)
(command cmd_clear_fault)
(param V_DC_MIN :float[V] in 12..30[V] 18[V])
(param V_DC_MAX :float[V] in 30..58[V] 52[V])
(param I_PEAK_MAX :float[A] in 1..45[A] 35[A])
(param T_MAX_INV :float[degC] in 50..125[degC] 105[degC])
(param T_MAX_MOT :float[degC] in 50..160[degC] 125[degC])
(param CALIBRATION_VOLT :float[V] in 0.5..5[V] 2.0[V])
(param CALIBRATION_TIME :Duration 300ms)
(tunable-param KP_CURRENT_D :float[V/A] in 0..50[V/A] 3.8[V/A])
(tunable-param KI_CURRENT_D :float[V/A/s] in 0..5000[V/A/s] 950[V/A/s])
(tunable-param KP_CURRENT_Q :float[V/A] in 0..50[V/A] 3.8[V/A])
(tunable-param KI_CURRENT_Q :float[V/A/s] in 0..5000[V/A/s] 950[V/A/s])
(tunable-param KP_SPEED :float[A*s] in 0..10[A*s] 0.12[A*s])
(tunable-param KI_SPEED :float[A] in 0..100[A] 1.5[A])
(tunable-param TARGET_SPEED :float[1/s] in (- 800)..800[1/s] 200[1/s])
(tunable-param MAX_IQ :float[A] in 1..35[A] 25[A])
(fn clamp [U] (x:float[U] lo:float[U] hi:float[U]) -> float[U]
  (return (if (< x lo) lo (if (> x hi) hi x))))
(fn clamp_scalar (x:float lo:float hi:float) -> float
  (return (if (< x lo) lo (if (> x hi) hi x))))
(fn clarke (iu:float[A] iv:float[A]) -> AlphaBetaCurrent
  (var ialpha iu)
  (var ibeta (* (+ iu (* 2.0 iv)) 0.577350269))
  (return (AlphaBetaCurrent alpha=ialpha beta=ibeta)))
(fn park (ab:AlphaBetaCurrent theta:float) -> DqCurrent
  (var s (call sin theta))
  (var c (call cos theta))
  (var id (+ (* (.alpha ab) c) (* (.beta ab) s)))
  (var iq (+ (* (- (.alpha ab)) s) (* (.beta ab) c)))
  (return (DqCurrent d=id q=iq)))
(fn inv_park (v_d:float[V] v_q:float[V] theta:float) -> AlphaBetaVoltage
  (var s (call sin theta))
  (var c (call cos theta))
  (var valpha (- (* v_d c) (* v_q s)))
  (var vbeta (+ (* v_d s) (* v_q c)))
  (return (AlphaBetaVoltage alpha=valpha beta=vbeta)))
(fn svpwm (valpha:float[V] vbeta:float[V] vbus:float[V]) -> PhaseDuties
  (var va valpha)
  (var vb (+ (* (- 0.5) valpha) (* 0.8660254 vbeta)))
  (var vc (- (* (- 0.5) valpha) (* 0.8660254 vbeta)))
  (var vmax (if (> va vb) va vb))
  (= vmax (if (> vmax vc) vmax vc))
  (var vmin (if (< va vb) va vb))
  (= vmin (if (< vmin vc) vmin vc))
  (var vmid (* 0.5 (+ vmax vmin)))
  (var du_raw (+ 0.5 (/ (- va vmid) vbus)))
  (var dv_raw (+ 0.5 (/ (- vb vmid) vbus)))
  (var dw_raw (+ 0.5 (/ (- vc vmid) vbus)))
  (var du (call clamp_scalar du_raw 0.0 1.0))
  (var dv (call clamp_scalar dv_raw 0.0 1.0))
  (var dw (call clamp_scalar dw_raw 0.0 1.0))
  (return (PhaseDuties u=du v=dv w=dw)))
(block pi_reg [O, E] (kp:float[O/E] ki:float[O/E/s] out_lo:float[O] out_hi:float[O])
  (var integral :float[O] 0)
  (step (err:float[E] dt:Duration in tick..1h) -> float[O]
    (var dts :float[s] (.as dt s))
    (= integral (call clamp (+ integral (* (* ki err) dts)) out_lo out_hi))
    (return (call clamp (+ (* kp err) integral) out_lo out_hi))))
(machine bldc_foc_controller every=50us
  (fault -> SAFE)
  (persist operating_seconds :int in 0..2000000000 0 min_interval=10s)
  (persist fault_events :int in 0..100000 0 min_interval=1s)
  (pub-var driver_state :MotorState STANDBY)
  (pub-var act_id :float[A] in (- 45)..45[A] 0[A])
  (pub-var act_iq :float[A] in (- 45)..45[A] 0[A])
  (var pi_d (call pi_reg [V A] kp=KP_CURRENT_D ki=KI_CURRENT_D out_lo=(- 30.0[V]) out_hi=30.0[V]))
  (var pi_q (call pi_reg [V A] kp=KP_CURRENT_Q ki=KI_CURRENT_Q out_lo=(- 30.0[V]) out_hi=30.0[V]))
  (var pi_speed (call pi_reg [A 1/s] kp=KP_SPEED ki=KI_SPEED out_lo=(- MAX_IQ) out_hi=MAX_IQ))
  (var target_iq_internal :float[A] in (- 35)..35[A] 0[A])
  (initial ACTIVE)
  (state ACTIVE
    (initial IDLE)
    (loop
      (check (< v_dc V_DC_MAX) "DC bus overvoltage")
      (check (> v_dc V_DC_MIN) "DC bus undervoltage")
      (check (< (call abs i_u) I_PEAK_MAX) "Phase U overcurrent")
      (check (< (call abs i_v) I_PEAK_MAX) "Phase V overcurrent")
      (check (< (call abs (+ i_u i_v)) I_PEAK_MAX) "Phase W overcurrent")
      (check (< temp_inverter T_MAX_INV) "Inverter overtemperature" for=20ms)
      (check (< temp_motor T_MAX_MOT) "Motor overtemperature" for=100ms)
      (alert (> temp_inverter (- T_MAX_INV 10[K])) "Inverter temperature high")
      (alert (> temp_motor (- T_MAX_MOT 15[K])) "Motor temperature high"))
    (state IDLE
      (enter
        (= driver_state STANDBY)
        (= gate_en false)
        (= pwm_u 0)
        (= pwm_v 0)
        (= pwm_w 0)
        (= brake_relay false))
      (when (and cmd_start (>= v_dc V_DC_MIN)) -> ALIGN))
    (state ALIGN
      (enter
        (= driver_state ALIGNMENT)
        (= gate_en true)
        (= brake_relay true))
      (loop
        (var align_duties (call svpwm CALIBRATION_VOLT 0.0[V] v_dc))
        (= pwm_u (.u align_duties))
        (= pwm_v (.v align_duties))
        (= pwm_w (.w align_duties)))
      (after CALIBRATION_TIME -> RUNNING))
    (state RUNNING
      (enter
        (= driver_state CLOSED_LOOP)
        (.reset pi_d)
        (.reset pi_q)
        (.reset pi_speed)
        (= target_iq_internal 0[A]))
      (loop
        (every 1ms
          (= target_iq_internal (.step pi_speed (- TARGET_SPEED omega_mech) 1ms)))
        (every 1s
          (+= operating_seconds 1))
        (var i_ab (call clarke i_u i_v))
        (var i_dq (call park i_ab theta_elec))
        (= act_id (.d i_dq))
        (= act_iq (.q i_dq))
        (var v_d_cmd (.step pi_d (- 0[A] (.d i_dq)) 50us))
        (var v_q_cmd (.step pi_q (- target_iq_internal (.q i_dq)) 50us))
        (var v_ab_cmd (call inv_park v_d_cmd v_q_cmd theta_elec))
        (var duties (call svpwm (.alpha v_ab_cmd) (.beta v_ab_cmd) v_dc))
        (= pwm_u (.u duties))
        (= pwm_v (.v duties))
        (= pwm_w (.w duties)))
      (when cmd_stop -> BRAKING))
    (state BRAKING
      (enter
        (= driver_state BRAKING)
        (= target_iq_internal 0[A]))
      (loop
        (var i_ab (call clarke i_u i_v))
        (var i_dq (call park i_ab theta_elec))
        (= act_id (.d i_dq))
        (= act_iq (.q i_dq))
        (var v_d_cmd (.step pi_d (- 0[A] (.d i_dq)) 50us))
        (var v_q_cmd (.step pi_q (- 0[A] (.q i_dq)) 50us))
        (var v_ab_cmd (call inv_park v_d_cmd v_q_cmd theta_elec))
        (var duties (call svpwm (.alpha v_ab_cmd) (.beta v_ab_cmd) v_dc))
        (= pwm_u (.u duties))
        (= pwm_v (.v duties))
        (= pwm_w (.w duties)))
      (when (< (call abs omega_mech) 5[1/s]) -> IDLE)
      (after 3s -> IDLE)))
  (state SAFE
    (enter
      (= driver_state SAFE_FAULT)
      (= gate_en false)
      (= pwm_u 0)
      (= pwm_v 0)
      (= pwm_w 0)
      (= brake_relay false)
      (+= fault_events 1))
    (when (and cmd_clear_fault (not cmd_start)) -> IDLE)))
