(system
  (language 1)
  (tick 1ms))
(native-fn crc32 (b:bytes<64>) -> u32 cost={i32:1000} stack=64)
(param CUT :int in 0..1000 0)
(output flash_cmd :FlashCmd @hw("flash/cmd") safe=NONE)
(output flash_data :stream<u8> @hw("flash/tx") max_rate=4000[Hz] capacity=96)
(input flash_status :FlashStatus @hw("flash/status") max_age=10ms)
(input flash_rx :stream<bytes<4096>> @hw("flash/rx") max_rate=200[Hz] capacity=2)
(output flash_status_sim :FlashStatus @sim("flash/status"))
(output flash_rx_sim :stream<bytes<4096>> @sim("flash/rx") capacity=4096)
(output found :int in 0..3 @hw("o/found") safe=0)
(output cut_in :int in 0..2 @hw("o/cut_in") safe=0)
(instance flash flash_model cmd=flash_cmd data=flash_data status=flash_status_sim rx=flash_rx_sim sectors=2 t_erase=2ms t_program=1ms cut_at_byte=CUT)
(record Entry
  (present: bool)
  (seqno: int in 0..1000)
  (kind: int in 0..3))
(fn old_text () -> bytes<64>
  (var b :bytes<64> default)
  (for x in (array 0x61 0x6C 0x74 0x65 0x72 0x2D 0x73 0x74 0x61 0x6E 0x64)
    (.push b (as x u8)))
  (return b))
(fn new_text () -> bytes<64>
  (var b :bytes<64> default)
  (for x in (array 0x6E 0x65 0x75 0x65 0x72 0x2D 0x73 0x74 0x61 0x6E 0x64)
    (.push b (as x u8)))
  (return b))
(fn le32 (v:int) -> bytes<4>
  (var b :bytes<4> default)
  (.push b (as (& v 0xFF) u8))
  (.push b (as (& (>> v 8) 0xFF) u8))
  (.push b (as (& (>> v 16) 0xFF) u8))
  (.push b (as (& (>> v 24) 0xFF) u8))
  (return b))
(fn read32 (page:bytes<4096> pos:int) -> int
  (return (| (| (| (as (index page pos) int) (<< (as (index page (+ pos 1)) int) 8)) (<< (as (index page (+ pos 2)) int) 16)) (<< (as (index page (+ pos 3)) int) 24))))
(fn entry_header (seq:int payload:bytes<64>) -> bytes<32>
  (var h :bytes<32> default)
  (var magic :bytes<4> (call le32 0x4A504B54))
  (var seqb :bytes<4> (call le32 seq))
  (var logic :bytes<4> (call le32 0x7A6B))
  (var length :bytes<4> (call le32 (.len payload)))
  (for x in magic
    (.push h x))
  (.push h 1)
  (for i in (range 3)
    (.push h 0))
  (for x in seqb
    (.push h x))
  (for i in (range 4)
    (.push h 0))
  (for x in logic
    (.push h x))
  (for i in (range 4)
    (.push h 0))
  (for x in length
    (.push h x))
  (var buf :bytes<64> default)
  (for x in h
    (.push buf x))
  (for x in payload
    (.push buf x))
  (var sum :bytes<4> (call le32 (as (call crc32 buf) int)))
  (for x in sum
    (.push h x))
  (return h))
(fn header_of (page:bytes<4096>) -> Entry
  (var e :Entry default)
  (if (< (.len page) 32)
    (return e))
  (if (!= (call read32 page 0) 0x4A504B54)
    (return e))
  (if (> (& (call read32 page 4) 0xFFFF) 1)
    (return e))
  (var length :int (call read32 page 24))
  (if (or (> length 32) (> (+ 32 length) (.len page)))
    (return e))
  (var buf :bytes<64> default)
  (for i in (range 28)
    (.push buf (index page i)))
  (for i in (range 32)
    (if (< i length)
      (.push buf (index page (+ 32 i)))))
  (if (!= (as (call crc32 buf) int) (call read32 page 28))
    (return e))
  (= (.present e) true)
  (= (.seqno e) (call read32 page 8))
  (= (.kind e) 3)
  (if (and (== length 11) (== (index page 32) 0x61))
    (= (.kind e) 1))
  (elif (and (== length 11) (== (index page 32) 0x6E))
    (= (.kind e) 2))
  (return e))
(machine journal
  (var payload :bytes<64> default)
  (var header :bytes<32> default)
  (var slot :int in 0..1 0)
  (var seq :int in 0..1000 0)
  (var phase :int in 0..2 0)
  (var a :Entry default)
  (var b :Entry default)
  (initial START)
  (state START
    (enter
      (= phase 1)
      (= slot 0)
      (= seq 1)
      (= payload (call old_text)))
    (when true -> WRITE))
  (state WRITE
    (enter
      (= header (call entry_header seq payload)))
    (sequence
      (= flash_cmd (ERASE sector=(as slot u32)))
      (until (== flash_status DONE) timeout=50ms)
      (= flash_cmd NONE)
      (until (== flash_status IDLE) timeout=50ms)
      (= flash_cmd (PROGRAM addr=(as (+ (* slot 4096) 32) u32) size=(as (.len payload) u32)))
      (send flash_data payload)
      (until (== flash_status DONE) timeout=50ms)
      (= flash_cmd NONE)
      (until (== flash_status IDLE) timeout=50ms)
      (= flash_cmd (PROGRAM addr=(as (* slot 4096) u32) size=32))
      (send flash_data header)
      (until (== flash_status DONE) timeout=50ms)
      (= flash_cmd NONE)
      (until (== flash_status IDLE) timeout=50ms)
      (-> WRITTEN))
    (when (== flash_status (ERROR code=1)) -> CUT))
  (state WRITTEN
    (when (== phase 1) -> WRITE
      (= phase 2)
      (= slot 1)
      (= seq 2)
      (= payload (call new_text)))
    (when true -> REBOOT))
  (state CUT
    (enter
      (= cut_in phase)
      (= flash_cmd NONE))
    (when (== flash_status IDLE) -> REBOOT))
  (state REBOOT
    (sequence
      (= flash_cmd (READ addr=0 size=4096))
      (until (as flash_rx p) timeout=50ms)
      (= a (call header_of (.data p)))
      (= flash_cmd NONE)
      (until (== flash_status IDLE) timeout=50ms)
      (= flash_cmd (READ addr=4096 size=4096))
      (until (as flash_rx q) timeout=50ms)
      (= b (call header_of (.data q)))
      (= flash_cmd NONE)
      (-> JUDGE)))
  (state JUDGE
    (enter
      (= found 0)
      (if (and (.present a) (or (not (.present b)) (>= (.seqno a) (.seqno b))))
        (= found (.kind a)))
      (elif (.present b)
        (= found (.kind b)))
      (measure stand found)
      (if (== cut_in 1)
        (verify (!= found 2) "neuer Stand ohne abgeschlossenen Schreibvorgang"))
      (else
        (verify (!= found 0) "alter Eintrag verloren"))
      (verify (!= found 3) "halber Eintrag")
      (verdict pass "alt oder neu, nie dazwischen"))))
(campaign power_cut
  (program "45_journal_cut.takt")
  (sweep CUT 0..90 step=1)
  (stop_on never))
