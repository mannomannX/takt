(system
  (language 1)
  (tick 10ms))
(native-job sha256 (b:bytes<64>) -> bytes<32> cost=60000 stack=640 duration=25ms)
(output timed :u32 @hw("o/timed") safe=0)
(output planned :u32 @hw("o/planned") safe=0)
(output count :u32 @hw("o/count") safe=0)
(output crowded :u32 @hw("o/crowded") safe=0)
(output rest :int @hw("o/rest") safe=0)
(output big_out :i64 @hw("o/big") safe=0)
(output inv_out :float @hw("o/inv") safe=0.0)
(output word :u32 @hw("o/word") safe=0)
(output ready :u32 @hw("o/ready") safe=0)
(fn first (d:bytes<32>) -> u32
  (return (| (| (| (as (index d 0) u32) (<< (as (index d 1) u32) 8)) (<< (as (index d 2) u32) 16)) (<< (as (index d 3) u32) 24))))
(machine timing
  (var n :u32 in 0..100 0)
  (initial RUN)
  (state RUN
    (loop
      (= n (call min (+ n 1) 100))
      (= timed n)
      (if (== n 3)
        (at now
          (= timed 99))))))
(machine plan
  (var n :u32 in 0..100 0)
  (initial RUN)
  (state RUN
    (loop
      (= n (call min (+ n 1) 100))
      (if (== n 1)
        (at (+ now 30ms)
          (= planned 1))
        (at (+ now 30ms)
          (= planned 2))))))
(machine crowd
  (var n :u32 in 0..100 0)
  (initial RUN)
  (state RUN
    (loop
      (= n (call min (+ n 1) 100))
      (= count n)
      (if (== n 1)
        (at (+ now 100ms)
          (= crowded 1))
        (at (+ now 200ms)
          (= crowded 2))
        (at (+ now 300ms)
          (= crowded 3))
        (at (+ now 400ms)
          (= crowded 4)))
      (if (== n 2)
        (at (+ now 390ms)
          (= crowded 5)))
      (if (== n 3)
        (at (+ now 600ms)
          (= crowded 6))))))
(machine divide
  (var d :int in (- 5)..5 3)
  (initial RUN)
  (state RUN
    (loop
      (= d (call max (- d 1) (- 5)))
      (= rest (% 17 d)))))
(machine grow
  (var big :i64 9223372036854775000)
  (initial RUN)
  (state RUN
    (loop
      (= big (+ big 400))
      (= big_out big))))
(machine invert
  (var a :float 2.0)
  (initial RUN)
  (state RUN
    (loop
      (= a (- a 1.0))
      (var m :mat<2, 2> (array (array a 1) (array a 1)))
      (var v :mat<2, 2> (+ (array (array 1 0) (array 0 1)) (* m 0.0)))
      (if (< a 0.5)
        (= v (.inv m)))
      (= inv_out (index v 0 0)))))
(machine restart
  (var msg :bytes<64> default)
  (var d :bytes<32> default)
  (initial RUN)
  (state RUN
    (sequence
      (.push msg 0x61)
      (job v sha256 msg)
      (wait 10ms)
      (.push msg 0x62)
      (job v sha256 msg)
      (until (.done v) timeout=1s -> FAILED)
      (= d (.or (.result v) default))
      (= word (call first d))
      (= ready 1)
      (-> DONE)))
  (state DONE
    (when false -> RUN))
  (state FAILED
    (when false -> RUN)))
