(system
  (language 1)
  (tick 10ms))
(unit inc 1)
(unit Bd 1 Hz)
(output baud :u32[Bd] @hw("o/baud") safe=0)
(output speed :i32[inc/s] @hw("o/speed") safe=0)
(output uv :int[uV] @hw("o/uv") safe=0)
(output volts :float[V] @hw("o/volts") safe=0)
(output raw :u32 @hw("o/raw") safe=0)
(const BAUD :u32[Bd] 921_600[Bd])
(machine m
  (var mv :int[mV] 3300[mV])
  (var dist :i32[inc] 250[inc])
  (var per :i32[1/s] 4[1/s])
  (initial RUN)
  (loop
    (= baud BAUD)
    (= speed (* dist per))
    (= uv (.to mv uV))
    (= volts (.to_float mv V))
    (= raw (as (/ mv 1[mV]) u32)))
  (state RUN
    (after 50ms -> UP))
  (state UP
    (enter
      (= mv (+ mv 100[mV]))
      (= dist (- dist 50[inc])))
    (after 50ms -> RUN)))
