(system
  (language 1)
  (tick 1ms))
(node io1 @hw("ethercat/1") tick=1ms)
(enum Cmd open
  (NOP)
  (GO)
  (STOP))
(enum Level
  (LOW)
  (MID)
  (HIGH))
(record Uart0Regs layout=little
  (bits status: u32
    (tx_ready: bool at 0)
    (rx_ready: bool at 1)
    (errors: u8 at 4..7))
  (fifo: u32))
(port uart0 :Uart0Regs @mmio(0x60000000))
(input trip_in :bool @hw("io1/di0") label="Trip input" group="safety")
(input raw_log :stream<line<128>> @hw("io1/uart0") max_rate=1000[Hz] framing=lines)
(output vbus_en :bool @hw("io1/do0") safe=false jitter=2us)
(output beacon :bool @hw("io1/do1") safe=false)
(param TAB_SIZE :int in 1..64 16)
(fn scale [type T:numeric] (x:T k:T) -> T
  (return (* x k)))
(fn pick [type T:ord] (a:T b:T) -> T
  (return (if (> a b) a b)))
(property never_both monitor (always (not (and vbus_en beacon))))
(property settles (always (implies trip_in (stable[100ms] (not vbus_en)))))
(trigger cut_on_sector node=io1 bound=20us
  (when (matches raw_log "SECTOR {n:int}"))
  (then
    (at (+ (.t event) 250us)
      (= vbus_en false))))
(machine motor_ctrl node=io1 every=250us
  (initial RUN)
  (state RUN
    (loop
      (= beacon trip_in))))
(machine supervisor node=io1 every=10ms
  (fault -> HALTED)
  (initial STARTING)
  (state STARTING
    (when trip_in -> RUNNING))
  (state RUNNING resume
    (instance guard leak_guard sensor=trip_in)
    (instance lamps [i in 0..4] lamp index=i)
    (initial COARSE)
    (enter
      (arm cut_on_sector))
    (exit
      (disarm cut_on_sector))
    (state COARSE
      (when trip_in -> FINE))
    (state FINE
      (when (not trip_in) -> COARSE)))
  (state HALTED
    (enter
      (= vbus_en false))))
(machine leak_guard (sensor:input bool) every=10ms
  (initial WATCH)
  (state WATCH
    (loop
      (check (not sensor) "leak detected"))))
(machine lamp (index:int in 0..7) every=100ms
  (initial ON)
  (state ON
    (loop
      (pass))))
(driver-machine uart_tx node=io1 every=50us
  (initial SEND)
  (state SEND
    (loop
      (if (.tx_ready (.status uart0))
        (= (.fifo uart0) 0x41)))))
