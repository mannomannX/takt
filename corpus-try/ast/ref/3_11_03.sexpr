(unitvec X m m/s)
(unitvec Z m)
(var x :vec[X] (array 0[m] 0[m/s]))
(var p :mat[X, X] (array (array 1[m^2] 0[m^2/s]) (array 0[m^2/s] 1[m^2/s^2])))
(const F :mat[X, 1/X] (array (array 1 (.as (paren 10ms) s)) (array 0[1/s] 1)))
(const H :mat[Z, 1/X] (array (array 1 (.as (paren 0s) s))))
(const I :mat[X, 1/X] (array (array 1 (.as (paren 0s) s)) (array 0[1/s] 1)))
(loop
  (= x (* F x))
  (= p (+ (* (* F p) (.transpose F ())) Q))
  (var s (+ (* (* H p) (.transpose H ())) R))
  (var k (* (* p (.transpose H ())) (.inv s ())))
  (= x (+ x (* k (paren (- z (* H x))))))
  (= p (* (paren (- I (* k H))) p)))
