(system
  (tick 10ms))
(input cell_v :[4]float[V] in 2.0..4.5[V] @hw("afe/cell[0:4]") max_age=50ms)
(input pack_i :float[A] in (- 10)..10[A] @hw("afe/current") max_age=50ms)
(input temp :[2]float[degC] @hw("afe/ntc[0:2]") max_age=200ms)
(input charger :bool @hw("gpio/vbus_det") wake=true)
(input button :stream<Edge> @hw("gpio/btn") max_rate=50[Hz] wake=true)
(input chg_status :u8 @hw("i2c1/0x6B/0x0B") max_age=500ms)
(input on_trial :bool @hw("ota/trial"))
(output confirm :bool @hw("ota/confirm") safe=false)
(output fet_chg :bool @hw("gpio/fet_chg") safe=false)
(output fet_dis :bool @hw("gpio/fet_dis") safe=false)
(output load_test :bool @hw("gpio/test_load") safe=false)
(output led :u8 @hw("pwm/led") safe=0)
(param V_MAX :float[V] in 4.0..4.3[V] 4.2[V])
(param V_MIN :float[V] in 2.5..3.2[V] 3.0[V])
(param I_MAX :float[A] in 1..10[A] 6[A])
(param T_MAX :float[degC] in 40..70[degC] 60[degC])
(param R_INT_MAX :float[mohm] in 20..500[mohm] 150[mohm])
(const OCV :table<float[V], float[pct]> (array (tuple 3.0[V] 0[pct]) (tuple 3.4[V] 10[pct]) (tuple 3.6[V] 30[pct]) (tuple 3.8[V] 60[pct]) (tuple 4.0[V] 85[pct]) (tuple 4.2[V] 100[pct])))
(record SelftestResult
  (passed: bool)
  (code: int in 0..255)
  (r_int: float[mohm] in 0..1000[mohm]))
(machine bms every=100ms
  (fault -> PROTECT)
  (persist cycle_count :int in 0..100000 0 min_interval=10s)
  (persist fault_count :int in 0..100000 0 min_interval=10s)
  (persist last_test :SelftestResult (SelftestResult passed=false code=0 r_int=0[mohm]))
  (pub-var soc :float[pct] 0[pct])
  (pub-var charge_as :float[A*s] 0[A*s])
  (var coulomb (call integrate [A] limit=72000[A*s]))
  (initial ACTIVE)
  (state ACTIVE
    (initial SELFTEST)
    (loop
      (for i in (range 4)
        (check (< (index cell_v i) (+ V_MAX 0.05[V])) "cell {i} overvoltage {cell_v[i]}")
        (check (> (index cell_v i) (- V_MIN 0.10[V])) "cell {i} undervoltage {cell_v[i]}"))
      (check (< (call abs pack_i) I_MAX) "overcurrent {pack_i}")
      (for i in (range 2)
        (check (< (index temp i) T_MAX) "overtemperature {temp[i]}"))
      (check (not (.bit chg_status 7)) "charger IC fault flag")
      (= soc (call interp OCV (.min cell_v ())))
      (= charge_as (.step coulomb pack_i 100ms)))
    (state SELFTEST
      (sequence
        (= led 128)
        (if (> (- (.max cell_v ()) (.min cell_v ())) 0.1[V])
          (= last_test (SelftestResult passed=false code=2 r_int=0[mohm]))
          (-> DEGRADED))
        (var v0 (.mean cell_v ()))
        (= load_test true)
        (wait 200ms)
        (var v1 (.mean cell_v ()))
        (var i1 pack_i)
        (= load_test false)
        (var r_int (.to (paren (/ (paren (- v0 v1)) (call max i1 0.1[A]))) mohm))
        (if (> r_int R_INT_MAX)
          (= last_test (SelftestResult passed=false code=1 r_int=r_int))
          (-> DEGRADED))
        (= last_test (SelftestResult passed=true code=0 r_int=r_int))
        (if (.or on_trial false)
          (= confirm true))
        (-> RUN)))
    (state RUN
      (loop
        (= fet_dis true)
        (= fet_chg (and charger (< (.max cell_v ()) V_MAX)))
        (= led (as (call round (* (/ soc (paren 100[pct])) 255)) u8))
        (if (call rising charger)
          (+= cycle_count 1)))
      (when (and (not charger) (< (call abs pack_i) 0.05[A])) -> IDLE_WAIT))
    (state IDLE_WAIT
      (when (or charger (>= (call abs pack_i) 0.05[A])) -> RUN)
      (after 2min -> STANDBY))
    (state DEGRADED
      (loop
        (= fet_chg false)
        (= fet_dis true)
        (= led 8))
      (after 24h -> SELFTEST)))
  (state STANDBY idle
    (enter
      (= fet_chg false)
      (= fet_dis false)
      (= led 0))
    (when (matches button (Edge rising=true) as e) -> SELFTEST)
    (when charger -> SELFTEST)
    (after 168h -> SELFTEST))
  (state PROTECT
    (enter
      (= fet_chg false)
      (= fet_dis false)
      (= led 255)
      (+= fault_count 1))
    (when (> fault_count 20) -> FAULTED)
    (after 10s -> SELFTEST)))
