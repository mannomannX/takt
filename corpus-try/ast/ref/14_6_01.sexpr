(system
  (tick 1ms))
(output vbus_set :float[V] in 0..6[V] @hw("psu/vset") safe=0[V])
(output vbus_en :bool @hw("psu/enable") safe=false)
(output reset_n :bool @hw("gpio/dut_rst") safe=false)
(input i_dut :samples<float[A], 100> @hw("daq1/ai2") rate=100[kHz])
(input dut_log :stream<line<256>> @hw("uart0/rx") max_rate=2000[Hz] framing=lines overflow=fault)
(output dut_tx :stream<u8> @hw("uart0/tx") max_rate=11520[Hz] capacity=256)
(command start)
(command reset)
(param VBUS :float[V] in 3..5.5[V] 5[V])
(param BROWNOUT_DELAY :Duration in 2ms..2s 20ms)
(param IMAGE_SIZE :int in 1..1_000_000 65536)
(param IMAGE_CRC :int in 0..0xFFFF_FFFF 0x1234_5678)
(param BOOT_TIMEOUT :Duration 2s)
(enum Result
  (NONE)
  (RECOVERED)
  (BRICKED)
  (CORRUPT))
(machine brownout_test
  (fault -> SAFE)
  (pub-var result :Result NONE)
  (var t_power_on :Duration 0s)
  (initial IDLE)
  (state IDLE
    (enter
      (= vbus_en false)
      (= reset_n false))
    (when start -> POWER_ON))
  (state RUNNING
    (initial POWER_ON)
    (loop
      (check (< (.max i_dut ()) 1.5[A]) "DUT overcurrent {i_dut.max()}"))
    (on dut_log has "PANIC" as ev
      (verdict fail "bootloader panic: {ev.text}"))
    (state POWER_ON
      (sequence
        (= vbus_set VBUS)
        (= vbus_en true)
        (= t_power_on now)
        (wait 50ms)
        (= reset_n true)
        (until (matches dut_log "Boot v{major:int}.{minor:int}" as m) timeout=BOOT_TIMEOUT)
        (measure boot_time (- (.t m) t_power_on))
        (verify (>= (.major m) 2) "bootloader too old: {m.major}.{m.minor}")
        (-> HANDSHAKE)))
    (state HANDSHAKE
      (sequence
        (send dut_tx "UPDATE {IMAGE_SIZE} {IMAGE_CRC:hex}\n")
        (until (matches dut_log "READY") timeout=500ms)
        (-> UPDATING)))
    (state UPDATING
      (var erased :int in 0..255 0)
      (on dut_log matches "Erasing sector {n:int}" as m
        (= erased (.n m))
        (measure erase_seen_at (- (.t m) t_power_on))
        (at (+ (.t m) BROWNOUT_DELAY)
          (= vbus_en false))
        (-> CUTTING))
      (on dut_log has "CRC mismatch" as ev
        (verdict fail "CRC mismatch during update: {ev.text}"))
      (after 10s -> DONE
        (verdict fail "no erase observed within 10 s")))
    (state CUTTING
      (sequence
        (wait (+ BROWNOUT_DELAY 20ms))
        (verify (< (.max i_dut ()) (.to (paren 10[mA]) A)) "supply still present during brownout: {i_dut.max()}")
        (wait 500ms)
        (= reset_n false)
        (= vbus_en true)
        (wait 50ms)
        (= reset_n true)
        (-> RECOVERY)))
    (state RECOVERY
      (sequence
        (until (matches dut_log "Boot v{major:int}.{minor:int}" as m) timeout=BOOT_TIMEOUT
          (else
            (= result BRICKED)
            (verdict fail "no boot after brownout")
            (-> DONE)))
        (until (matches dut_log "Recovery: {outcome:word}" as r) timeout=5s
          (else
            (= result CORRUPT)
            (verdict fail "no recovery message")
            (-> DONE)))
        (if (== (.outcome r) "OK")
          (= result RECOVERED)
          (verdict pass "recovered after brownout at {BROWNOUT_DELAY}"))
        (else
          (= result CORRUPT)
          (verdict fail "recovery state {r.outcome}"))
        (-> DONE))))
  (state DONE
    (enter
      (= vbus_en false))
    (when reset -> IDLE))
  (state SAFE
    (enter
      (= vbus_en false)
      (= reset_n false))
    (when reset -> IDLE)))
(campaign brownout_scan
  (program "supply_interruption.takt")
  (sweep BROWNOUT_DELAY 2ms..400ms step=250us)
  (repeat 2)
  (stop_on fail))
