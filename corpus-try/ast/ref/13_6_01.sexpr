(scenario "erase interrupted at sector 3" every=1ms
  (initial RUN)
  (state RUN
    (sequence
      (until (and (== (.state dut_model) ERASING) (== (.sector dut_model) 3)) timeout=5s)
      (expect (== (.state brownout_test) CUTTING))
      (until (== (.state brownout_test) DONE) timeout=10s)
      (verify (== (.result brownout_test) RECOVERED) "expected recovery")
      (verdict pass))))
