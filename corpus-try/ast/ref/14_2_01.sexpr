(system
  (tick 10ms))
(input cell_v :float[V] in 2.0..4.5[V] @hw("daq2/ai0") max_age=50ms)
(input chamber_t :float[degC] in (- 60)..200[degC] @hw("chamber/pv") max_age=1s)
(output heater :bool @hw("chamber/heat") safe=false)
(output cooler :bool @hw("chamber/cool") safe=false)
(output charger :bool @hw("psu1/enable") safe=false)
(param CYCLE_COUNT :int in 1..1000 20)
(param PEAK_TEMP :float[degC] in 20..150[degC] 85[degC])
(param LOW_TEMP :float[degC] in (- 50)..20[degC] (- 20[degC]))
(param SOAK :Duration 30min)
(param MAX_CELL_V :float[V] in 3.0..4.4[V] 4.25[V])
(profile QUAL
  (CYCLE_COUNT 50)
  (PEAK_TEMP 120[degC])
  (SOAK 2h))
(machine battery_cycle every=100ms
  (initial VERIFY)
  (loop
    (check (< cell_v MAX_CELL_V) "cell overvoltage {cell_v}")
    (check (< chamber_t (+ PEAK_TEMP 10[K])) "chamber overtemperature"))
  (state VERIFY
    (when (and (.valid cell_v) (.valid chamber_t)) -> CYCLING))
  (state CYCLING
    (sequence
      (repeat CYCLE_COUNT
        (step "heat"
          (= heater true)
          (= cooler false)
          (until (>= chamber_t PEAK_TEMP) timeout=45min)
          (= heater false)
          (wait SOAK))
        (step "cool"
          (= cooler true)
          (until (<= chamber_t LOW_TEMP) timeout=45min)
          (= cooler false)
          (wait SOAK)))
      (-> DONE)))
  (state DONE
    (enter
      (= charger false))))
(output chamber_t_sim :float[degC] @sim("chamber/pv") safe=22[degC])
(output cell_v_sim :float[V] @sim("daq2/ai0") safe=3.9[V])
(const LEAK_COEF :float[1/s] 0.0005[1/s])
(machine chamber_model every=100ms
  (var t :float[degC] 22[degC])
  (initial RUN)
  (state RUN
    (loop
      (var drive :float[K/s] (- (paren (if heater 0.05[K/s] 0[K/s])) (paren (if cooler 0.04[K/s] 0[K/s]))))
      (var leak :float[K/s] (* (paren (- t 22[degC])) LEAK_COEF))
      (= t (+ t (* (paren (- drive leak)) (.as (paren 100ms) s))))
      (= chamber_t_sim t)
      (= cell_v_sim 3.9[V]))))
