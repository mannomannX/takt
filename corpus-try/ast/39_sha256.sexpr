(system
  (language 1)
  (tick 10ms))
(native-fn sha256 (b:bytes<64>) -> bytes<32> cost=60000 stack=512)
(native-fn sha256_init () -> Sha256Ctx cost=8 stack=32)
(native-fn sha256_update (ctx:Sha256Ctx chunk:bytes<64>) -> Sha256Ctx cost=2300 stack=512)
(native-fn sha256_final (ctx:Sha256Ctx) -> bytes<32> cost=3600 stack=512)
(native-fn hmac_sha256 (key:bytes<64> msg:bytes<64>) -> bytes<32> cost=90000 stack=768)
(output one_shot :u32 @hw("o/one_shot") safe=0)
(output chunked :u32 @hw("o/chunked") safe=0)
(output mac :u32 @hw("o/mac") safe=0)
(fn word (d:bytes<32>) -> u32
  (return (| (| (| (as (index d 0) u32) (<< (as (index d 1) u32) 8)) (<< (as (index d 2) u32) 16)) (<< (as (index d 3) u32) 24))))
(machine m
  (var msg :bytes<64> default)
  (var head :bytes<64> default)
  (var tail :bytes<64> default)
  (var key :bytes<64> default)
  (var ctx :Sha256Ctx (call sha256_init))
  (var d :bytes<32> default)
  (initial RUN)
  (state RUN
    (enter
      (.push msg 0x61)
      (.push msg 0x62)
      (.push msg 0x63)
      (.push head 0x61)
      (.push tail 0x62)
      (.push tail 0x63)
      (.push key 0x4A)
      (.push key 0x65)
      (.push key 0x66)
      (.push key 0x65)
      (= d (call sha256 msg))
      (= one_shot (call word d))
      (= ctx (call sha256_update ctx head))
      (= ctx (call sha256_update ctx tail))
      (= d (call sha256_final ctx))
      (= chunked (call word d))
      (= d (call hmac_sha256 key msg))
      (= mac (call word d)))))
