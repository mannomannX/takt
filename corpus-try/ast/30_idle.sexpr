(system
  (language 1)
  (tick 10ms))
(input wake :bool @hw("gpio/btn") wake=true)
(output wake_sim :bool @sim("gpio/btn") safe=false)
(output led :bool @hw("ui/led") safe=false)
(machine m
  (initial SLEEP)
  (state SLEEP idle
    (enter
      (= led false))
    (when wake -> RUN)
    (after 500ms -> RUN))
  (state RUN
    (enter
      (= led true))
    (after 200ms -> SLEEP)))
