(system
  (language 1)
  (tick 1ms))
(output sine :float @sim("o/sine"))
(output far_sine :float @sim("o/far_sine"))
(output cosine :float @sim("o/cosine"))
(output far_cos :float @sim("o/far_cos"))
(output tangent :float @sim("o/tangent"))
(output arcsine :float @sim("o/arcsine"))
(output arccosine :float @sim("o/arccosine"))
(output arctan :float @sim("o/arctan"))
(output angle :float @sim("o/angle"))
(output bearing :float @sim("o/bearing"))
(output growth :float @sim("o/growth"))
(output logarithm :float @sim("o/logarithm"))
(output power :float @sim("o/power"))
(output signed :float @sim("o/signed"))
(machine m
  (var k :int in 0..1000 0)
  (initial RUN)
  (state RUN
    (loop
      (= k (call min (+ k 1) 1000))
      (var x :float in (- 1.0e4)..1.0e4 (- (* (as k float) 7.3) 3650.0))
      (var far :float (+ (* (as k float) 1.0e15) 0.5))
      (var u :float in (- 1.0)..1.0 (- (/ (as k float) 1000.0) 0.03))
      (= sine (call sin x))
      (= far_sine (call sin far))
      (= cosine (call cos (* x 0.001)))
      (= far_cos (call cos far))
      (= tangent (call tan (* x 0.0003)))
      (= arcsine (call asin u))
      (= arccosine (call acos u))
      (= arctan (call atan x))
      (= angle (call atan2 sine cosine))
      (= bearing (call atan2 (- 0.0 cosine) (- sine 0.5)))
      (= growth (call exp (- (* (as k float) 0.2) 40.0)))
      (= logarithm (call ln (+ (* (as k float) 1.7) 0.5)))
      (= power (call pow (+ (* (as k float) 0.37) 0.1) 1.37))
      (= signed (call pow (- 2.5) (as (% k 7) float))))))
