(system
  (language 1)
  (tick 10ms))
(input p :float[bar] in 0..100[bar] @hw("daq/p") max_age=50ms)
(output count :u32 @hw("o/count") safe=0)
(output shown :bool @hw("o/shown") safe=false)
(fn above (x:float[bar] limit:float[bar]) -> bool
  (return (> x limit)))
(machine watch
  (var n :u32 in 0..100 0)
  (initial RUN)
  (state RUN
    (loop
      (alert (call above p 80[bar]) "pressure high")
      (log "pressure {p}")
      (measure level (/ p 1[bar]))
      (verify (< p 90[bar]) "pressure within limits")
      (= n (call min (+ n 1) 100))
      (= count n))
    (when (>= n 5) -> USE))
  (state USE
    (loop
      (= shown (> p 1[bar]))
      (= count n))))
