(system
  (language 1)
  (tick 10ms))
(const H :mat<2, 2> (array (array 2.0 0.0) (array 0.0 4.0)))
(const G :mat<2, 1> (array (array (- 2.0)) (array (- 8.0))))
(const LO :mat<2, 1> (array (array 0.0) (array 0.0)))
(const HI :mat<2, 1> (array (array 10.0) (array 10.0)))
(const TI :mat<2, 1> (array (array 0.5) (array 1.5)))
(output x_free :float @hw("o/x_free") safe=0.0)
(output y_free :float @hw("o/y_free") safe=0.0)
(output x_tight :float @hw("o/x_tight") safe=0.0)
(output y_tight :float @hw("o/y_tight") safe=0.0)
(output both_ok :bool @hw("o/both_ok") safe=false)
(machine solver
  (var free (call qp_box [2] h=H g=G lb=LO ub=HI iters=200 tol=1e-9))
  (var tight (call qp_box [2] h=H g=G lb=LO ub=TI iters=200 tol=1e-9))
  (initial RUN)
  (state RUN
    (loop
      (.solve free)
      (.solve tight)
      (var a (.result free))
      (var b (.result tight))
      (= x_free (index a 0 0))
      (= y_free (index a 1 0))
      (= x_tight (index b 0 0))
      (= y_tight (index b 1 0))
      (var c_free (.converged free))
      (var c_tight (.converged tight))
      (= both_ok (and c_free c_tight))
      (check (and (<= (index b 0 0) 0.5) (<= (index b 1 0) 1.5)) "qp_box left the box"))
    (after 100ms -> RUN)))
