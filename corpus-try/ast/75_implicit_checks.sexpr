(system
  (language 1)
  (tick 10ms))
(output ovf :int in 0..300 @hw("o/ovf") safe=0)
(output div :int in 0..300 @hw("o/div") safe=0)
(output shift :int in 0..300 @hw("o/shift") safe=0)
(output conv :int in 0..300 @hw("o/conv") safe=0)
(output idx :int in 0..300 @hw("o/idx") safe=0)
(output fine :int in 0..300 @hw("o/fine") safe=0)
(machine overflow_u8
  (fault -> SAFE)
  (var a :u8 250)
  (initial RUN)
  (state RUN
    (loop
      (= a (+ a 2))
      (= ovf (as a int))))
  (state SAFE
    (enter
      (= ovf 7))))
(machine div_zero
  (fault -> SAFE)
  (var d :int in 0..3 3)
  (var q :int in 0..300 0)
  (initial RUN)
  (state RUN
    (loop
      (= q (/ 12 d))
      (= div q)
      (= d (- d 1))))
  (state SAFE
    (enter
      (= div 7))))
(machine shift_amount
  (fault -> SAFE)
  (var k :int in 0..20 13)
  (var s :u16 1)
  (initial RUN)
  (state RUN
    (loop
      (= s (<< s k))
      (= shift (as (>> s 8) int))
      (= k (+ k 1))))
  (state SAFE
    (enter
      (= shift 7))))
(machine convert_loss
  (fault -> SAFE)
  (var w :int in 0..1000 250)
  (var b :u8 0)
  (initial RUN)
  (state RUN
    (loop
      (= b (as w u8))
      (= conv (as b int))
      (= w (+ w 3))))
  (state SAFE
    (enter
      (= conv 7))))
(machine index_write
  (fault -> SAFE)
  (var buf :[4]int (array 1 2 3 4))
  (var i :int in 0..6 0)
  (initial RUN)
  (state RUN
    (loop
      (= (index buf i) (* i 10))
      (= idx (+ (index buf 0) (index buf 3)))
      (= i (+ i 1))))
  (state SAFE
    (enter
      (= idx 7))))
(machine proven_fine
  (fault -> SAFE)
  (var n :int in 0..100 0)
  (var s :bytes<8> default)
  (initial RUN)
  (state RUN
    (loop
      (if (< n 100)
        (= n (+ n 1)))
      (var m :int in 0..8 (.len s))
      (= fine (+ n m))))
  (state SAFE
    (enter
      (= fine 7))))
