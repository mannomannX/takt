(system
  (language 1)
  (tick 1ms))
(input p :float[bar] in 0..100[bar] @hw("daq/p") max_age=10ms)
(output valve :bool @hw("o/valve") safe=false)
(output p_sim :float[bar] @sim("daq/p") safe=1[bar])
(machine dut
  (initial CLOSED)
  (state CLOSED
    (loop
      (check (< p 50[bar]) "overpressure" req="SR-1"))
    (when (> p 5[bar]) -> OPEN))
  (state OPEN
    (enter
      (= valve true))
    (loop
      (check (< p 80[bar]) "hard limit" req="SR-2"))
    (when (< p 2[bar]) -> CLOSED)
    (when (> p 90[bar]) -> LOCKED))
  (state LOCKED
    (enter
      (= valve false))
    (loop
      (check (< p 10[bar]) "locked out" req="SR-3"))
    (when (< p 1[bar]) -> CLOSED)))
(scenario "pressure rises" every=1ms
  (initial RUN)
  (state RUN
    (sequence
      (= p_sim 1[bar])
      (wait 3ms)
      (= p_sim 10[bar])
      (until (== (.state dut) OPEN) timeout=10ms)
      (verify valve "valve should open" req="SR-2")
      (verdict pass "opened"))))
(scenario "stays closed" every=1ms
  (initial RUN)
  (state RUN
    (sequence
      (= p_sim 1[bar])
      (wait 5ms)
      (verify (== (.state dut) CLOSED) "must stay closed" req="SR-1")
      (verdict pass "closed"))))
