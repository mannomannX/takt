(system
  (language 1)
  (tick 10ms))
(input rx_log :stream<line<64>> @hw("u/rx") max_rate=100[Hz] capacity=4)
(output y :int in 0..9 @sim("o"))
(output count :int in 0..99 @sim("c"))
(output sector :int in 0..999 @sim("s"))
(machine m
  (var seen :int in 0..99 0)
  (var last :int in 0..999 0)
  (initial A)
  (state A
    (loop
      (= count seen)
      (= sector last))
    (on rx_log matches "READY" as l
      (= y 7)
      (= seen (+ seen 1)))
    (on rx_log matches "Erasing sector {n:int}" as l
      (= last (.n l))
      (= seen (+ seen 1)))
    (on rx_log as l
      (= seen (+ seen 1)))
    (after 1s -> A)))
