(system
  (language 1)
  (tick 1ms))
(stream s :bytes<16> capacity=4)
(output first :int in 0..255 @sim("f"))
(output width :int in 0..16 @sim("w"))
(machine writer
  (var k :int in 0..9 0)
  (initial RUN)
  (state RUN
    (loop
      (send s "abc")
      (send s "n={k}")
      (= k (% (+ k 1) 10)))))
(machine reader
  (initial RUN)
  (state RUN
    (on s as m
      (= first (as (index (.data m) 0) int))
      (= width (.len (.data m))))))
