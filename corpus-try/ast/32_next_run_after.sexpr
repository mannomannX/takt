(system
  (language 1)
  (tick 10ms))
(input previous_run :PreviousRun @hw("sys/previous_run"))
(output previous_sim :PreviousRun @sim("sys/previous_run"))
(output next_run :NextRun @hw("sys/next_run") safe=NONE)
(output led :bool @hw("ui/led") safe=false)
(machine m
  (initial RUN)
  (state RUN
    (enter
      (= led true))
    (after 50ms -> OFF))
  (state OFF
    (enter
      (= led false)
      (= next_run (AFTER delay=10s)))))
