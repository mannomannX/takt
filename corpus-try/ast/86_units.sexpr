(system
  (language 1)
  (tick 10ms))
(unit sector 4 KiB)
(output psi_of :float[psi] @hw("o/psi") safe=0[psi])
(output bar_of :float[bar] @hw("o/bar") safe=0[bar])
(output kelvin :float[K] @hw("o/kelvin") safe=0[K])
(output celsius :float[degC] @hw("o/celsius") safe=0[degC])
(output fahr_k :float[K] @hw("o/fahr_k") safe=0[K])
(output fahr_c :float[degC] @hw("o/fahr_c") safe=0[degC])
(output volts :float[V] @hw("o/volts") safe=0[V])
(output share :float @hw("o/share") safe=0.0)
(output bytes_of :u32[B] @hw("o/bytes") safe=0[B])
(output mixed :float[bar] @hw("o/mixed") safe=0[bar])
(output mapped :float[pct] @hw("o/mapped") safe=0[pct])
(output banded :float[bar] @hw("o/banded") safe=0[bar])
(output area :float[bar*s] @hw("o/area") safe=0[bar*s])
(output smooth :float[bar] @hw("o/smooth") safe=0[bar])
(output high :bool @hw("o/high") safe=false)
(output slope :float[bar/s] @hw("o/slope") safe=0[bar/s])
(output limited :float[bar] @hw("o/limited") safe=0[bar])
(output drive :float[pct] @hw("o/drive") safe=0[pct])
(output mean :float[bar] @hw("o/mean") safe=0[bar])
(output rms :float[bar] @hw("o/rms") safe=0[bar])
(output agreed :float[bar] @hw("o/agreed") safe=0[bar])
(machine units
  (var p :float[bar] in 0[bar]..100[bar] 1[bar])
  (var t :float[degC] 20[degC])
  (var f :float[degF] 32[degF])
  (var n :u32[sector] in 0[sector]..100[sector] 1[sector])
  (var acc (call integrate [bar] limit=5[bar*s]))
  (var lp (call lowpass [bar] tau=50ms))
  (var hyst (call hysteresis [bar] lo=2[bar] hi=4[bar]))
  (var slope_ (call rate [bar]))
  (var rl (call rate_limiter [bar] max_rate=10[bar/s]))
  (var ctl (call pid kp=2[pct/bar] ki=1[pct/bar/s] kd=0.1[pct*s/bar] lo=0[pct] hi=100[pct]))
  (var win (call window_mean [bar 4]))
  (var wrms (call window_rms [bar 4]))
  (var vote (call vote2oo3 [bar] tol=0.5[bar]))
  (initial RUN)
  (state RUN
    (loop
      (= p (call clamp (+ p 0.37[bar]) 0[bar] 100[bar]))
      (= t (+ t 1.5[K]))
      (= f (+ f 2.25[degR]))
      (= n (call min (+ n 1[sector]) 100[sector]))
      (= psi_of (.to p psi))
      (= bar_of (.to psi_of bar))
      (= kelvin (.to t K))
      (= celsius (.to kelvin degC))
      (= fahr_k (.to f K))
      (= fahr_c (.to f degC))
      (= volts (.to (* (/ p 1[bar]) 125[mV]) V))
      (= share (/ (* (/ p 100[bar]) 100[pct]) 1[pct]))
      (= bytes_of (.to (* n 1) B))
      (= mixed (call lerp p (* 2 p) 0.25))
      (= mapped (call map_range p 0[bar] 10[bar] 0[pct] 100[pct]))
      (= banded (call deadband (- p 3[bar]) 0.5[bar]))
      (= area (.step acc p 10ms))
      (= smooth (.step lp p 10ms))
      (= high (.step hyst p))
      (= slope (.step slope_ p 10ms))
      (= limited (.step rl (* 2 p) 10ms))
      (= drive (.step ctl (- 5[bar] p) 10ms))
      (= mean (.step win p))
      (= rms (.step wrms p))
      (var v (.step vote p (+ p 0.2[bar]) (+ p 3[bar])))
      (= agreed (.or v 0[bar])))))
