(system
  (language 1)
  (tick 1ms)
  (output_timing boundary))
(import takt.filters as filt)
(import-channels "site1.hw")
(type Pressure float[bar] in 0..400[bar])
(unit degR affine K 0)
(unit knot 0.514444 m/s)
(record Trailer layout=big align=4
  (crc: u32 offset=12)
  (tag: [4]u8)
  (_: [2]u8))
(const PAYLOAD_MAX 64)
(param SCALE :float in 0..10 1.5)
(input spare :bool @none)
(input raw_rx :stream<u8> @hw("uart1/rx") max_rate=1[kHz] framing=raw overflow=drop_oldest capacity_bytes=512)
(input cobs_rx :stream<bytes<64>> @hw("uart2/rx") max_rate=500[Hz] framing=cobs overflow=drop)
(input lp_rx :stream<bytes<64>> @hw("uart3/rx") max_rate=500[Hz] framing=length_prefixed(u16_le))
(input fix_rx :stream<bytes<8>> @hw("uart4/rx") max_rate=500[Hz] framing=fixed(8))
(input vals :[4]float[V] in 0..5[V] @hw("daq1/ai[0:4]") max_age=10ms display=mV doc="vier Kanaele")
(input age_src :float[K] in 0..500[K] @hw("daq1/tc0") max_age=100ms)
(output burn :u8 @hw("sys/efuse_burn") safe=0 irreversible)
(output tx_raw :stream<u8> @hw("uart1/tx") max_rate=1[kHz] capacity=64)
(output pulse_o :bool @hw("gpio/pulse") safe=false jitter=1us)
(command reset)
(enum Shape
  (CIRCLE (r: float[m]))
  (RECT (w: float[m]) (h: float[m]))
  (EMPTY))
(enum ParseErr
  (SHORT)
  (BAD))
(fn fill [const N] (inout b:bytes<N> x:u8)
  (.push b x))
(fn parse (b:bytes<8>) -> u16!ParseErr
  (var r (call reader b))
  (var v (.u16_le r))
  (if (not (.valid v))
    (return (ERR SHORT)))
  (return (OK v)))
(native-fn crc_custom (b:bytes<64>) -> u32 from="crypto.rs" cost=5000 stack=128)
(block ticker ()
  (var n :int in 0..1000 0)
  (step (x:bool) -> int
    (if x
      (+= n 1))
    (return n))
  (method zero ()
    (= n 0)))
(machine nuances label="Nuancen" group="test"
  (fault -> SAFE)
  (var filters (instances 4 lowpass tau=50ms))
  (var t (call ticker))
  (var buf :bytes<64> default)
  (var small :bytes<8> default)
  (var word :u16 0)
  (var big :u64 0)
  (var wide :f64 0)
  (var name :str<16> "abc")
  (var g :mat<2, 2>[K] (array (array 1[K] 0[K]) (array 0[K] 1[K])))
  (var m :map<u16, int, 8> default)
  (var vel :float[m/s^2] 9.81[m/s^2])
  (initial RUN)
  (state RUN label="laeuft"
    (loop
      (check (.valid age_src) -> SAFE)
      (check (!= word 0xFFFF) "word saturated" req="SR-7")
      (verify (< big 10) "big small" req="SR-8")
      (if (or (or (.stale age_src) (.suspect age_src)) (> (.age age_src) 50ms))
        (log "reason {age_src.reason}"))
      (var opt :int? none)
      (var cast (as wide int))
      (var wrapped (.wrap_u8 word))
      (var sat (.saturating_add cast 1))
      (var w2 (.wrapping_add cast 1))
      (var f (call fma 1.0 2.0 3.0))
      (var hi (.bits word 15 8))
      (var w3 (.with_bit word 0 true))
      (var rl (call rotl word 3))
      (var mv (.to_float word mV))
      (var mins (.as time_in_state min))
      (-= word 1)
      (*= word 2)
      (/= word 2)
      (= word (>> (<< word 1) 1))
      (= word (| (& (~ word) 0b1010) 0o17))
      (var rem (% cast 3))
      (var sl (slice buf 0 4))
      (var sol (call solve g (array 1[K] 2[K])))
      (var ch (.cholesky g))
      (.clear buf)
      (.insert m 1 2)
      (.remove m 1)
      (for x in vals
        (alert (> x 4.5[V]) "high {x:.3}"))
      (for e in raw_rx
        (log "byte {e.seq} {{raw}}"))
      (if (matches name "{s:str<8>}" as cap)
        (log "cap {cap.s}"))
      (if (has name "b")
        (log "has b"))
      (.reset t)
      (var tb (.step t true))
      (log "count {tb:08}")
      (match cast
        (case 0..3 7
          (log "small"))
        (case _
          (log "other")))
      (match (call parse small)
        (case (OK v)
          (= word v))
        (case (ERR e)
          (log "err")))
      (verify (> (.free tx_raw) 0) "tx space")
      (verify (< (.jitter pulse_o) 5us) "jitter ok")
      (if (> (.tick last_fault) 0)
        (pass)))
    (when reset -> SAFE))
  (state SAFE
    (loop
      (abort))
    (when reset -> RUN))
  (state FAULTED
    (when reset -> RUN)))
(campaign never_stop
  (program "10_nuances.takt")
  (sweep SCALE [1.0 2.0])
  (stop_on never))
(instance twins [i in 0..2] pair idx=i)
(machine pair (idx:int in 0..1) every=10ms
  (initial RUN)
  (state RUN
    (loop
      (pass))))
