(system
  (language 1)
  (tick 1ms))
(output phase :int in 0..9 @hw("o/phase") safe=0)
(machine m
  (var k :int in 0..100 0)
  (initial RUN)
  (state RUN
    (loop
      (if (< k 100)
        (+= k 1)))
    (sequence timeout=20ms -> SLOW
      (= phase 1)
      (until (>= k 5))
      (= phase 2)
      (until (>= k 100))
      (= phase 3)))
  (state SLOW
    (enter
      (= phase 9))))
