(system
  (language 1)
  (tick 10ms))
(fn max_of [type T:ord, const N in 1..8] (xs:[N]T) -> T
  (var best (index xs 0))
  (for i in (range N)
    (if (> (index xs i) best)
      (= best (index xs i))))
  (return best))
(fn count_same [type T:eq, const N in 1..8] (xs:[N]T of:T) -> int in 0..8
  (var n 0)
  (for i in (range N)
    (if (== (index xs i) of)
      (= n (+ n 1))))
  (return n))
(input a :int in 0..100 @sim("i/a"))
(input b :float[V] in 0..5[V] @sim("i/b"))
(output peak :int in 0..100 @hw("o/peak") safe=0)
(output volts :float[V] @hw("o/volts") safe=0[V])
(output hits :int in 0..8 @hw("o/hits") safe=0)
(machine ctrl
  (var xs :[4]int in 0..100 (array 0 0 0 0))
  (var ys :[4]float[V] (array 0[V] 0[V] 0[V] 0[V]))
  (initial RUN)
  (state RUN
    (loop
      (= (index xs 0) a)
      (= (index ys 0) b)
      (= peak (call max_of xs))
      (= volts (call max_of ys))
      (= hits (call count_same xs a)))
    (when (> a 90) -> HIGH))
  (state HIGH
    (enter
      (= peak 100))
    (when (< a 10) -> RUN)))
