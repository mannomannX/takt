(system
  (language 1)
  (tick 1ms))
(native-fn crc32 (b:bytes<64>) -> u32 cost={i32:1000} stack=64)
(param CUT :int in 0..1000 0)
(param CUT_CHUNK :int in 0..1000 0)
(param FLIP :int in 0..1 0)
(const SLOT :int 128)
(const BASE :int 192)
(const WRITES :int 7)
(const LOGIC :int 0x7A6B)
(output flash_cmd :FlashCmd @hw("flash/cmd") safe=NONE)
(output flash_data :stream<u8> @hw("flash/tx") max_rate=4000[Hz] capacity=96)
(input flash_status :FlashStatus @hw("flash/status") max_age=10ms)
(input flash_rx :stream<bytes<4096>> @hw("flash/rx") max_rate=200[Hz] capacity=2)
(output flash_status_sim :FlashStatus @sim("flash/status"))
(output flash_rx_sim :stream<bytes<4096>> @sim("flash/rx") capacity=4096)
(input flash_seed :stream<u8> @hw("flash/seed") max_rate=200[kHz] capacity=256)
(input flash_seed_addr :int in 0..4194304 @hw("flash/seed_addr"))
(instance flash flash_model cmd=flash_cmd data=flash_data status=flash_status_sim rx=flash_rx_sim seed=flash_seed seed_addr=flash_seed_addr sectors=2 t_erase=2ms t_program=1ms cut_at_byte=CUT cut_at_chunk=CUT_CHUNK)
(record Entry
  (good: bool)
  (length: int in 0..8)
  (seqno: int in 0..1000)
  (value: int in 0..1000))
(record Scan
  (found: bool)
  (seqno: int in 0..1000)
  (value: int in 0..1000)
  (end: int in 0..128)
  (clean: bool))
(fn le32 (v:int) -> bytes<4>
  (var b :bytes<4> default)
  (.push b (as (paren (& v 0xFF)) u8))
  (.push b (as (paren (& (paren (>> v 8)) 0xFF)) u8))
  (.push b (as (paren (& (paren (>> v 16)) 0xFF)) u8))
  (.push b (as (paren (& (paren (>> v 24)) 0xFF)) u8))
  (return b))
(fn read32 (page:bytes<4096> pos:int) -> int
  (return (| (| (| (paren (as (index page pos) int)) (paren (<< (paren (as (index page (+ pos 1)) int)) 8))) (paren (<< (paren (as (index page (+ pos 2)) int)) 16))) (paren (<< (paren (as (index page (+ pos 3)) int)) 24)))))
(fn entry_len (n:int) -> int
  (return (* (/ (paren (+ (+ 32 n) 3)) 4) 4)))
(fn payload_of (k:int) -> bytes<8>
  (var b :bytes<8> default)
  (var value :bytes<4> (call le32 k))
  (.push b 0x77)
  (for x in value
    (.push b x))
  (return b))
(fn entry_header (seq:int payload:bytes<8>) -> bytes<32>
  (var h :bytes<32> default)
  (var buf :bytes<64> default)
  (var magic :bytes<4> (call le32 0x4A504B54))
  (var seqb :bytes<4> (call le32 seq))
  (var logic :bytes<4> (call le32 LOGIC))
  (var length :bytes<4> (call le32 (.len payload)))
  (for x in magic
    (.push h x))
  (.push h 2)
  (for i in (range 3)
    (.push h 0))
  (for x in seqb
    (.push h x))
  (for i in (range 4)
    (.push h 0))
  (for x in logic
    (.push h x))
  (for i in (range 4)
    (.push h 0))
  (for x in length
    (.push h x))
  (for x in h
    (.push buf x))
  (for x in payload
    (.push buf x))
  (var sum :bytes<4> (call le32 (as (call crc32 buf) int)))
  (for x in sum
    (.push h x))
  (return h))
(fn entry_at (page:bytes<4096> pos:int) -> Entry
  (var e :Entry default)
  (var length :int 0)
  (var buf :bytes<64> default)
  (if (> (+ pos 32) (.len page))
    (return e))
  (if (!= (call read32 page pos) 0x4A504B54)
    (return e))
  (if (> (paren (& (call read32 page (+ pos 4)) 0xFFFF)) 2)
    (return e))
  (if (or (!= (call read32 page (+ pos 16)) LOGIC) (!= (call read32 page (+ pos 20)) 0))
    (return e))
  (= length (call read32 page (+ pos 24)))
  (if (or (> length 8) (> (+ pos (call entry_len length)) (.len page)))
    (return e))
  (for i in (range 28)
    (.push buf (index page (+ pos i))))
  (for i in (range 8)
    (if (< i length)
      (.push buf (index page (+ (+ pos 32) i)))))
  (if (!= (paren (as (call crc32 buf) int)) (call read32 page (+ pos 28)))
    (return e))
  (= (.good e) true)
  (= (.length e) length)
  (= (.seqno e) (call read32 page (+ pos 8)))
  (if (== length 5)
    (= (.value e) (call read32 page (+ pos 33))))
  (return e))
(fn scan (page:bytes<4096>) -> Scan
  (var s :Scan default)
  (var e :Entry default)
  (var pos :int 0)
  (var more :bool true)
  (for i in (range 4)
    (if more
      (= e (call entry_at page pos))
      (if (.good e)
        (if (or (not (.found s)) (> (.seqno e) (.seqno s)))
          (= (.found s) true)
          (= (.seqno s) (.seqno e))
          (= (.value s) (.value e)))
        (= pos (+ pos (call entry_len (.length e)))))
      (else
        (= more false))))
  (= (.end s) pos)
  (= (.clean s) true)
  (for i in (range SLOT)
    (if (and (>= i pos) (!= (index page i) 0xFF))
      (= (.clean s) false)))
  (return s))
(machine journal
  (var payload :bytes<8> default)
  (var header :bytes<32> default)
  (var a :Scan default)
  (var b :Scan default)
  (var slot :int in 0..1 0)
  (var free :int in 0..128 0)
  (var clean :bool false)
  (var append :bool false)
  (var seq :int in 0..1000 0)
  (var target :int in 0..1 0)
  (var pos :int in 0..128 0)
  (var k :int in 0..1000 0)
  (var cut_k :int in 0..1000 0)
  (var stage :int in 0..2 0)
  (var told :bool false)
  (initial BOOT)
  (state BOOT
    (sequence
      (= flash_cmd (READ addr=(as BASE u32) size=(as SLOT u32)))
      (until (as flash_rx p) timeout=50ms)
      (= a (call scan (.data p)))
      (= flash_cmd NONE)
      (until (== flash_status IDLE) timeout=50ms)
      (= flash_cmd (READ addr=(as (paren (+ 4096 BASE)) u32) size=(as SLOT u32)))
      (until (as flash_rx q) timeout=50ms)
      (= b (call scan (.data q)))
      (= flash_cmd NONE)
      (until (== flash_status IDLE) timeout=50ms)
      (-> DECIDE)))
  (state DECIDE
    (enter
      (= slot 1)
      (= seq 0)
      (= free 0)
      (= clean false)
      (= k 0)
      (if (and (.found a) (paren (or (not (.found b)) (> (.seqno a) (.seqno b)))))
        (= slot 0)
        (= seq (.seqno a))
        (= free (.end a))
        (= clean (.clean a))
        (= k (.value a)))
      (elif (.found b)
        (= seq (.seqno b))
        (= free (.end b))
        (= clean (.clean b))
        (= k (.value b)))
      (verify (== k seq) "Stand und Sequenznummer laufen auseinander")
      (if (== stage 1)
        (measure after_cut k)
        (measure dirty (+ (paren (if (.clean a) 0 1)) (paren (if (.clean b) 0 2))))
        (verify (or (== k cut_k) (== k (- cut_k 1))) "weder der alte noch der neue Stand"))
      (elif (== stage 2)
        (measure stand k)
        (measure last_slot slot)
        (measure last_end free)
        (verify (== k (- WRITES FLIP)) "der juengste gueltige Stand fehlt")
        (verdict pass "jeder Start findet einen ganzen Stand")))
    (when (and (< stage 2) (< k WRITES)) -> BEGIN)
    (when (< stage 2) -> FINAL))
  (state BEGIN
    (enter
      (= k (+ k 1))
      (= payload (call payload_of k))
      (= header (call entry_header (+ seq 1) payload))
      (if (and (== FLIP 1) (== k WRITES))
        (= (index payload 4) 0xEE))
      (= append (and clean (<= (+ free (call entry_len (.len payload))) SLOT)))
      (= target (- 1 slot))
      (= pos 0)
      (if append
        (= target slot)
        (= pos free)))
    (when append -> APPEND)
    (when true -> WIPE))
  (state WIPE
    (sequence
      (= flash_cmd (ERASE sector=(as target u32)))
      (until (== flash_status DONE) timeout=50ms)
      (= flash_cmd NONE)
      (until (== flash_status IDLE) timeout=50ms)
      (-> APPEND))
    (when (== flash_status (ERROR code=1)) -> CUT))
  (state APPEND
    (sequence
      (= flash_cmd (PROGRAM addr=(as (paren (+ (+ (+ (* target 4096) BASE) pos) 32)) u32) size=(as (.len payload) u32)))
      (send flash_data payload)
      (until (== flash_status DONE) timeout=50ms)
      (= flash_cmd NONE)
      (until (== flash_status IDLE) timeout=50ms)
      (= flash_cmd (PROGRAM addr=(as (paren (+ (+ (* target 4096) BASE) pos)) u32) size=32))
      (send flash_data header)
      (until (== flash_status DONE) timeout=50ms)
      (= flash_cmd NONE)
      (until (== flash_status IDLE) timeout=50ms)
      (-> FINISH))
    (when (== flash_status (ERROR code=1)) -> CUT))
  (state FINISH
    (enter
      (= seq (+ seq 1))
      (= slot target)
      (= free (+ pos (call entry_len (.len payload))))
      (= clean true)
      (if (and (== stage 1) (not told))
        (measure next_slot slot)
        (= told true)))
    (when (< k WRITES) -> BEGIN)
    (when true -> FINAL))
  (state CUT
    (enter
      (= stage 1)
      (= cut_k k)
      (= flash_cmd NONE))
    (when (== flash_status IDLE) -> BOOT))
  (state FINAL
    (enter
      (= stage 2))
    (when true -> BOOT)))
(campaign power_cut
  (program "110_journal_log.takt")
  (sweep CUT 0..260 step=1)
  (stop_on never))
(campaign bit_error
  (program "110_journal_log.takt")
  (sweep FLIP [1])
  (stop_on never))
(campaign erase_cut
  (program "110_journal_log.takt")
  (sweep CUT_CHUNK 1..48 step=1)
  (stop_on never))
