system:
    language = 1
    tick     = 10 ms

# 12.7 — Startmuster als Programm, nicht als Sprache: ein neues Image auf
# Probe (TRIAL -> SELFTEST -> CONFIRM) an einem Update-Geraet der Plattform
# (`ota/…`), eine Reset-Schleife, die das Programm selbst ueber `persist`
# und `previous_run` zaehlt, und der Neustart aus sicherem Zustand ueber
# `next_run`.
#
# Ohne Angabe der Plattform kennt das Programm keinen vorigen Lauf und kein
# Image auf Probe. So laufen Interpreter, Wirt und Boards dasselbe Programm
# und sehen dieselben Ausgaenge; die Szenarien des Golden-Traces speisen die
# Werte ueber den Stimulus.

input  previous_run : PreviousRun @ hw("sys/previous_run")
input  on_trial     : bool        @ hw("ota/trial")
output confirm      : bool        @ hw("ota/confirm")  with safe = false
output next_run     : NextRun     @ hw("sys/next_run") with safe = NONE
output led          : bool        @ hw("ui/led")       with safe = false

param RESET_LIMIT   : int in 1..10 = 3
param SELFTEST_SUM  : int in 0..100000 = 2106
param RESTART_AFTER : Duration in 100 ms..10 s = 300 ms

profile BROKEN:
    SELFTEST_SUM = 2107

# Eine Simulation ist ein Lauf und kennt keine frueheren: Die Grenze 1
# zeigt die Reset-Schleife schon am ersten Start nach dem Watchdog.
profile LOOP:
    RESET_LIMIT = 1

# Der Selbsttest rechnet eine feste Tabelle nach; ein Image, das sie
# anders rechnet, bestaetigt sich nicht.
const TABLE : [8] int = [3, 1, 4, 1, 5, 9, 2, 6]

fn weighted(t: [8] int) -> int in 0..100000:
    var sum : int in 0..100000 = 0
    for i in range(8):
        sum += (i + 1) * t[i] * 13
    return sum

machine boot:
    pub var restarts : int in 0..1000 = 0
    # Starts nach dem Watchdog in Folge; jedes andere Ende setzt zurueck.
    persist var watchdog_starts : int in 0..1000 = 0

    initial DECIDE

    state DECIDE:
        enter:
            if previous_run.or(NONE) == WATCHDOG:
                watchdog_starts = min(watchdog_starts + 1, 1000)
            else:
                watchdog_starts = 0
        loop:
            alert previous_run.or(NONE) == WATCHDOG, "Start nach dem Watchdog, {watchdog_starts} in Folge"
        # Zu viele Starts nach dem Watchdog: nicht weiter neu starten,
        # sondern sicher stehen bleiben, bis jemand nachsieht.
        when watchdog_starts >= RESET_LIMIT: -> HOLD
        when on_trial.or(false): -> SELFTEST
        when true: -> RUN

    state SELFTEST:
        sequence:
            led = true
            wait 50 ms
            check weighted(TABLE) == SELFTEST_SUM, "selftest: table sum {weighted(TABLE)}"
            confirm = true
            -> RUN

    state RUN:
        loop:
            led = not led
        after RESTART_AFTER: -> RESTART

    # Neustart aus sicherem Zustand: Der Lauf endet nach dem Commit des
    # Ticks, `persist` ist geschrieben, alle Outputs stehen auf `safe` (12.7).
    state RESTART:
        enter:
            restarts += 1
            next_run = NOW

    state HOLD:
        enter:
            led = false
