t=0 alert hotfire on "LOX warming"
t=0 alert hotfire on "start refused: tank pressure 0.0"
t=0 state hotfire ARMED.IDLE
t=0 state pad_model RUN
t=0 out fuel_main CLOSED
t=0 out lox_main CLOSED
t=0 out igniter false
t=0 out tank_p_sim 50.0 bar
t=0 out chamber_p_sim 1.0 bar
t=0 out lox_temp_sim 90.0 K
t=2 log hotfire "starting hotfire"
t=2 state hotfire ARMED.IGNITION.S0
t=2 out fuel_main OPEN
t=152 state hotfire ARMED.IGNITION.S1
t=152 out igniter true
t=200 out chamber_p_sim 31.0 bar
t=201 state hotfire ARMED.IGNITION.S2
t=201 out lox_main OPEN
t=250 fault hotfire CheckFailed "chamber overpressure 260.0" -> SAFE
t=250 state hotfire SAFE
t=250 out fuel_main CLOSED
t=250 out lox_main CLOSED
t=250 out igniter false
t=250 out chamber_p_sim 61.0 bar
t=300 out chamber_p_sim 1.0 bar
t=1200 verdict-final FAIL
