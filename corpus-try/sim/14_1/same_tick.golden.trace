t=0 alert hotfire on "LOX warming (sensor invalid)"
t=0 state hotfire ARMED.IDLE
t=0 state pad_model RUN
t=0 out fuel_main CLOSED
t=0 out lox_main CLOSED
t=0 out igniter false
t=0 out tank_p_sim 50.0 bar
t=0 out chamber_p_sim 1.0 bar
t=0 out lox_temp_sim 90.0 K
t=1 alert hotfire off "LOX warming"
t=50 log hotfire "starting hotfire"
t=50 state hotfire ARMED.IGNITION.S0
t=50 out fuel_main OPEN
t=200 state hotfire ARMED.IGNITION.S1
t=200 out igniter true
t=700 fault hotfire Timeout "Timeout in `IGNITION.S1`" -> SAFE
t=700 state hotfire SAFE
t=700 out fuel_main CLOSED
t=700 out igniter false
t=1200 verdict-final FAIL
