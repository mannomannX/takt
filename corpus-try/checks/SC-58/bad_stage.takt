system:
    language = 1
    tick     = 1 ms

# SC-58 ist erst pruefbar, wenn es Knoten (12.9) gibt — v2.
# Bis dahin ist die Ablehnung der Abnahmetest (plan/m3.md 1.4).

output n : int in 0..99 @ hw("o/n") with safe = 0

node a @ hw("box1") with tick = 1 ms

machine m:
    initial RUN
    state RUN:
        loop:
            n = 1
