system:
    language = 1
    tick     = 1 ms

# SC-31 ist erst pruefbar, wenn es Projekt-Natives (4.5) gibt — v1.1.
# Bis dahin ist die Ablehnung der Abnahmetest (plan/m3.md 1.4).

output n : int in 0..99 @ hw("o/n") with safe = 0

native fn my_own(x: int) -> int from "mylib" with cost = 1, stack = 8, total

machine m:
    initial RUN
    state RUN:
        loop:
            n = 1
