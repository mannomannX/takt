system:
    language   = 1
    tick       = 1 ms
    tcb_policy = allowlist(my_own)

# Genannt in `tcb_policy`: das Projekt-Native gehoert zur TCB dieses Programms.

output n : int in 0..99 @ hw("o/n") with safe = 0

native fn my_own(x: int) -> int from "mylib" with cost = 1, stack = 8, total

machine m:
    initial RUN
    state RUN:
        loop:
            n = 1
