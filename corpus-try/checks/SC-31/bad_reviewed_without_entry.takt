system:
    language   = 1
    tick       = 1 ms
    tcb_policy = reviewed(my_own)

# Pruefung 31 mit `reviewed` (4.5, v1.2): Die Quelle liegt daneben, aber
# keine Zeile in `natives.review` nennt ihren Hash.

output n : int in 0..99 @ hw("o/n") with safe = 0

native fn my_own(x: int) -> int from "my_own.rs" with cost = 1, stack = 8, total  # ~ SC-31

machine m:
    initial RUN
    state RUN:
        loop:
            n = my_own(1)
