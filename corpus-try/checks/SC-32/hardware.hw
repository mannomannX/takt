# takt-hw 7
#
# Pruefung 32 (7.1, 7.2): Die Tickquelle steht in der Konfiguration, und
# die Last eines Ticks passt. Die Kalibrierung ist die aus
# tests/calibrated.rs, zum Kostenmodell 2.

[target.probe]
cost_model = 2
core_hz = 84000000
i32 = 11905
i64 = 35715
f32 = 11905
f64 = 1190500
mem = 23810
call = 47620
native = 0
t_io = 120000

[channel daq/clock]
direction = input
jitter_ns = 1000

[channel ui/led]
direction = output
raw = bool
safe = false
