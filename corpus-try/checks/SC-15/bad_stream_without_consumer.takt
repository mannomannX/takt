system:
    language = 1
    tick     = 1 ms

# SC-15: Einen internen Strom konsumiert niemand — `count` allein
# untersucht kein Element. Was gesendet wird, geht nach einem Tick
# verloren (9.6, FB-426).

stream<u8> q with capacity = 4  # ~ SC-15

output n : int in 0..9 @ hw("o/n") with safe = 0

machine writer:
    initial RUN

    state RUN:
        loop:
            send q, 1

machine watcher:
    initial RUN

    state RUN:
        loop:
            n = q.count
