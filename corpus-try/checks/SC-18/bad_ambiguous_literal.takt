system:
    language = 1
    tick     = 1 ms

# SC-18: auf `{a:int}` folgt eine Ziffer, die selbst zur Klasse gehoert.

output hit : bool @ hw("o/hit") with safe = false

machine m:
    var text : line<128> = ""
    initial RUN

    state RUN:
        loop:
            hit = text matches "n={a:int}5"  # ~ SC-18
