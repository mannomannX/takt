system:
    language = 1
    tick     = 1 ms

# SC-18 (8.7): Ein Muster bindet hoechstens 16 Platzhalter, `{_}` zaehlt
# nicht mit. Sechzehn und ein `{_}` gehen, der siebzehnte bindende nicht.

output hit : bool @ hw("o/hit") with safe = false
output top : bool @ hw("o/top") with safe = false

machine m:
    var text : line<256> = ""
    initial RUN

    state RUN:
        loop:
            top = text matches "{a:int},{b:int},{c:int},{d:int},{e:int},{f:int},{g:int},{h:int},{i:int},{j:int},{k:int},{l:int},{m:int},{n:int},{o:int},{p:int};{_}"
            hit = text matches "{a:int},{b:int},{c:int},{d:int},{e:int},{f:int},{g:int},{h:int},{i:int},{j:int},{k:int},{l:int},{m:int},{n:int},{o:int},{p:int},{q:int}"  # ~ SC-18
