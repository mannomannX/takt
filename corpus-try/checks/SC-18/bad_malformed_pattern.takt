system:
    language = 1
    tick     = 1 ms

# SC-18 (8.7): Ein Muster, das der Musterleser nicht versteht, und ein
# doppelter Capture-Name.

output hit : bool @ hw("o/hit") with safe = false

machine m:
    var text : line<128> = ""
    initial RUN

    state RUN:
        loop:
            hit = text matches "v{a:blob}"          # ~ SC-18
            hit = text matches "v{a:int} w{a:int}"  # ~ SC-18
