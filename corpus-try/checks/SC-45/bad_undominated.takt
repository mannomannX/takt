system:
    language = 1
    tick     = 1 ms

# SC-45: das Ergebnis wird ohne `.ok` benutzt; ein Fehler faultet dann.

enum JobFail: BUSY, GONE

fn attempt(x: int in 0..10) -> int!JobFail:
    return OK(x * 2)

output n : int in 0..64 @ hw("o/n") with safe = 0

machine m:
    initial RUN

    state RUN:
        loop:
            var r = attempt(3)
            n = r  # ~ SC-45
