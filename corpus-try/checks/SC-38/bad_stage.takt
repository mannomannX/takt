system:
    language = 1
    tick     = 1 ms

# SC-38 ist erst pruefbar, wenn es Einheiten auf Integern (3.2) gibt — v1.1.
# Bis dahin ist die Ablehnung der Abnahmetest (plan/m3.md 1.4).

output n : int in 0..99 @ hw("o/n") with safe = 0

machine m:
    var v : int[mV] = 3300
    initial RUN
    state RUN:
        loop:
            n = 1
