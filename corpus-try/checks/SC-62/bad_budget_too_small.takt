system:
    language = 1
    tick     = 1 ms

# SC-62: vier Byte reichen nicht fuer den Zustand der Maschine.

output n : int in 0..99 @ hw("o/n") with safe = 0

machine m with budget = {ram = 4}:  # ~ SC-62
    var a : int in 0..99 = 0
    initial RUN

    state RUN:
        loop:
            a = 1
            n = a
