system:
    language = 1
    tick     = 1 ms

# SC-13: der `hw`-Input hat im Sim-Build keine `sim`-Quelle (Festlegung 6: Warnung).

input  p : float[bar] in 0..100 bar @ hw("daq1/ai0")  # ~ SC-13
output v : bool                     @ hw("o/v") with safe = false

machine m:
    initial RUN

    state RUN:
        loop:
            v = p > 1 bar
