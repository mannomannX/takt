system:
    language = 1
    tick     = 1 ms

# Pruefung 26 (13.6): das Szenario stellt nur den `sim`-Output; die
# Anlage schreibt ihren `hw`-Output selbst.

input  p     : float[bar] in 0..100 bar @ hw("daq/p")   with max_age = 10 ms
output valve : bool                     @ hw("o/valve") with safe = false
output p_sim : float[bar]               @ sim("daq/p")  with safe = 1 bar

machine dut:
    initial RUN
    state RUN:
        loop:
            valve = p > 5 bar

scenario "raises the pressure" every 1 ms:
    initial RUN
    state RUN:
        sequence:
            p_sim = 10 bar
            wait 2 ms
            verdict pass "done"
