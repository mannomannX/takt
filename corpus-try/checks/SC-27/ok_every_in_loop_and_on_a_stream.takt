system:
    language = 1
    tick     = 1 ms

# SC-27: `every` steht im `loop:`, der `on`-Handler auf einem Stream.

input  rx    : stream<line<80>> @ hw("uart0/rx") with max_rate = 100 Hz
output valve : bool             @ hw("o/valve")  with safe = false

machine m:
    initial RUN

    state RUN:
        loop:
            every 10 ms:
                valve = false
        on rx as l:
            valve = l.text.len > 0
