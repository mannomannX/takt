system:
    language = 1
    tick     = 1 ms

# SC-25: Verlaesst der Timeout-Block den Zustand, erreicht das naechste
# Segment nur, wer den Capture hat.

record Pulse:
    pin : u8

stream<Pulse> pulses with capacity = 8

output first : int in 0..255 @ sim("f")

machine writer:
    initial RUN

    state RUN:
        loop:
            send pulses, Pulse(pin = 3)

machine waiter:
    initial WAIT

    state WAIT:
        sequence:
            until pulses as p timeout 5 ms else:
                log "kein Puls"
                -> IDLE
            first = p.data.pin as int

    state IDLE:
        loop:
            first = 0
