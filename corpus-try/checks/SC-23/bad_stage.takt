system:
    language = 1
    tick     = 1 ms

# SC-23 ist erst pruefbar, wenn es `persist var` (5.9) gibt — v1.1.
# Bis dahin ist die Ablehnung der Abnahmetest (plan/m3.md 1.4).

output n : int in 0..99 @ hw("o/n") with safe = 0

machine m:
    persist var c : int in 0..99 = 0
    initial RUN
    state RUN:
        loop:
            n = c
