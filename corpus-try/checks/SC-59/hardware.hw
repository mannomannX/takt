# takt-hw 7
#
# Prüfung 59 rechnet erst, wenn die vier Größen da sind. Diese
# Konfiguration trägt sie, damit die Rechnung selbst getestet ist —
# die Kalibrierung eines echten C6 ist ein M7-Punkt.

[target.probe]
cost_model = 1
core_hz = 84000000
i32 = 11905
i64 = 35715
f32 = 11905
f64 = 1190500
mem = 23810
call = 47620
native = 0
t_io = 120000

[device.uart]
driver = "uart-polled"
fifo_depth = 1024
byte_rate = 11520

[channel sys/clock]
direction = input
jitter_ns = 250000

[channel mmio/0x60000000/r]
direction = input
device = uart

[channel o/busy]
direction = output
raw = bool
safe = false

# Dasselbe noch einmal ohne `byte_rate`: das Geraet ist als gepollt
# erkennbar, aber die Rechnung fehlt eine Groesse. Pruefung 59 meldet
# das, statt zu schweigen.
[device.spi]
driver = "spi-polled"
fifo_depth = 64

[channel mmio/0x60001000/r]
direction = input
device = spi
