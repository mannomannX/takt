system:
    language = 1
    tick     = 1 ms

# SC-46: zwei Varianten mit derselben Diskriminante waeren beim Dekodieren
# nicht zu unterscheiden (3.7, FB-394); auch die gezaehlte Fortsetzung
# zaehlt.

enum Mode layout u8: A = 1, B = 1     # ~ SC-46
enum Step layout u8: C = 2, D = 1, E  # ~ SC-46

output v : bool @ hw("o/v") with safe = false

machine m:
    initial RUN

    state RUN:
        loop:
            pass
