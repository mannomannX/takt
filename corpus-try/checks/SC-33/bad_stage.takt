system:
    language = 1
    tick     = 1 ms

# SC-33 ist erst pruefbar, wenn es `follows` (7.2) gibt — v1.1.
# Bis dahin ist die Ablehnung der Abnahmetest (plan/m3.md 1.4).

output n : int in 0..99 @ hw("o/n") with safe = 0

machine a:
    initial RUN
    state RUN:
        loop:
            n = 1

machine b follows a:
    initial RUN
    state RUN:
        loop:
            pass
