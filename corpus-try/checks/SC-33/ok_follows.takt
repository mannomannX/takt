system:
    language = 1
    tick     = 1 ms

# Pruefung 33 (7.2): eine Kante, kein Zyklus; der Follower liest frisch.

output n : int in 0..99 @ hw("o/n") with safe = 0

machine a:
    pub var x : int in 0..99 = 0
    initial RUN
    state RUN:
        loop:
            if x < 99:
                x = x + 1

machine b follows a:
    initial RUN
    state RUN:
        loop:
            n = a.x
