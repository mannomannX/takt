system:
    language = 1
    tick     = 1 ms

# SC-17: 2000 Hz mal 10 ms sind 20 Elemente je Aktivierung; so viele passen.

input rx  : stream<line<64>> @ hw("uart0/rx") with max_rate = 2000 Hz, capacity = 20

output n : int in 0..99 @ hw("o/n") with safe = 0

machine m every 10 ms:
    var seen : int in 0..99 = 0
    initial RUN

    state RUN:
        loop:
            n = seen
        on rx as e:
            seen = seen + 1
