system:
    language = 1
    tick     = 1 ms

# Pruefung 55 (7.5): `bound` ist die zugesagte Reaktionszeit und muss
# positiv sein; null hiesse, die Ausgabe staende im Augenblick des
# Ereignisses selbst.

input  dut_log : stream<line<64>> @ sim("dut/log") with capacity = 8, max_rate = 200 Hz
output vbus    : bool             @ hw("o/vbus")   with safe = true
output phase   : int in 0..9      @ hw("o/phase")  with safe = 0

trigger cut:  # ~ SC-55
    when dut_log matches "Erasing sector {n:int}"
    then at event.t + 5 ms: vbus = false
    bound 0 ms

machine ctrl:
    initial IDLE

    state IDLE:
        enter:
            phase = 1
            arm cut

        when cut.fired as f: -> DONE

    state DONE:
        enter:
            phase = 2
