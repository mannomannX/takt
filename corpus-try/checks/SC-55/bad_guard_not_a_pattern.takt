system:
    language = 1
    tick     = 1 ms

# Pruefung 55 (7.5): `when` eines Triggers ist ein Muster ueber genau
# einem Strom, keine beliebige Bedingung. Der abgelehnte Trigger meldet
# an `arm cut` und `cut.fired` keinen Folgefehler.

input  dut_log : stream<line<64>> @ sim("dut/log") with capacity = 8, max_rate = 200 Hz
output vbus    : bool             @ hw("o/vbus")   with safe = true
output phase   : int in 0..9      @ hw("o/phase")  with safe = 0

trigger cut:
    when phase > 3  # ~ SC-55
    then at now + 20 ms: vbus = false
    bound 5 ms

machine ctrl:
    initial IDLE

    state IDLE:
        enter:
            phase = 1
            arm cut

        when cut.fired as f: -> DONE

    state DONE:
        enter:
            phase = 2
