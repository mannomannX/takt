system:
    language = 1
    tick     = 10 ms

# Pruefung 55 (7.5): `when` liest genau einen Strom, benannt, nicht einen
# Ausdruck daraus.

input  dut_log : stream<line<64>> @ sim("dut/log") with capacity = 8, max_rate = 200 Hz
output vbus    : bool             @ hw("o/vbus")   with safe = true

trigger cut:
    when dut_log.peek() matches "Erasing sector {n:int}"  # ~ SC-55
    then at now + 20 ms: vbus = false
    bound 5 ms

machine ctrl:
    initial IDLE

    state IDLE:
        enter:
            arm cut
