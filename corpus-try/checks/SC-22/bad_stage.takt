system:
    language = 1
    tick     = 1 ms

# SC-22 ist erst pruefbar, wenn es `idle`-Zustaende (5.10) gibt — v1.1.
# Bis dahin ist die Ablehnung der Abnahmetest (plan/m3.md 1.4).

output n : int in 0..99 @ hw("o/n") with safe = 0

machine m:
    initial RUN
    state RUN idle:
        when true: -> DONE
    state DONE:
        loop:
            n = 1
