system:
    language = 1
    tick     = 1 ms

# Pruefung 53 (b), 5.11: Kein Scope in einem `idle`-Zustand — er schlaeft,
# die Instanz braeuchte Ticks.

command wake with wake = true

output o : bool @ hw("o/o") with safe = false

machine blip(x: output bool) every 1 ms:
    initial LOW

    state LOW:
        enter:
            x = false

        after 3 ms: -> HIGH

    state HIGH:
        enter:
            x = true

        after 3 ms: -> LOW

machine ctrl:
    initial SLEEPING

    state SLEEPING idle:  # ~ SC-22
        instance p = blip(x = o)

        when wake: -> AWAKE

    state AWAKE:
        loop:
            pass
