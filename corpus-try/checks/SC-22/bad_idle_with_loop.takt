system:
    language = 1
    tick     = 1 ms

input  wake : bool         @ hw("gpio/btn") with wake = true
output n    : int in 0..99 @ hw("o/n")      with safe = 0

machine m:
    initial SLEEP

    state SLEEP idle:  # ~ SC-22
        loop:
            n = 1
        when wake: -> RUN

    state RUN:
        loop:
            n = 2
