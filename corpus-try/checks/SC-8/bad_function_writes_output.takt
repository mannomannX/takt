system:
    language = 1
    tick     = 1 ms

# SC-8: Funktionen schreiben keine Outputs (4.4) (SEM1-059).

output v : bool @ hw("o/v") with safe = false
command go

fn f(x: bool) -> bool:
    v = x  # ~ SC-8
    return x

machine m:
    initial A

    state A:
        loop:
            v = f(true)
