system:
    language = 1
    tick     = 1 ms

# SC-8: ein Aktionsblock deklariert keine Variablen (5.5, FB-399).

output v : bool @ hw("o/v") with safe = false
command go

machine m:
    initial A

    state A:
        when go:
            var x : int in 0..9 = 1  # ~ SC-8
            v = x > 0
            -> B

    state B:
        when go: -> A
