system:
    language = 1
    tick     = 1 ms

# SC-24: Wo die Intervallanalyse Schiebebetrag und Konversion beweist,
# entfaellt die Pruefung — und mit ihr die Warnung (3.4). Beide Wege stehen
# hier: eine engere Range am Ursprung und eine Verfeinerung im Zweig.

output n : int in 0..99 @ hw("o/n") with safe = 0

machine w:
    var small : int in 0..9 = 5
    var big   : int in 0..999 = 500
    var bits  : int = 0
    initial RUN

    state RUN:
        loop:
            for i in range(3):
                # Die Range am Ursprung traegt durch die Rechnung.
                n = (small as u8) as int
                bits = 1 << small

                # Der Vergleich verfeinert den Zweig.
                if big < 64:
                    bits = 1 << big
