system:
    language = 1
    tick     = 1 ms

# SC-24: Schiebebetraege, `as`-Konversionen, `vec`-Indizes und Slices ohne
# Beweis warnen in einer `for`-Schleife (3.4, Warnpolitik). Ausserhalb einer
# Schleife bleiben sie stumm — dann nur eine Zahl im Report. Ranges gehoeren
# zu Pruefung 4 (FB-399).

output n : int in 0..255 @ hw("o/n") with safe = 0

machine m:
    var big   : int in 0..999 = 500
    var shift : int in 0..99 = 3
    var bits  : int = 0
    initial RUN

    state RUN:
        loop:
            for i in range(3):
                n = (big as u8) as int  # ~ SC-24
                bits = 1 << shift       # ~ SC-24
