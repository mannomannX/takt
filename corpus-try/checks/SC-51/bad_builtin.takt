# SC-51: vordefinierte offene Enums (PreviousRun, FaultKind ueber last_fault.kind).

system:
    language = 1
    tick     = 10 ms

input  previous_run : PreviousRun @ hw("sys/previous_run") with max_age = 1 s
output led          : bool        @ hw("gpio/led")         with safe = false

machine boot:
    initial RUN

    state RUN:
        loop:
            match previous_run:  # ~ SC-51
                case ENDED:
                    led = true
                case WATCHDOG:
                    led = false
            match last_fault.kind:  # ~ SC-51
                case TIMEOUT:
                    led = false
                case ABORT:
                    led = true
