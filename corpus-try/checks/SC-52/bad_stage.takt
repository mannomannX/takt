system:
    language = 1
    tick     = 1 ms

# SC-52 ist erst pruefbar, wenn es Konstantenvariablen in Generics (3.12) gibt — v1.1.
# Bis dahin ist die Ablehnung der Abnahmetest (plan/m3.md 1.4).

output n : int in 0..99 @ hw("o/n") with safe = 0

fn first[const N](a: [N] int in 0..9) -> int:
    return a[0]

machine m:
    initial RUN
    state RUN:
        loop:
            n = 1
