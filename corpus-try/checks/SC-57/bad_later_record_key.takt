system:
    language = 1

# Pruefung 57 (3.9): Der Schluessel `Key` steht erst unter dem Record, der
# ihn benutzt; sein Fliesskommafeld zaehlt trotzdem.

record Holder:
    by_key : map<Key, int, 4>  # ~ SC-57

record Key:
    t : float

output n : int in 0..8 @ hw("o/n") with safe = 0

machine m:
    var h : Holder = default
    initial RUN
    state RUN:
        loop:
            n = h.by_key.len
