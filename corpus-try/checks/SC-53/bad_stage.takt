system:
    language = 1
    tick     = 1 ms

# SC-53 ist erst pruefbar, wenn es gescopte Instanzen (5.11) gibt — v1.2.
# Bis dahin ist die Ablehnung der Abnahmetest (plan/m3.md 1.4).

output n : int in 0..99 @ hw("o/n") with safe = 0

block b():
    var x : int in 0..9 = 0
    step() -> int:
        return x

machine m:
    initial RUN
    state RUN:
        instance i = b()
        loop:
            n = 1
