system:
    language = 1
    tick     = 1 ms

# SC-11: Was ein Block zeigt, steppt eine Instanz hoechstens einmal (5.7,
# FB-399, FB-423): zweimal hintereinander, auch dasselbe Element eines
# Instanz-Arrays, in einer Schleife oder in einem Handler, der je Element
# des Fensters laeuft, ist ein Fehler; einmal je Zweig nicht.

block counter():
    var n : int in 0..99 = 0
    step() -> int:
        n = (n + 1) % 100
        return n

stream<u8> q with capacity = 4

output v  : int in 0..99 @ hw("o/v")  with safe = 0
output v2 : int in 0..99 @ hw("o/v2") with safe = 0
output v3 : int in 0..99 @ hw("o/v3") with safe = 0
output v4 : int in 0..99 @ hw("o/v4") with safe = 0
command fast

machine m:
    var c = counter()
    initial RUN

    state RUN:
        loop:
            v = c.step()
            v = c.step()  # ~ SC-11
            if fast:
                v = c.step()  # ~ SC-11
            else:
                pass
            for i in range(2):
                v = c.step()  # ~ SC-11

machine branches:
    var d = counter()
    initial RUN

    state RUN:
        loop:
            if fast:
                v2 = d.step()
            else:
                v2 = d.step()

machine elements:
    var cs = [2] counter()
    initial RUN

    state RUN:
        loop:
            v3 = cs[0].step()
            v3 = cs[1].step()
            v3 = cs[0].step()  # ~ SC-11
            for i in range(2):
                v3 = cs[0].step()  # ~ SC-11

machine producer:
    initial RUN

    state RUN:
        loop:
            send q, 1

machine consumer:
    var e = counter()
    initial RUN

    on q as x:
        v4 = e.step()  # ~ SC-11

    state RUN:
        loop:
            pass
