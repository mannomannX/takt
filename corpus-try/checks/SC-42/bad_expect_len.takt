system:
    language = 1
    tick     = 10 ms

# Pruefung 42, zweite Klausel (8.6): `expect_len < N` ohne
# `capacity_bytes` bemisst den Puffer nach der Annahme; Lemma 9.6.1 gilt
# dann nur unter ihr, und der Compiler sagt es.

input  rx    : stream<line<256>> @ hw("uart0/rx") with max_rate = 100 Hz, framing = lines, capacity = 8, expect_len = 80  # ~ SC-42
output lines : int in 0..999     @ hw("o/lines")  with safe = 0

machine m:
    var n : int in 0..999 = 0
    initial RUN
    state RUN:
        on rx as l:
            n = min(n + 1, 999)
            lines = n
