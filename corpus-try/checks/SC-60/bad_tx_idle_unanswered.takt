system:
    language = 1
    tick     = 10 ms

# Pruefung 60 (8.8): `tx.idle` an einem Kanal, dessen Treiber die Frage
# nicht beantwortet (`tx_idle = false` in der Konfiguration). Der Rand
# raet nicht.

output spi_tx : stream<u8> @ hw("spi0/tx") with max_rate = 200 Hz, capacity = 16
output cs_n   : bool       @ hw("spi0/cs") with safe = true

machine eink:
    initial SEND

    state SEND:
        loop:
            cs_n = spi_tx.idle  # ~ SC-60
