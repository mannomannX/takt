# takt-hw 13
#
# Pruefung 60 (8.8, 8.10): Der Treiber von `spi0/tx` meldet nur den freien
# Platz im Sendepuffer, nicht, ob das letzte Bit draussen ist.

[channel spi0/tx]
direction = output
tx_idle = false

[channel spi0/cs]
direction = output
raw = bool
safe = true

# Unter `--zephyr` (8.10, Treiber aus dem Devicetree): Pins aus dem
# Devicetree, deren `port` ein Label sein muss und deren Rohtyp `bool`.
[device.pins]
driver = "zephyr-gpio"

[channel pins/led]
direction = output
raw = bool
safe = false
device = pins
port = "PC13"

[channel pins/buzzer]
direction = output
raw = bool
safe = false
device = pins

[channel pins/level]
direction = output
raw = u8
safe = 0
device = pins
port = "takt_level"
