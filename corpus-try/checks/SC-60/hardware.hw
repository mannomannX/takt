# takt-hw 13
#
# Pruefung 60 (8.8, 8.10): Der Treiber von `spi0/tx` meldet nur den freien
# Platz im Sendepuffer, nicht, ob das letzte Bit draussen ist.

[channel spi0/tx]
direction = output
tx_idle = false

[channel spi0/cs]
direction = output
raw = bool
safe = true

# Unter `--zephyr` (8.10, Treiber aus dem Devicetree): Pins aus dem
# Devicetree, deren `port` ein Label sein muss und deren Rohtyp `bool`.
[device.pins]
driver = "zephyr-gpio"

[channel pins/led]
direction = output
raw = bool
safe = false
device = pins
port = "PC13"

[channel pins/buzzer]
direction = output
raw = bool
safe = false
device = pins

[channel pins/level]
direction = output
raw = u8
safe = 0
device = pins
port = "takt_level"

# Analoge Eingaenge aus dem Devicetree (FB-735): Rohtyp `i32` in
# Mikrovolt, Volt ueber `linear(a, b)`; `table(…)` ist unter Zephyr offen
# (FB-780).
[device.adc]
driver = "zephyr-adc"

[channel adc/micro]
direction = input
raw = i32
unit = uV
device = adc
port = "takt_micro"

[channel adc/linear]
direction = input
raw = i32
unit = V
calibration = "linear(0.000001, 0)"
device = adc
port = "takt_linear"

[channel adc/out]
direction = output
raw = i32
unit = uV
safe = 0
device = adc
port = "takt_out"

[channel adc/narrow]
direction = input
raw = u16
unit = uV
device = adc
port = "takt_narrow"

[channel adc/volts]
direction = input
raw = i32
unit = V
device = adc
port = "takt_volts"

[channel adc/table]
direction = input
raw = i32
unit = V
calibration = "table(0 0, 3300000 3.3)"
device = adc
port = "takt_table"

[channel pair/seen]
direction = input
from = "pair/last"
from_tick_ns = 100000000
from_timing = asap

[channel pair/sent]
direction = output
from = "pair/last"
from_tick_ns = 100000000
from_timing = boundary
