system:
    language = 1
    tick     = 1 ms

# SC-56 ist erst pruefbar, wenn es `property` (13.3) gibt — v1.1.
# Bis dahin ist die Ablehnung der Abnahmetest (plan/m3.md 1.4).

output n : int in 0..99 @ hw("o/n") with safe = 0

machine m:
    initial RUN
    state RUN:
        loop:
            n = 1

property p: always(n < 100)
