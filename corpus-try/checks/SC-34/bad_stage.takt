system:
    language = 1
    tick     = 1 ms

# SC-34 ist erst pruefbar, wenn es dimensionierte Matrizen (3.11) gibt — v1.1.
# Bis dahin ist die Ablehnung der Abnahmetest (plan/m3.md 1.4).

output n : int in 0..99 @ hw("o/n") with safe = 0

unitvec UV = (m, s)

machine m:
    initial RUN
    state RUN:
        loop:
            n = 1
