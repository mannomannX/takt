system:
    language = 1
    tick     = 1 ms

# Pruefung 34 (3.11): Einheitentupel nach Hart — Produkt, Addition,
# Cholesky und variable Indizes.

unitvec X = (m, m/s)

output pos : float[m] @ hw("o/pos") with safe = 0

const F : mat[X, 1/X] = [[1, (10 ms).as(s)], [0 1/s, 1]]

machine m:
    var x : vec[X] = [0 m, 1 m/s]
    var p : mat[X, X] = [[1 m^2, 0 m^2/s], [0 m^2/s, 1 m^2/s^2]]
    var i : int in 0..1 = 0
    initial RUN
    state RUN:
        loop:
            var a = p * F         # ~ SC-34
            var b = p + F         # ~ SC-34
            var l = F.cholesky()  # ~ SC-34
            pos = x[i, 0]         # ~ SC-34
