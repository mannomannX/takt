# Was die Regeln der Einheiten erlauben (3.2): `degF` ueber `degR` mit dem
# Faktor als Bruch, binaere Praefixe auf `B`, `min`/`max` und Vergleich auf
# affinen Werten, Punkt minus Punkt, Punkt plus Differenz, `.to` zwischen
# affinen und absoluten Einheiten, SI-Praefixe auf `A`, `Ah` und `Wh`; die
# Einheitenvariablen von `pid` aus `kp` und `lo` geloest (3.12).

system:
    language = 1
    tick     = 1 ms

unit third  = 1/3 m
unit sector = 4 KiB

output o : float @ hw("o/o") with safe = 0.0

machine units:
    var f   : float[degF] = 32 degF
    var c1  : float[degC] = 20 degC
    var c2  : float[degC] = 30 degC
    var n   : u32[MiB] = 1 MiB
    var s   : u32[sector] = 2 sector
    var l   : float[third] = 3 third
    var i   : float[uA] = 5 uA
    var e   : float[mAh] = 5 mAh
    var w   : float[kWh] = 1 kWh
    var h   : float[pct] = 50 pct
    var err : float[mV] = 1 mV
    var ctl = pid(kp = 0.5 V/mV, ki = 0.1 V/mV/s, kd = 0.0 V*s/mV, lo = -5 V, hi = 5 V)
    initial RUN
    state RUN:
        loop:
            var u     = ctl.step(err, 1 ms)
            var hi    = max(c1, c2)
            var lo    = min(c1, c2)
            var d     = c2 - c1
            var up    = c1 + 5 K
            var up2   = 5 K + c1
            var down  = c1 - 5 K
            var fd    = f + 9 degR - (f - 1 degR)
            var k     = f.to(K)
            var fc    = f.to(degC)
            var bytes = (s * 1).to(B)
            var len   = l.to(m)
            o = d / (1 K) + k / (1 K) + (fc - 0 degC) / (1 K) + len / (1 m) + h / (1 pct)
