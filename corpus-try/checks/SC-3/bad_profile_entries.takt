system:
    language = 1
    tick     = 1 ms

# Pruefung 3 (8.4): Ein Profil setzt Parameter, jeden hoechstens einmal
# und mit einem Wert ihres Typs. Ein doppelter Eintrag ist ein Fehler,
# kein stilles „der letzte gilt".

param LIMIT : float[bar] in 0..10 bar = 5 bar
param STEP  : int in 1..5 = 1
const FIXED : int = 3

profile FAST:
    STEP  = 2
    STEP  = 3    # ~ SC-3
    FIXED = 4    # ~ SC-3
    LIMIT = 5 K  # ~ SC-3
    NOPE  = 1    # ~ SC-2

output o : int in 0..9 @ hw("o/o") with safe = 0

machine m:
    initial RUN
    state RUN:
        loop:
            o = STEP
