system:
    language = 1
    tick     = 1 ms

# SC-14: jede Frist ist ein Vielfaches der Periode, jedes `until` hat einen Timeout.

output v : bool @ hw("o/v") with safe = false

machine m every 2 ms:
    initial A

    state A:
        after 6 ms: -> B

    state B:
        enter:
            v = true
        after 4 ms: -> A
