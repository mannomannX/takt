system:
    language = 1
    tick     = 1 ms

# SC-14: `until` ohne Timeout wartet unbegrenzt.

input  p     : float[bar] in 0..100 bar @ hw("d/p")
output p_sim : float[bar]               @ sim("d/p")
output v     : bool                     @ hw("o/v") with safe = false

machine m:
    initial RUN

    state RUN:
        sequence:
            v = true
            until p > 10 bar  # ~ SC-14
            v = false
            -> DONE

    state DONE:
        loop:
            pass
