system:
    language = 1
    tick     = 1 ms

# SC-19: ein `match` ueber Werte ist nur mit `case _` erschoepfend.

output n : int in 0..99 @ hw("o/n") with safe = 0

machine m:
    var x : int in 0..9 = 0
    initial RUN

    state RUN:
        loop:
            match x:  # ~ SC-19
                case 0: n = 1
                case 1: n = 2
