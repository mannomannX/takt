system:
    language = 1
    tick     = 1 ms

# SC-19: `match` ueber ein Enum deckt jede Variante ab oder traegt `case _`.

enum Cmd: NONE, ARM(pre : int in 0..99, level : int in 0..99)

output n : int in 0..99 @ hw("o/n") with safe = 0

machine m:
    var c : Cmd = NONE
    initial RUN

    state RUN:
        loop:
            match c:  # ~ SC-19
                case NONE: n = 0
