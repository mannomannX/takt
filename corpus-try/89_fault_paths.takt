# 89 — Wege in den Fault und daran vorbei (4.1, 3.5, 3.8, 5.3): Eine
# Funktion, die in einer Maschine faultet, faultet keine andere, die im
# selben Tick eine Funktion ruft (FB-337); ein unbewachtes `T?` ohne Wert
# ist `MissingValue` (FB-338); `and`, `or` und `a if c else b` werten den
# nicht gewaehlten Zweig nicht aus, auch wenn er einen ungueltigen Channel
# liest (FB-339). Ohne Stimulus ist `p` ungueltig.

system:
    language = 1
    tick     = 10 ms

input  p     : float[bar] in 0..100 bar @ hw("daq/p")   with max_age = 50 ms
output a_out : int                      @ hw("o/a")     with safe = 0
output b_out : int                      @ hw("o/b")     with safe = 0
output c_out : int                      @ hw("o/c")     with safe = 0
output high  : bool                     @ hw("o/high")  with safe = false
output any   : bool                     @ hw("o/any")   with safe = false
output shown : float[bar]               @ hw("o/shown") with safe = 0 bar

fn inc(x: int in 0..100) -> int in 0..100:
    return min(x + 1, 100)

fn quotient(d: int in -5..5) -> int:
    return 10 / d

fn pick(n: int in 0..100) -> int?:
    if n > 2:
        return none
    return n

machine a:
    var d : int in -5..5 = 2
    initial RUN
    state RUN:
        loop:
            d = max(d - 1, -5)
            a_out = quotient(d)

machine b:
    var n : int in 0..100 = 0
    initial RUN
    state RUN:
        loop:
            n = inc(n)
            b_out = n

machine c:
    var n : int in 0..100 = 0
    initial RUN
    state RUN:
        loop:
            n = inc(n)
            var x : int = pick(n)
            c_out = x

machine guard:
    initial RUN
    state RUN:
        loop:
            high = p.valid and p > 5 bar
            any = not p.valid or p > 5 bar
            shown = p if p.valid else 0 bar
