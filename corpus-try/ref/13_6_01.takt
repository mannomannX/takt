scenario "erase interrupted at sector 3" every 1 ms:
    initial RUN
    state RUN:
        sequence:
            until dut_model.state == ERASING and dut_model.sector == 3 timeout 5 s  # ~ SC-2
            expect brownout_test.state == CUTTING                                   # ~ SC-2
            until brownout_test.state == DONE timeout 10 s                          # ~ SC-2
            verify brownout_test.result == RECOVERED, "expected recovery"           # ~ SC-2
            verdict pass
