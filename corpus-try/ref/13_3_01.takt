property no_ignition_without_fuel: always(igniter implies fuel_main == OPEN)                            # ~ SC-2
property abort_recovers: always(hotfire.state == SAFE implies eventually[10 s](hotfire.state == IDLE))  # ~ SC-2
property no_chatter: always(valve == OPEN implies stable[50 ms](valve == OPEN))                         # ~ SC-2
property armed_before_fire: always(igniter implies once[1 s](armed))                                    # ~ SC-2
