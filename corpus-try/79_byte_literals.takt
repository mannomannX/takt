# 79 — Byte-Folgen-Literale (3.9): `[0x01, 199, 0x00]` als Initialisierer
# und `send`-Argument fuer `bytes<N>` und Bytestroeme; die Laenge ist die
# Elementzahl, ein Element darf gerechnet sein.

system:
    language = 1
    tick     = 10 ms

output total  : int        @ hw("o/total")  with safe = 0
output second : int        @ hw("o/second") with safe = 0
output tx     : stream<u8> @ hw("o/tx")     with max_rate = 4000 Hz, capacity = 16

machine m:
    var cmd : bytes<4> = [0x01, 199, 0x00]
    var k   : int in 0..3 = 0

    initial RUN

    state RUN:
        loop:
            var frame : bytes<8> = [k as u8, 7]
            total = (cmd.len + frame.len) as int + (frame[0] as int)
            second = cmd[1] as int
            if k == 0:
                send tx, [0xAA, 0x55, k as u8]
            k = (k + 1) % 4
