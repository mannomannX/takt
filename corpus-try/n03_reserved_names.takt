# N03 — Reserviertes Wort als Bezeichner und reservierter Membername als Feld.
# Erwartet: zwei Fehler aus 2.5 (Pruefung 50).
# `region` meldet nur Pruefung 50: Der Parser nimmt das gemeldete Wort als
# Namen (FB-408). `state` ist ein Schluesselwort und scheitert am Parser.

system:
    language = 1
    tick = 10 ms

record Reading:
    valid : bool
    state : int in 0..3  # ~ P

output region : bool @ hw("gpio/do0") with safe = false  # ~ SC-50

machine names:
    initial RUN

    state RUN:
        loop:
            region = true  # ~ SC-50
