# 91 — Subnormale Zahlen (4.2, FB-329): Ein Wert faellt Tick fuer Tick
# durch den subnormalen Bereich von `f64`, bis er null wird. Jede Operation
# darauf ist endlich und korrekt gerundet; ein Ziel mit FTZ oder DAZ saehe
# ihn frueher auf null fallen und rechnete die Quotienten, Summen und
# Wurzeln anders. Der Vergleich ist bitgenau (9.4.4).

system:
    language = 1
    tick     = 10 ms

output value   : f64  @ hw("o/value")   with safe = 0.0
output third   : f64  @ hw("o/third")   with safe = 0.0
output root    : f64  @ hw("o/root")    with safe = 0.0
output summed  : f64  @ hw("o/summed")  with safe = 0.0
output is_zero : bool @ hw("o/is_zero") with safe = false

machine decay:
    var x : f64 = 1e-300
    initial RUN

    state RUN:
        loop:
            x = x * 0.001
            value = x
            third = x / 3.0
            root = sqrt(x)
            summed = x + x * 0.5
            is_zero = x == 0.0
