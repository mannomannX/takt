# 04 — Komposition: Blockbausteine, parametrisierte Maschinen mit Instanzen,
#      Multirate mit phase und follows, pub var, Signale, every, for/break, samples.

system:
    language = 1
    tick     = 50 us

unit pct2 = 0.01

block lowpass[U](tau: Duration):
    var y      : float[U] = 0
    var seeded : bool = false
    step(x: float[U], dt: Duration in tick..1 h) -> float[U]:
        if not seeded:
            y = x
            seeded = true
        var a : float = dt.as(s) / (tau.as(s) + dt.as(s))
        y = y + a * (x - y)
        return y

block limiter[U](max_rate: float[U/s]):
    var last : float[U] = 0
    step(target: float[U], dt: Duration in tick..1 h) -> float[U]:
        var step_max : float[U] = max_rate * dt.as(s)
        if target > last + step_max:
            last = last + step_max
        elif target < last - step_max:
            last = last - step_max
        else:
            last = target
        return last

input  i_phase   : samples<float[A], 16>          @ hw("adc/ia")   with rate = 320 kHz
input  speed     : float[1/min] in 0..12000 1/min @ hw("enc/rpm")  with max_age = 1 ms
output duty      : float in 0..1                  @ hw("pwm/ch0")  with safe = 0, label = "PWM duty"
output fault_led : bool                           @ hw("gpio/led") with safe = false

param I_MAX : float[A] in 1..60 A = 40 A
param KP    : float in 0..10 = 0.8

machine current_ctrl every 50 us:
    fault -> TRIP
    pub var i_meas : float[A] = 0 A
    signal tripped
    initial RUN

    state RUN:
        loop:
            check i_phase.max() < I_MAX, "phase overcurrent" for 200 us
            i_meas = i_phase.mean()
            var err : float[A] = speed_setpoint_current() - i_meas
            duty = clamp01(KP * err / I_MAX)
        when i_phase.max() >= I_MAX:
            raise tripped
            -> TRIP

    state TRIP:
        enter:
            duty = 0
            fault_led = true

fn clamp01(x: float) -> float:
    return 0 if x < 0 else (1 if x > 1 else x)

fn speed_setpoint_current() -> float[A]:
    return 10 A

machine speed_ctrl follows current_ctrl every 1 ms phase 100 us:
    initial RUN

    state RUN:
        loop:
            every 100 ms:
                log "speed loop alive"
            for i in range(4):
                if i_phase.count == 0:
                    break
                pass
        when current_ctrl.tripped: -> HOLD

    state HOLD:
        when speed < 10 1/min: -> RUN

machine fan_ctrl(setpoint: input float[pct2], out: output float, tau: Duration = 500 ms) every 10 ms:
    initial RUN

    state RUN:
        loop:
            out = setpoint / (100 pct2)

input  fan_sp_a : float[pct2] in 0..100 pct2 @ hw("ui/fan_a")
input  fan_sp_b : float[pct2] in 0..100 pct2 @ hw("ui/fan_b")
output fan_a    : float in 0..1              @ hw("pwm/fan_a") with safe = 0
output fan_b    : float in 0..1              @ hw("pwm/fan_b") with safe = 0

instance fan_one = fan_ctrl(setpoint = fan_sp_a, out = fan_a)
instance fan_two = fan_ctrl(setpoint = fan_sp_b, out = fan_b, tau = 1 s)
