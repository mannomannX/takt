# takt-hw 18 edition 1 compiler 0.1.0
# WeAct Black Pill (STM32F401CCU6, Cortex-M4F): Kalibrierung, Speicher,
# Geraete und Kanaele fuer 29_heartbeat.takt (8.10).
#
# **Gemessen mit `takt bench` auf Board 1** (2026-10-11, zum Kostenmodell
# 2, mit dem Messprogramm als Baustein; 200 Wiederholungen je Kern, 84 MHz,
# Flash ueber den ART-Beschleuniger). Der Bericht daneben
# (`stm32f401.report`) nennt Streuung, Umstaende und das Gewicht je Lage:
# Aus dem Flash haengt eine Messung an der Lage des Codes, gemessen wurde
# darum in drei Lagen und jedes Gewicht nimmt die schlechtere (FB-367). Die
# Tabelle ist um 43059523/38784594 gestreckt, getrieben vom kleinen Kern der
# Probe `call`, dessen Zeit selbst an der Lage haengt. `T_IO` enthaelt den
# Commit (FB-450). Der Hook der Runtime hat sein eigenes Gewicht
# (`call_hook`, FB-295). `guard` und `jitter` je Kanal misst `takt
# driver-test` (FB-285; die Drahtbruecke am Ende, 2026-10-02). Die korrekt
# gerundete Mathematik hat ein Gewicht je Breite (`f32_math`, `f64_math`;
# FB-344): der Aufwand eines Aufrufs im erzeugten Code, gemessen an `pow`,
# auf dem teuersten Einstieg ueber alle Funktionen und Vektoren (`acos` in
# beiden Breiten); `libtaktm` rechnet hier mit `opt-level = 3`.
#
# `ram` steht im Datenblatt. Vom Flash gehoeren Sektor 0 dem
# HID-Bootloader, Sektor 1 dem Sprungbrett und Sektor 2 und 3 dem Journal
# (FB-385); `flash` ist, was ab Sektor 4 der Anwendung bleibt.
#
# Das Journal haelt den Kern an (12.3): Der F401 hat eine Bank, und jeder
# Befehlsabruf wartet, solange das Flash loescht oder programmiert.
# `protect`: Die MPU des Cortex-M4 schuetzt den Programmbereich der Arena
# ausserhalb des Ticks (12.3).
[target.thumbv7em]
cost_model = 2
core_hz = 84000000
i32 = 11905
i64 = 20694
f32 = 87612
f64 = 1888889
mem = 36272
call = 249405
native = 0
t_io = 8869048
ram = 65536
flash = 196608
protect = armv7m_mpu
nvm_sector_bytes = 16384
nvm_sectors = 2
nvm_min_interval = 10000000000
# Gemessen am 11.10.2026 mit `58_persist_alert` ueber 21 Schreibvorgaenge
# (`the_journal_costs_time_but_not_semantics`): Loeschen eines Sektors
# hoechstens 197 ms, Programmieren hoechstens 0,14 ms; hier mit Reserve, wie
# beim C6. Das Datenblatt nennt fuer 16 KiB bei x32 typisch 250 und
# hoechstens 500 ms; altert das Flash dorthin, ist hier nachzumessen.
nvm_erase_ns = 300000000
nvm_program_ns = 200000
nvm_blocking = true
i32_div = 104724
i64_div = 1962472
f32_div = 449776
f64_div = 3212177
tick_jitter_ns = 0
# Stack-Reserve je Form (12.3, 13.8, FB-513): die tiefste Hochwassermarke
# des Lastkerns (`bench/load.takt`) in Echtzeit und logischer Zeit, gemalt
# ab der Tickschleife, ohne seinen Programmanteil. Aus den Protokollen des
# Bench vom 2026-10-11 je Form zugeordnet; der naechste Bench schreibt sie
# selbst, seit der Kopf eines Laufs seine Form nennt.
stack_reserve = 2884
stack_reserve_interrupt = 3716
stack_reserve_poll = 3052
stack_reserve_rtos = 4240
# Die Hauptschleife des Bring-ups in der Pollform (12.11): je Runde 10 us
# fremde Arbeit, dazu Leitung, LED und Pruefzugriffe; die Bilanz nennt die
# gemessene laengste Runde. EXTI1 ist der Job-Interrupt.
main_loop_ns = 50000
job_interrupt = true
# Die fremde Last der Board-Unterstuetzung (8.10, 12.11; M11 Schritt 16),
# fuer die Antwortzeiten mehrerer Programme eines Kerns. Die laengste Sperre
# unter einem Schritt setzt `TXEIE` in der Hauptschleife oder stellt das
# Ziel eines Alarms, je einige Dutzend Takte. Zugesagt, nicht gemessen.
foreign_block_ns = 1000
foreign_block_origin = Vertrag
f32_fma = 287016
f64_fma = 6270647
f32_sqrt = 465587
f64_sqrt = 3826699
call_hook = 1499256
f32_math = 395222097
f64_math = 878439483

# Die ISR der Leitung (USART1) liegt ueber jedem Schritt: hoechstens ein
# Eintritt je Byte bei 921 600 Baud. Zugesagt; das Binary `pair` misst
# laengsten Lauf und kuerzesten Abstand, und sein Board-Test vergleicht
# (`two_programs_share_a_core`).
[target.thumbv7em.isr.uart]
cost_ns = 3000
period_ns = 10850
origin = Vertrag

[device.gpio]
driver = "stm32f4-gpio"

[channel ui/led]
direction = output
raw = bool
safe = false
device = gpio
port = "PC13 active_low"

# Die Drahtbruecke PA0 an PA1 als Messschleife von
# `takt driver-test --board stm32f401` (13.8). Die Messwerte traegt der Lauf ein.
[device.wire]
driver = "stm32f4-gpio"

[channel gpio/loop_out]
direction = output
raw = bool
safe = false
device = wire
port = "PA0"
guard_ns = 227
jitter_ns = 6739
tick_granular = true

[channel gpio/loop_in]
direction = input
raw = bool
device = wire
port = "PA1"
latency_ns = 48
