# takt-hw 12
# WeAct Black Pill (STM32F401CCU6, Cortex-M4F): Kalibrierung, Speicher,
# Geraete und Kanaele fuer 29_heartbeat.takt (8.10).
#
# **Gemessen mit `takt bench` auf Board 1** (2026-10-01, zum Kostenmodell
# 2; 200 Wiederholungen je Kern, 84 MHz, Flash mit Prefetch und ohne
# Caches). Der Bericht daneben (`stm32f401.report`) nennt Streuung und
# Umstaende. Der Hook der Runtime hat sein eigenes Gewicht (`call_hook`,
# FB-295); die Tabelle ist um 42226191/38119946 gestreckt, getrieben vom
# kleinen Kern der Probe `call`: Ohne Cache verschiebt jede Aenderung am
# Image die Ausrichtung im Flash um einige Prozent, und die Streckung
# traegt das. `guard` und `jitter` je Kanal misst `takt driver-test`
# (FB-285; die Drahtbruecke am Ende, 2026-10-02). Die korrekt gerundete
# Mathematik hat ein Gewicht je Breite (`f32_math`, `f64_math`;
# Konfiguration 12, FB-344): gemessen an der
# teuersten Funktion des Boards, `acos` in beiden Breiten, und mindestens ihr
# teuerster Vektor am Einstieg (`acos` in `f64` 84 701 Zyklen); `libtaktm`
# rechnet hier mit `opt-level = 3`.
#
# `ram` und `flash` stehen im Datenblatt; die ersten 16 KiB Flash gehoeren
# dem HID-Bootloader, das Journal liegt in zwei 16-KiB-Sektoren dahinter.
[target.thumbv7em]
cost_model = 2
core_hz = 84000000
i32 = 13188
i64 = 23079
f32 = 93410
f64 = 2103349
mem = 39562
call = 184951
native = 0
t_io = 3250000
ram = 65536
flash = 245760
nvm_sector_bytes = 16384
nvm_sectors = 2
nvm_min_interval = 10000000000
i32_div = 115593
i64_div = 2164130
f32_div = 446163
f64_div = 3611212
tick_jitter_ns = 0
stack_reserve = 788
f32_fma = 263537
f64_fma = 6905318
f32_sqrt = 473362
f64_sqrt = 4167134
call_hook = 2564897
f32_math = 505766065
f64_math = 1116963247

[device.gpio]
driver = "stm32f4-gpio"

[channel ui/led]
direction = output
raw = bool
safe = false
device = gpio
port = "PC13 active_low"

# Die Drahtbruecke PA0 an PA1 als Messschleife von
# `takt driver-test --board stm32f401` (13.8). Die Messwerte traegt der Lauf ein.
[device.wire]
driver = "stm32f4-gpio"

[channel gpio/loop_out]
direction = output
raw = bool
safe = false
device = wire
port = "PA0"
guard_ns = 227
jitter_ns = 6739
tick_granular = true

[channel gpio/loop_in]
direction = input
raw = bool
device = wire
port = "PA1"
latency_ns = 48
