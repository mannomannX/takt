# takt-hw 5
# WeAct Black Pill (STM32F401CCU6, Cortex-M4F): Kalibrierung, Speicher,
# Geraete und Kanaele fuer 29_heartbeat.takt (8.10).
#
# **Gemessen mit `takt bench` auf Board 1** (2026-09-25, 200 Wiederholungen
# je Kern, 84 MHz, Flash mit Prefetch und ohne Caches). Der Bericht daneben
# (`stm32f401.report`) nennt Streuung und Umstaende. Die Tabelle ist um
# 3690476/2564996 gestreckt, damit sie jeden Referenzkern deckt; den Faktor
# treibt der Fault-Pfad des Sequenzkerns mit dem Hook der Runtime (FB-295).
# `guard` und `jitter` je Kanal misst erst `takt driver-test` (FB-285).
#
# **Veraltet seit FB-300.** Die Gewichte gehoeren zum Kostenmodell vor
# FB-298 und FB-299 (die Tabelle traegt kein `cost_model`): Damals zaehlte
# eine Endlichkeitspruefung als Gleitkommaoperation, und `fma` und `sqrt`
# hatten kein eigenes Gewicht. Der Compiler urteilt mit ihr nicht, bis
# `takt bench` neu misst.
#
# `ram` und `flash` stehen im Datenblatt; die ersten 16 KiB Flash gehoeren
# dem HID-Bootloader, das Journal liegt in zwei 16-KiB-Sektoren dahinter.
[target.thumbv7em]
core_hz = 84000000
i32 = 17129
i64 = 29976
f32 = 168698
f64 = 1466976
mem = 51385
call = 241512
native = 0
t_io = 1511905
ram = 65536
flash = 245760
nvm_sector_bytes = 16384
nvm_sectors = 2
nvm_min_interval = 10000000000
i32_div = 149070
i64_div = 2819490
f32_div = 411435
f64_div = 3038232
tick_jitter_ns = 0
stack_reserve = 600

[device.gpio]
driver = "stm32f4-gpio"

[channel ui/led]
direction = output
raw = bool
safe = false
device = gpio
port = "PC13 active_low"
