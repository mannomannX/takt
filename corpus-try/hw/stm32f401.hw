# takt-hw 17 edition 1 compiler 0.1.0
# WeAct Black Pill (STM32F401CCU6, Cortex-M4F): Kalibrierung, Speicher,
# Geraete und Kanaele fuer 29_heartbeat.takt (8.10).
#
# **Gemessen mit `takt bench` auf Board 1** (2026-10-11, zum Kostenmodell
# 2, mit dem Messprogramm als Baustein; 200 Wiederholungen je Kern, 84 MHz,
# Flash ueber den ART-Beschleuniger). Der Bericht daneben
# (`stm32f401.report`) nennt Streuung, Umstaende und das Gewicht je Lage:
# Aus dem Flash haengt eine Messung an der Lage des Codes, gemessen wurde
# darum in drei Lagen und jedes Gewicht nimmt die schlechtere (FB-367). Die
# Tabelle ist um 43059523/38784594 gestreckt, getrieben vom kleinen Kern der
# Probe `call`, dessen Zeit selbst an der Lage haengt. `T_IO` enthaelt den
# Commit (FB-450). Der Hook der Runtime hat sein eigenes Gewicht
# (`call_hook`, FB-295). `guard` und `jitter` je Kanal misst `takt
# driver-test` (FB-285; die Drahtbruecke am Ende, 2026-10-02). Die korrekt
# gerundete Mathematik hat ein Gewicht je Breite (`f32_math`, `f64_math`;
# FB-344): der Aufwand eines Aufrufs im erzeugten Code, gemessen an `pow`,
# auf dem teuersten Einstieg ueber alle Funktionen und Vektoren (`acos` in
# beiden Breiten); `libtaktm` rechnet hier mit `opt-level = 3`.
#
# `ram` und `flash` stehen im Datenblatt; die ersten 16 KiB Flash gehoeren
# dem HID-Bootloader; das Journal soll in den zwei 16-KiB-Sektoren dahinter
# liegen, die heute noch die Anwendung belegt (FB-385).
# `protect`: Die MPU des Cortex-M4 schuetzt den Programmbereich der Arena
# ausserhalb des Ticks (12.3).
[target.thumbv7em]
cost_model = 2
core_hz = 84000000
i32 = 13052
i64 = 22769
f32 = 97379
f64 = 2097887
mem = 40188
call = 235262
native = 0
t_io = 8345239
ram = 65536
flash = 245760
protect = armv7m_mpu
nvm_sector_bytes = 16384
nvm_sectors = 2
nvm_min_interval = 10000000000
i32_div = 116062
i64_div = 2206371
f32_div = 526227
f64_div = 3565914
tick_jitter_ns = 0
# Stack-Reserve je Form (12.3, 13.8, FB-513): die tiefste Hochwassermarke
# des Lastkerns (`bench/load.takt`) in Echtzeit und logischer Zeit, gemalt
# ab der Tickschleife, ohne seinen Programmanteil. Aus den Protokollen des
# Bench vom 2026-10-11 je Form zugeordnet; der naechste Bench schreibt sie
# selbst, seit der Kopf eines Laufs seine Form nennt.
stack_reserve = 2628
stack_reserve_interrupt = 3364
stack_reserve_poll = 2764
stack_reserve_rtos = 3648
# Die Hauptschleife des Bring-ups in der Pollform (12.11): je Runde 10 us
# fremde Arbeit, dazu Leitung, LED und Pruefzugriffe; die Bilanz nennt die
# gemessene laengste Runde. EXTI1 ist der Job-Interrupt.
main_loop_ns = 50000
job_interrupt = true
f32_fma = 284082
f64_fma = 6935297
f32_sqrt = 495869
f64_sqrt = 4264829
call_hook = 1657239
f32_math = 504299201
f64_math = 1120696050

[device.gpio]
driver = "stm32f4-gpio"

[channel ui/led]
direction = output
raw = bool
safe = false
device = gpio
port = "PC13 active_low"

# Die Drahtbruecke PA0 an PA1 als Messschleife von
# `takt driver-test --board stm32f401` (13.8). Die Messwerte traegt der Lauf ein.
[device.wire]
driver = "stm32f4-gpio"

[channel gpio/loop_out]
direction = output
raw = bool
safe = false
device = wire
port = "PA0"
guard_ns = 227
jitter_ns = 6739
tick_granular = true

[channel gpio/loop_in]
direction = input
raw = bool
device = wire
port = "PA1"
latency_ns = 48
