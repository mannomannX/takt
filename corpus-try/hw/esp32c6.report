# takt-conformance 1
# Konformitaetsbericht (13.8): das Protokoll der Messung. Zeiten in Pikosekunden,
# Streuungen als `min mean max` in Zyklen.

[run]
date = "2026-10-01"
board = "esp32c6"
target = "riscv32imac"
profile = "baremetal"
tool = "takt 0.1.0"
core_hz = 160000000
runs = 200

[calibration]
t_io_ps = 3025000
stretch = 1/1
stack_reserve = 4916
subnormal_failures = 0

[probe i32]
