# takt-conformance 1
# Konformitaetsbericht (13.8): das Protokoll der Messung. Zeiten in Pikosekunden,
# Streuungen als `min mean max` in Zyklen.

[run]
date = "2026-09-25"
board = "esp32c6"
target = "riscv32imac"
profile = "baremetal"
tool = "takt 0.1.0"
