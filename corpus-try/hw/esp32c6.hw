# takt-hw 15 edition 1 compiler 0.1.0
# ESP32-C6-DevKitM-1-N4 (ESP32-C6-MINI-1, RV32IMAC, 160 MHz, ohne FPU):
# Speicher und Journal fuer die Profilfamilie `xip_flash` (12.3,
# plan/esp32c6.md).
#
# **Gemessen mit `takt bench` auf Board 2** (2026-10-06, 200 Wiederholungen
# je Kern, 160 MHz), zum Kostenmodell 2, mit dem Messprogramm als Baustein.
# Der Bericht daneben (`esp32c6.report`) nennt Streuung und Umstaende. Aus
# dem RAM misst der Kern ohne Streuung (Minimum gleich Maximum), und die
# Tabelle braucht keine Streckung; die alte Messung trug in jeder Reihe
# einen Ausreisser von 273 Zyklen (FB-451). `T_IO` enthaelt den Commit
# (FB-450). Der Hook der Runtime hat sein eigenes Gewicht (`call_hook`,
# FB-295).
#
# Was die Zahlen voraussetzen: Alles, was der Tick beruehrt, liegt im RAM
# (12.3, `rwtext_hook.x`, FB-301, FB-357) — der erzeugte Code mit seinem
# C-Rahmen, die Schleife, der Treiberrand, die kuratierten Natives, die
# korrekt gerundete Mathematik (`libtaktm` mit `opt-level = 3`) samt ihren
# Tabellen, `fma` und `sqrt` aus `compiler_builtins` und die Konstanten;
# die Soft-Float-Grundrechenarten im ROM des Chips. Ohne FPU sind Division,
# `fma` und `sqrt` Bibliotheksaufrufe mit eigenem Gewicht (7.2); die
# Mathematik hat eines je Breite (`f32_math`, `f64_math`; FB-344): der
# Aufwand eines Aufrufs im erzeugten Code, gemessen an `pow`, auf dem
# teuersten Einstieg ueber alle Funktionen und Vektoren (`acos` in beiden
# Breiten).
#
# `ram` und `iram` nennen denselben Bereich, und das ist kein Fehler: Der
# C6 hat einen einheitlichen HP-SRAM (`esp-hal` richtet 0x6E610 Byte ein,
# der Rest geht an Cache und Bootloader), aus dem sowohl Daten als auch
# RAM-residenter Code kommen. Pruefung 39 vergleicht beide Summen gegen
# dieselbe Grenze — zusammen duerfen sie sie nicht ueberschreiten.
#
# Das Journal haelt den Kern an (12.3): Die ROM-Routinen warten synchron
# auf das Flash. Gemessen am 17.09.2026 mit `58_persist_alert` ueber 16
# Schreibvorgaenge: Loeschen hoechstens 49,9 ms, Programmieren hoechstens
# 0,12 ms; hier mit Reserve.
[target.riscv32imac]
cost_model = 2
core_hz = 160000000
ram = 451600
flash = 4194304
iram = 451600
nvm_sector_bytes = 4096
nvm_sectors = 2
nvm_erase_ns = 60000000
nvm_program_ns = 200000
nvm_blocking = true
i32 = 7305
i64 = 24854
f32 = 332793
f64 = 531914
mem = 27871
call = 44063
native = 0
i32_div = 60643
i64_div = 1025311
f32_div = 1204023
f64_div = 2338593
f32_fma = 4290078
f64_fma = 2774355
f32_sqrt = 458417
f64_sqrt = 1286836
t_io = 3781250
tick_jitter_ns = 0
stack_reserve = 4696
# Interrupts laufen auf dem Stack des unterbrochenen Fadens, also auch auf
# dem des Jobs; Trap-Rahmen, Verteiler und die Handler einer
# Prioritaetsstufe brauchen unter 1 KiB, die Reserve verdoppelt das (4.5).
job_stack_reserve = 2048
call_hook = 524336
f32_math = 231568750
f64_math = 501975000

[device.led]
driver = "esp32c6-rmt-ws2812"

[channel ui/led]
direction = output
raw = bool
safe = false
device = led
port = "GPIO8"

[device.button]
driver = "esp32c6-gpio-in"

[channel ui/button]
direction = input
raw = bool
device = button
port = "GPIO9 active_low pull_up debounce=3"

# Die Drahtbruecke GPIO7 an GPIO17: sonst UART0, als Messschleife von
# `takt driver-test --board esp32c6` (13.8). Die Messwerte traegt der Lauf ein.
[device.wire]
driver = "esp32c6-gpio"

[channel gpio/loop_out]
direction = output
raw = bool
safe = false
device = wire
port = "GPIO7"
guard_ns = 4338
jitter_ns = 36563
tick_granular = true

[channel gpio/loop_in]
direction = input
raw = bool
device = wire
port = "GPIO17"
latency_ns = 800
