# takt-hw 7
# ESP32-C6-DevKitM-1-N4 (ESP32-C6-MINI-1, RV32IMAC, 160 MHz, ohne FPU):
# Speicher und Journal fuer die Profilfamilie `xip_flash` (12.3,
# plan/esp32c6.md).
#
# **Gemessen mit `takt bench` auf Board 2** (2026-09-25, 200 Wiederholungen
# je Kern, 160 MHz), zum Kostenmodell 1. Der Bericht daneben
# (`esp32c6.report`) nennt Streuung und Umstaende. Gestreckt um
# 1993750/1966137, also kaum: Jeder Referenzkern liegt unter seiner Schranke.
#
# Was die Zahlen voraussetzen: Der erzeugte Code, sein C-Rahmen, der
# Tick-Pfad und die Mathematik aus `compiler_builtins` (`fma`, `sqrt`)
# liegen im RAM (`rwtext_hook.x`, FB-301), die Soft-Float-Grundrechenarten
# im ROM des Chips. Aus dem Flash ueber den Cache kommen nur noch die
# Trace-Hooks der Runtime (FB-295). Ohne FPU sind Division, `fma` und
# `sqrt` Bibliotheksaufrufe mit eigenem Gewicht (7.2).
#
# `ram` und `iram` nennen denselben Bereich, und das ist kein Fehler: Der
# C6 hat einen einheitlichen HP-SRAM (`esp-hal` richtet 0x6E610 Byte ein,
# der Rest geht an Cache und Bootloader), aus dem sowohl Daten als auch
# RAM-residenter Code kommen. Pruefung 39 vergleicht beide Summen gegen
# dieselbe Grenze — zusammen duerfen sie sie nicht ueberschreiten.
#
# Das Journal haelt den Kern an (12.3): Die ROM-Routinen warten synchron
# auf das Flash. Gemessen am 17.09.2026 mit `58_persist_alert` ueber 16
# Schreibvorgaenge: Loeschen hoechstens 49,9 ms, Programmieren hoechstens
# 0,12 ms; hier mit Reserve.
[target.riscv32imac]
cost_model = 1
core_hz = 160000000
ram = 451600
flash = 4194304
iram = 451600
nvm_sector_bytes = 4096
nvm_sectors = 2
nvm_erase_ns = 60000000
nvm_program_ns = 200000
nvm_blocking = true
i32 = 7666
i64 = 24510
f32 = 359787
f64 = 565073
mem = 27847
call = 53555
native = 0
i32_div = 60207
i64_div = 1041435
f32_div = 1225290
f64_div = 2383914
f32_fma = 4361499
f64_fma = 2848752
f32_sqrt = 461272
f64_sqrt = 1029888
t_io = 2387500
tick_jitter_ns = 0
stack_reserve = 4564

[device.led]
driver = "esp32c6-rmt-ws2812"

[channel ui/led]
direction = output
raw = bool
safe = false
device = led
port = "GPIO8"

[device.button]
driver = "esp32c6-gpio-in"

[channel ui/button]
direction = input
raw = bool
device = button
port = "GPIO9 active_low pull_up debounce=3"
