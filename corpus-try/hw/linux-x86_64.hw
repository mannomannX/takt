# takt-hw 17 edition 1 compiler 0.1.0
# Linux auf x86-64 unter dem POSIX-Port (`crates/takt-embed-c/ports/posix`,
# M11 Schritt 18c): nur die Stack-Reserven, die `takt port-test --emit
# embed --form rtos` in `P_TICK_STACK_BYTES` und `P_JOB_STACK_BYTES`
# einrechnet (12.3). Jeder Faden traegt ueber dem Programm den Kern des
# SDK, die Leitung, die libc und oben den Fadenkopf von glibc (TCB und
# statisches TLS), denn der Port gibt den Stack selbst vor.
#
# **Gemessen** mit `a_posix_port_passes_the_port_test` auf ubuntu-24.04
# (glibc 2.39, clang 22.1.8) in fuenf CI-Laeufen am 2026-10-12: Schritt-
# Stack 6680 bis 7896 Byte bei 112 Byte Programmanteil, Job-Stack 6312 bis
# 7640 Byte bei 640 Byte `stack` der Native und 32 Byte Waechter. Die
# Spanne von 1216 Byte trifft beide Faeden gleich, sie liegt also im
# Fadenkopf von glibc. Die Reserven nehmen das Hoechste auf die naechste
# KiB. Waechst eine Tiefe darueber, faellt der Test mit der gemessenen Zahl
# durch, und hier ist nachzumessen.

[target.x86_64]
stack_reserve_rtos = 8192
job_stack_reserve = 8192
