# 07 — Feldbetrieb auf einem kleinen Kern: Persistenz, Schlafzustand mit
#      Wake-Quellen, Bit-Operationen, Einheiten auf Integern, Jobs und
#      Chunk-Natives, Geraet mit Kommando und Status, System-Channels.

system:
    language = 1
    tick = 10 ms
    target = baremetal
    float = f32
    tick_source = hw("gptimer0")
    tick_tolerance = 2 pct for 10 ticks

unit sector = 4096 B          # B, KiB, MiB sind vordefiniert (3.2)

enum FlashCmd: NONE, ERASE(sector_no: u32), PROGRAM(addr: u32[B], size: u32[B]), READ(addr: u32[B], size: u32[B])
enum FlashStatus: IDLE, BUSY, DONE, ERROR(code: u8)
# ImageState (CONFIRMED, TRIAL) ist als System-Enum vordefiniert (12.7)

record SelftestResult:
    passed : bool
    code : int in 0..255

native fn crc32c(b: bytes<256>) -> u32 with cost = {i32: 4000}, stack = 64, total
native fn sha256_init() -> Sha256Ctx with cost = 200, stack = 64, total
native fn sha256_update(ctx: Sha256Ctx, chunk: bytes<256>) -> Sha256Ctx with cost = {i32: 90000}, stack = 256, total
native fn sha256_final(ctx: Sha256Ctx) -> bytes<32> with cost = 3000, stack = 256, total
native job verify_sig(key: bytes<64>, digest: bytes<32>, sig: bytes<64>) -> bool with cost = 300, stack = 2048, duration = 120 ms, total

input  cell_mv      : u16[mV] in 2000 mV..4500 mV @ hw("afe/cell0") with max_age = 100 ms, max_slew = 200 mV/s
input  charger      : bool @ hw("gpio/vbus") with wake = true
input  button       : stream<Edge> @ hw("gpio/btn") with max_rate = 50 Hz, wake = true
input  chg_status   : u8 @ hw("i2c1/0x6B/0x0B") with max_age = 500 ms
input  flash_status : FlashStatus @ hw("flash/status") with max_age = 10 ms
input  flash_rx     : stream<bytes<256>> @ hw("flash/rx") with max_rate = 200 Hz, capacity = 2
input  image_state  : ImageState @ hw("sys/image_state") with max_age = 1 s
output flash_cmd    : FlashCmd @ hw("flash/cmd") with safe = NONE
output fet_chg      : bool @ hw("gpio/fet_chg") with safe = false
output led          : u8 @ hw("pwm/led") with safe = 0
output image_confirm : bool @ hw("sys/image_confirm") with safe = false

command wake_up with wake = true

param V_MAX      : u16[mV] in 4000 mV..4300 mV = 4200 mV
param IMAGE_SIZE : u32[B] in 1024 B..1048576 B = 65536 B
param PUBKEY_SLOT : int in 0..3 = 0

machine bms every 100 ms:
    fault -> PROTECT
    persist var cycle_count : int in 0..100000 = 0 with min_interval = 10 s
    persist var fault_count : int in 0..1000 = 0 with min_interval = 10 s
    persist var last_test : SelftestResult = SelftestResult(passed = false, code = 0)
    pub var healthy : bool = false
    initial ACTIVE

    state ACTIVE:
        initial SELFTEST

        loop:
            check cell_mv < V_MAX + 50 mV, "cell overvoltage {cell_mv}"
            check not chg_status.bit(7), "charger fault flag"
            var masked : u8 = chg_status & 0x0F
            alert masked > 0x08, "charger status unusual"

        state SELFTEST:
            enter:
                led = 128
            loop:
                healthy = cell_mv > 3000 mV
            when healthy:
                last_test = SelftestResult(passed = true, code = 0)
                -> RUN
            after 2 s:
                last_test = SelftestResult(passed = false, code = 1)
                -> DEGRADED

        state RUN:
            loop:
                fet_chg = charger and cell_mv < V_MAX
                led = 255
                if image_state == TRIAL and last_test.passed:
                    image_confirm = true
            when not charger: -> IDLE_WAIT

        state IDLE_WAIT:
            when charger: -> RUN
            after 2 min: -> STANDBY

        state DEGRADED:
            enter:
                fet_chg = false
                led = 8
            after 24 h: -> SELFTEST

    state STANDBY idle:
        enter:
            fet_chg = false
            led = 0
        when button as e: -> ACTIVE
        when charger: -> ACTIVE
        when wake_up: -> ACTIVE
        after 7 d: -> ACTIVE

    state PROTECT:
        enter:
            fet_chg = false
            led = 255
            fault_count += 1
        when fault_count > 20: -> FAULTED
        after 10 s: -> ACTIVE

machine updater every 100 ms:
    fault -> UPD_FAILED
    var ctx : Sha256Ctx = sha256_init()
    var done_bytes : u32[B] = 0 B
    var digest : bytes<32> = default
    initial UPD_IDLE

    state UPD_IDLE:
        when image_state == TRIAL: -> HASHING

    state HASHING:
        enter:
            ctx = sha256_init()
            done_bytes = 0 B
            flash_cmd = NONE
        loop:
            if flash_status == IDLE and done_bytes < IMAGE_SIZE:
                flash_cmd = READ(addr = done_bytes, size = 256 B)
        on flash_rx as chunk:
            ctx = sha256_update(ctx, chunk.data)
            done_bytes += 256 B
            flash_cmd = NONE
        when done_bytes >= IMAGE_SIZE: -> VERIFYING
        after 30 s: -> UPD_FAILED

    state VERIFYING:
        sequence:
            digest = sha256_final(ctx)
            job sig = verify_sig(key = pubkey_bytes(), digest = digest, sig = signature_bytes())
            until sig.done timeout 500 ms -> UPD_FAILED
            expect sig.result, "signature invalid"
            -> UPD_OK

    state UPD_OK:
        enter:
            log "image verified"

    state UPD_FAILED:
        enter:
            flash_cmd = NONE
            log "image verification failed"

fn pubkey_bytes() -> bytes<64>:
    return default

fn signature_bytes() -> bytes<64>:
    return default
