# 93 — Bestaetigungszeiten und Flanken (5.6, 5.8, FB-335, FB-341): Ein
# `check … for d` scheitert erst nach `d` ununterbrochener Verletzung; eine
# kuerzere bleibt folgenlos. Ein `alert … for d` wird erst nach `d` aktiv.
# In einer `for`-Schleife hat jede Stelle je Durchlauf einen eigenen
# Zaehler und eine eigene Flanke: Mit einem gemeinsamen setzten die
# erfuellten Durchlaeufe den Zaehler des verletzten zurueck, und `every`
# liefe nur im ersten.

system:
    language = 1
    tick     = 1 ms

output k_out   : int in 0..999 @ hw("o/k")       with safe = 0
output tripped : bool          @ hw("o/tripped") with safe = false
output hits    : int in 0..999 @ hw("o/hits")    with safe = 0
output down    : bool          @ hw("o/down")    with safe = false

machine short:
    var k : int in 0..999 = 0
    fault -> TRIPPED
    initial RUN

    state RUN:
        loop:
            k = min(k + 1, 999)
            k_out = k
            check k < 3 or k > 5, "kurz verletzt" for 4 ms
            check k < 10, "lange verletzt" for 4 ms
            alert k >= 3 and k <= 5, "kurz" for 2 ms
            alert k >= 7, "lang"

    state TRIPPED:
        enter:
            tripped = true

machine rows:
    var n : int in 0..999 = 0
    var h : int in 0..999 = 0
    fault -> DOWN
    initial RUN

    state RUN:
        loop:
            n = min(n + 1, 999)
            for i in range(3):
                every 2 ms:
                    h = min(h + 1, 999)
                alert (n + i) % 3 == 0, "reihum {i}"
                check i > 0 or n < 20, "erste Zeile" for 3 ms
            hits = h

    state DOWN:
        enter:
            down = true
