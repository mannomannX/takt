# Prelude: vordefinierte Einheiten, Typen und Bibliothek (Referenz 3.2, 3.7,
# 5.3, 11.4). Es wird vor jedem Programm gelesen; Nutzerdefinitionen duerfen
# diese Namen verdecken (Warnung, 2.5).
#
# Die SI-Basiseinheiten m, kg, s, A, K, mol, cd und g stehen im Rust-Code
# (crates/takt-sema/src/units.rs), weil sie die Praefixregeln tragen.

system:
    language = 1

# --- abgeleitete SI-Einheiten (3.2) ------------------------------------
unit Hz    = 1 1/s
unit N     = 1 kg*m/s^2
unit Pa    = 1 N/m^2
unit J     = 1 N*m
unit W     = 1 J/s
unit C     = 1 A*s
unit V     = 1 W/A
unit ohm   = 1 V/A
unit F     = 1 C/V
unit Wb    = 1 V*s
unit T     = 1 Wb/m^2
unit H     = 1 Wb/A

# --- weitere Einheiten (3.2) -------------------------------------------
unit min   = 60 s^1
unit h     = 3600 s^1
unit d     = 86400 s^1
unit bar   = 100000 Pa
unit psi   = 6894.757293168 Pa
unit pct   = 0.01
unit B     = 1
unit Ah    = 3600 C
unit Wh    = 3600 J
unit degC  = affine(K, 273.15)
unit degR  = 5/9 K
unit degF  = affine(degR, 459.67)

# --- offene Enums (2.5) ------------------------------------------------
enum ArithKind: OVERFLOW, DIV_ZERO, NON_FINITE, DOMAIN, SINGULAR
enum RuntimeKind: OVERRUN, DRIVER, HARDWARE, NODE

enum FaultKind open:
    CHECK_FAILED
    EXPECT
    TIMEOUT
    SENSOR_FAULT
    MISSING_VALUE
    ARITHMETIC(kind: ArithKind)
    RANGE
    STREAM_OVERFLOW
    TIMING
    SCHEDULE_OVERFLOW
    ABORT
    RUNTIME(kind: RuntimeKind)

enum Quality open: GOOD, SUSPECT, STALE, BAD
enum Reason open: STALE, OUT_OF_RANGE, IMPLAUSIBLE, DRIVER, NODE
enum JobErr open: CANCELLED, FAILED, PENDING
enum BootReason open: POWER_ON, WATCHDOG, SOFTWARE, DEEP_SLEEP_WAKE, TRIAL
enum ImageState open: CONFIRMED, TRIAL
enum RebootCmd open: NONE, RESTART, DEEP_SLEEP, DEEP_SLEEP_FOR(duration: Duration)

# Start-Channels der Plattform (12.7): der eFuse-Block und sein Kommando.
record EfuseBlock:
    pubkey      : bytes<64>
    min_version : u32
    secure_boot : bool

enum EfuseCmd open: NONE, BURN_MIN_VERSION(version: u32), BURN_SECURE_BOOT

# Armierung eines Capture-Fensters (8.9); `level` traegt die Einheit des
# Kanals nicht — sie steht am Kanal, nicht am Kommando.
enum CaptureEdge: RISING, FALLING, BOTH
enum CaptureCmd open: NONE, ARM(pre: u32, level: float, edge: CaptureEdge)

# --- eingebaute Records (5.3, 8.6) -------------------------------------
record LastFault:
    kind    : FaultKind
    message : str<128>
    line    : int
    tick    : int

record Edge:
    rising : bool

# Zustand der Chunk-Natives sha256_init/update/final (4.5): opak heisst,
# ein Programm liest und schreibt seine Felder nicht.
record Sha256Ctx:
    h     : [8] u32
    buf   : bytes<64>
    total : u64

# --- Standardbibliothek: reine Funktionen (11.4) -----------------------
fn clamp[U](x: float[U], lo: float[U], hi: float[U]) -> float[U]:
    return lo if x < lo else (hi if x > hi else x)

fn lerp[U](a: float[U], b: float[U], t: float) -> float[U]:
    return a + (b - a) * t

fn map_range[U, V](x: float[U], x0: float[U], x1: float[U], y0: float[V], y1: float[V]) -> float[V]:
    return y0 + (y1 - y0) * ((x - x0) / (x1 - x0))

fn deadband[U](x: float[U], w: float[U]) -> float[U]:
    return 0 if abs(x) < w else x

# --- Standardbibliothek: schnelle Naeherungen (4.2, 11.4) ---------------
# Polynome fester Ordnung in Horner-Form als `fma`-Kette nach einer
# Bereichsreduktion (Cody-Waite): Jede Operation ist korrekt gerundet,
# also sind die Ergebnisse auf allen Zielen bitgleich (4.2) — ohne
# Native, die je Ziel eine zweite Rundungsquelle waere. Koeffizienten aus
# Cephes (S. L. Moshier). Die Schranken gelten gegen die korrekt
# gerundeten Funktionen aus `libtaktm` ueber den ganzen Parameterbereich
# und sind gemessen (takt-sema/tests/fast_math.rs).

const FAST_2_OVER_PI : float = 0.636619772367581343076
# pi/2 in drei Teilen, die ersten beiden mit wenigen Bits: `k * teil`
# ist in `f32` wie in `f64` exakt, die Reduktion verliert nichts.
const FAST_PIO2_1 : float = 1.5703125
const FAST_PIO2_2 : float = 4.837512969970703125e-4
const FAST_PIO2_3 : float = 7.54978995489188216e-8

# `sin` oder `cos` auf der reduzierten Stelle, um `shift` Viertel versetzt.
fn fast_quarter(x: float in -1.0e4..1.0e4, shift: int in 0..1) -> float:
    var k : int in -6400..6400 = round(x * FAST_2_OVER_PI)
    var kf : float = k as float
    var r : float = fma(0.0 - kf, FAST_PIO2_1, x)
    r = fma(0.0 - kf, FAST_PIO2_2, r)
    r = fma(0.0 - kf, FAST_PIO2_3, r)
    var z : float = r * r
    var ps : float = fma(fma(-1.9515295891e-4, z, 8.3321608736e-3), z, -1.6666654611e-1)
    var s : float = fma(ps * z, r, r)
    var pc : float = fma(fma(2.443315711809948e-5, z, -1.388731625493765e-3), z, 4.166664568298827e-2)
    var c : float = fma(pc * z, z, fma(-0.5, z, 1.0))
    var q : int in 0..3 = ((k + shift) % 4 + 4) % 4
    return s if q == 0 else (c if q == 1 else (0.0 - s if q == 2 else 0.0 - c))

# `sin(x)` fuer |x| <= 1e4. Absoluter Fehler hoechstens 5e-9 bei
# `float = f64`, 2e-7 bei `float = f32`.
fn sin_fast(x: float in -1.0e4..1.0e4) -> float:
    return fast_quarter(x, 0)

# `cos(x)` fuer |x| <= 1e4. Absoluter Fehler hoechstens 5e-9 bei
# `float = f64`, 2e-7 bei `float = f32`.
fn cos_fast(x: float in -1.0e4..1.0e4) -> float:
    return fast_quarter(x, 1)

const FAST_LOG2E : float = 1.44269504088896341
# ln 2 in zwei Teilen, der erste mit wenigen Bits (Cody-Waite).
const FAST_LN2_1 : float = 0.693359375
const FAST_LN2_2 : float = -2.12194440e-4

# `exp(x)` fuer |x| <= 80. `exp` ist nicht beschraenkt, die Schranke darum
# relativ: hoechstens 5e-9 bei `float = f64`, 3e-7 bei `float = f32`.
fn exp_fast(x: float in -80.0..80.0) -> float:
    var k : int in -116..116 = round(x * FAST_LOG2E)
    var kf : float = k as float
    var r : float = fma(0.0 - kf, FAST_LN2_1, x)
    r = fma(0.0 - kf, FAST_LN2_2, r)
    var p : float = 1.9875691500e-4
    p = fma(p, r, 1.3981999507e-3)
    p = fma(p, r, 8.3334519073e-3)
    p = fma(p, r, 4.1665795894e-2)
    p = fma(p, r, 1.6666665459e-1)
    p = fma(p, r, 5.0000001201e-1)
    var y : float = fma(p * r, r, r + 1.0)
    # 2^k exakt: Faktoren 2^(2^j) ueber die Bits von |k|, ohne Rundung.
    var base : float = 2.0 if k >= 0 else 0.5
    var n : int in 0..116 = abs(k)
    for j in range(7):
        if ((n >> j) & 1) == 1:
            y = y * base
        if j < 6:
            base = base * base
    return y

const FAST_TAN_3PI8 : float = 2.414213562373095
const FAST_TAN_PI8  : float = 0.4142135623730950
const FAST_PIO2     : float = 1.5707963267948966
const FAST_PIO4     : float = 0.7853981633974483
const FAST_PI       : float = 3.141592653589793

# `atan(a)` fuer a >= 0, reduziert auf |t| <= tan(pi/8).
fn fast_atan(a: float) -> float:
    var base : float = 0.0
    var t : float = a
    if a > FAST_TAN_3PI8:
        base = FAST_PIO2
        t = -1.0 / a
    elif a > FAST_TAN_PI8:
        base = FAST_PIO4
        t = (a - 1.0) / (a + 1.0)
    var z : float = t * t
    var p : float = 8.05374449538e-2
    p = fma(p, z, -1.38776856032e-1)
    p = fma(p, z, 1.99777106478e-1)
    p = fma(p, z, -3.33329491539e-1)
    return base + fma(p * z, t, t)

# `atan2(y, x)`. Absoluter Fehler hoechstens 2e-8 bei `float = f64`, 5e-7
# bei `float = f32`. `atan2_fast(0, 0)` ist 0; das Vorzeichen einer Null
# zaehlt nicht: `atan2_fast(-0, x)` mit `x < 0` ist `pi`, nicht `-pi`.
fn atan2_fast[U](y: float[U], x: float[U]) -> float:
    var ax : float[U] = abs(x)
    var ay : float[U] = abs(y)
    if ax == 0 and ay == 0:
        return 0.0
    var r : float = fast_atan(ay / ax) if ax >= ay else FAST_PIO2 - fast_atan(ax / ay)
    if x < 0:
        r = FAST_PI - r
    return 0.0 - r if y < 0 else r

# --- Standardbibliothek: Bloecke (5.7, 11.4) ----------------------------
block rising():
    var last : bool = false
    step(x: bool) -> bool:
        var rose : bool = x and not last
        last = x
        return rose

block falling():
    var last : bool = false
    step(x: bool) -> bool:
        var fell : bool = last and not x
        last = x
        return fell

block integrate[U](limit: float[U*s]):
    var acc : float[U*s] = 0
    step(x: float[U], dt: Duration in tick..1 h) -> float[U*s]:
        acc = acc + x * dt.as(s)
        if acc > limit:
            acc = limit
        elif acc < -limit:
            acc = -limit
        return acc

block lowpass[U](tau: Duration):
    var y    : float[U] = 0
    var init : bool = false
    step(x: float[U], dt: Duration in tick..1 h) -> float[U]:
        if not init:
            y = x
            init = true
        var a : float = dt.as(s) / (tau.as(s) + dt.as(s))
        y = y + a * (x - y)
        # 4.2: Ein Zustand, der gegen null abklingt, erreicht sonst die
        # Subnormalen; das Totband ist auf allen Zielen dasselbe.
        if abs(y) < 1e-30 U:
            y = 0 U
        return y

block hysteresis[U](lo: float[U], hi: float[U]):
    var active : bool = false
    step(x: float[U]) -> bool:
        if x >= hi:
            active = true
        elif x <= lo:
            active = false
        return active

block debounce(d: Duration):
    var last    : bool = false
    var settled : bool = false
    var held    : Duration = 0 s
    step(x: bool, dt: Duration in tick..1 h) -> bool:
        if x == last:
            held = held + dt
        else:
            last = x
            held = 0 s
        if held >= d:
            settled = last
        return settled

block rate[U]():
    var prev : float[U] = 0
    var init : bool = false
    step(x: float[U], dt: Duration in tick..1 h) -> float[U/s]:
        if not init:
            prev = x
            init = true
        var r : float[U/s] = (x - prev) / dt.as(s)
        prev = x
        return r

block rate_limiter[U](max_rate: float[U/s]):
    var y    : float[U] = 0
    var init : bool = false
    step(target: float[U], dt: Duration in tick..1 h) -> float[U]:
        if not init:
            y = target
            init = true
        var limit : float[U] = max_rate * dt.as(s)
        y = clamp(target, y - limit, y + limit)
        return y

block pid[O, E](kp: float[O/E], ki: float[O/E/s], kd: float[O*s/E], lo: float[O], hi: float[O]):
    var integral : float[O] = 0
    var prev_err : float[E] = 0
    step(err: float[E], dt: Duration in tick..1 h) -> float[O]:
        var dts : float[s] = dt.as(s)
        integral = clamp(integral + ki * err * dts, lo, hi)
        var deriv : float[O] = kd * (err - prev_err) / dts
        prev_err = err
        return clamp(kp * err + integral + deriv, lo, hi)

# Integer-Varianten fuer Kerne ohne FPU (3.2): Ein- und Ausgang nominal in
# int[U], die Aufloesung liegt in der Wahl der Einheit.
block lowpass_i[U](tau: Duration):
    # Zustand und Koeffizient mit 16 Nachkommabits, sonst bliebe ein Rest
    # unter (tau + dt) / dt stehen; der Wertebereich ist damit 2^31.
    var acc  : int[U] = 0
    var init : bool = false
    step(x: int[U], dt: Duration in tick..1 h) -> int[U]:
        if not init:
            acc = x * 65536
            init = true
        var a : int = 65536 * (dt / tick) / ((tau + dt) / tick)
        acc = acc + (x * 65536 - acc) * a / 65536
        return (acc + 32768 U) / 65536 if acc >= 0 else (acc - 32768 U) / 65536

block pid_i[O, E](kp: int[O/E], ki: int[O/E], kd: int[O/E], lo: int[O], hi: int[O]):
    # Verstaerkungen je Schritt: eine Zeitbasis braeuchte int[s], das es
    # aus einer Duration nicht gibt (3.3).
    var integral : int[O] = 0
    var prev_err : int[E] = 0
    step(err: int[E]) -> int[O]:
        integral = max(lo, min(hi, integral + ki * err))
        var deriv : int[O] = kd * (err - prev_err)
        prev_err = err
        return max(lo, min(hi, kp * err + integral + deriv))

block stopwatch():
    var acc : Duration = 0 s
    var run : bool = false
    step(dt: Duration in tick..1 h) -> Duration:
        if run:
            acc = acc + dt
        return acc
    start():
        run = true
    stop():
        run = false
    elapsed() -> Duration:
        return acc

block pulse_counter():
    var n : int = 0
    step(edges: int) -> int:
        n = n + edges
        return n

block cross_check[U](tol: float[U]):
    step(a: float[U], b: float[U]) -> float[U]?:
        if abs(a - b) > tol:
            return none
        return (a + b) * 0.5

block vote2oo3[U](tol: float[U]):
    step(a: float[U], b: float[U], c: float[U]) -> float[U]?:
        var ab : bool = abs(a - b) <= tol
        var bc : bool = abs(b - c) <= tol
        var ac : bool = abs(a - c) <= tol
        if not (ab or bc or ac):
            return none
        var lo : float[U] = min(a, min(b, c))
        var hi : float[U] = max(a, max(b, c))
        return a + b + c - lo - hi

block hold_last[U](max_hold: Duration):
    var last : float[U] = 0
    var have : bool = false
    var held : Duration = 0 s
    step(x: float[U]?, dt: Duration in tick..1 h) -> float[U]?:
        if x.valid:
            last = x.or(last)
            have = true
            held = 0 s
            return x
        held = held + dt
        if have and held <= max_hold:
            return last
        return none

block window_min[U, const N in 1..1024]():
    var buf  : [N] float[U] = default
    var next : int in 0..N-1 = 0
    var fill : int in 0..N = 0
    step(x: float[U]) -> float[U]:
        buf[next] = x
        next = 0 if next == N - 1 else next + 1
        if fill < N:
            fill = fill + 1
        var m : float[U] = buf[0]
        for i in range(N):
            if i < fill and buf[i] < m:
                m = buf[i]
        return m

block window_max[U, const N in 1..1024]():
    var buf  : [N] float[U] = default
    var next : int in 0..N-1 = 0
    var fill : int in 0..N = 0
    step(x: float[U]) -> float[U]:
        buf[next] = x
        next = 0 if next == N - 1 else next + 1
        if fill < N:
            fill = fill + 1
        var m : float[U] = buf[0]
        for i in range(N):
            if i < fill and buf[i] > m:
                m = buf[i]
        return m

block window_mean[U, const N in 1..1024]():
    var buf  : [N] float[U] = default
    var next : int in 0..N-1 = 0
    var fill : int in 0..N = 0
    step(x: float[U]) -> float[U]:
        buf[next] = x
        next = 0 if next == N - 1 else next + 1
        if fill < N:
            fill = fill + 1
        var s : float[U] = 0
        for i in range(N):
            if i < fill:
                s = s + buf[i]
        return s / (fill as float)

block window_rms[U, const N in 1..1024]():
    var buf  : [N] float[U] = default
    var next : int in 0..N-1 = 0
    var fill : int in 0..N = 0
    step(x: float[U]) -> float[U]:
        buf[next] = x
        next = 0 if next == N - 1 else next + 1
        if fill < N:
            fill = fill + 1
        var s : float[U^2] = 0
        for i in range(N):
            if i < fill:
                s = s + buf[i] * buf[i]
        return sqrt(s / (fill as float))

block reader[const N in 1..65536](b: bytes<N>):
    var buf : bytes<N> = b
    var pos : int in 0..N = 0
    u8() -> u8?:
        if pos >= buf.len:
            return none
        var v : u8 = buf[pos]
        pos = pos + 1
        return v
    u16_le() -> u16?:
        if pos + 2 > buf.len:
            return none
        var v : u16 = (buf[pos] as u16) | ((buf[pos + 1] as u16) << 8)
        pos = pos + 2
        return v
    u32_le() -> u32?:
        if pos + 4 > buf.len:
            return none
        var v : u32 = (buf[pos] as u32) | ((buf[pos + 1] as u32) << 8) | ((buf[pos + 2] as u32) << 16) | ((buf[pos + 3] as u32) << 24)
        pos = pos + 4
        return v
    remaining() -> int:
        return buf.len - pos

block writer[const N in 1..65536]():
    var buf : bytes<N> = default
    u8(x: u8) -> bool:
        var ok : bool = false
        ok = buf.push(x)
        return ok
    u16_le(x: u16) -> bool:
        if buf.len + 2 > N:
            return false
        buf.push((x & 0xFF) as u8)
        buf.push((x >> 8) as u8)
        return true
    u32_le(x: u32) -> bool:
        if buf.len + 4 > N:
            return false
        buf.push((x & 0xFF) as u8)
        buf.push(((x >> 8) & 0xFF) as u8)
        buf.push(((x >> 16) & 0xFF) as u8)
        buf.push((x >> 24) as u8)
        return true
    bytes(b: bytes<N>) -> bool:
        var ok : bool = false
        ok = buf.append(b)
        return ok
    mark() -> int:
        return buf.len
    patch_u16(m: int in 0..N-1, v: u16):
        buf[m] = (v & 0xFF) as u8
        buf[m + 1] = (v >> 8) as u8
    data() -> bytes<N>:
        return buf

# --- Beschraenkter QP-Loeser (11.4) -------------------------------------
const MAX_QP_ITERS : int = 200

# `qp_box` loest `min 1/2 x^T H x + g^T x` unter `lb <= x <= ub` mit
# projiziertem Gradienten in `ITERS` festen Iterationen. In Takt
# geschrieben und nicht als Native: Damit sind Interpreter und Codegen per
# Konstruktion einig (Satz 9.4.4), und die TCB waechst nicht.
#
# Die Iterationszahl ist ein Parameter mit statischer Obergrenze
# `MAX_QP_ITERS`: Das Budget rechnet mit der Schranke (5.8, 9.4.3),
# `iters` sagt, wann der Aufrufer abbrechen will.
#
# Die Schrittweite ist `1/L` mit `L` als Zeilensummennorm von `H` — eine
# obere Schranke des groessten Eigenwerts (Gerschgorin). Damit konvergiert
# das Verfahren fuer jedes positiv semidefinite `H`, ohne dass der Aufrufer
# eine Schrittweite raten muss. Ist `L` null (H = 0), ist das Problem
# linear und die Loesung liegt auf dem Rand; der Schritt ist dann 1.
#
# Totalitaet: Hoechstens `MAX_QP_ITERS` Iterationen laufen durch, `break`
# verlaesst sie frueher. Ohne Konvergenz ist `x` der letzte Iterierte und
# `converged` falsch — nie ein Fehler.
block qp_box[const N in 1..16](h: mat<N, N>, g: mat<N, 1>,
                               lb: mat<N, 1>, ub: mat<N, 1>,
                               iters: int in 1..MAX_QP_ITERS, tol: float):
    var x    : mat<N, 1> = default
    var done : bool      = false

    solve():
        # Schrittweite aus der Zeilensummennorm.
        var l : float = 0.0
        for i in range(N):
            var row : float = 0.0
            for j in range(N):
                row = row + abs(h[i, j])
            if row > l:
                l = row
        var gamma : float = 1.0 if l <= 0.0 else 1.0 / l

        # Start in der Box, damit jeder Iterierte zulaessig ist.
        for i in range(N):
            x[i, 0] = clamp(0.0, lb[i, 0], ub[i, 0])

        done = false
        # Die Schleife laeuft bis zur statischen Schranke; `iters` bricht
        # frueher ab. Die Schranke ist das Budget (5.8, 9.4.3), `iters`
        # die Absicht des Aufrufers — beide muessen dastehen.
        for k in range(MAX_QP_ITERS):
            if k >= iters:
                break
            var grad : mat<N, 1> = h * x + g
            var move : float = 0.0
            for i in range(N):
                var before = x[i, 0]
                x[i, 0] = clamp(before - gamma * grad[i, 0], lb[i, 0], ub[i, 0])
                var d = abs(x[i, 0] - before)
                if d > move:
                    move = d
            if move <= tol:
                done = true
                break

    result() -> mat<N, 1>:
        return x

    converged() -> bool:
        return done

# --- Simulationsmodelle (8.11) ------------------------------------------
# Geraete mit Kommando und Status: Das Programm deklariert `flash_cmd`,
# `flash_data`, `flash_status`, `flash_rx` wie in 8.11 und bindet sie beim
# Instanziieren an das Modell:
#   instance flash = flash_model(cmd = flash_cmd, data = flash_data,
#       status = flash_status_sim, rx = flash_rx_sim,
#       seed = flash_seed, seed_addr = flash_seed_addr,
#       sectors = 16, t_erase = 20 ms, t_program = 2 ms, cut_at_byte = 0)
# `seed` und `seed_addr` fuellen den Flash vor dem Test: Ein Szenario stellt
# `seed_addr` und sendet die Bytes, das Modell schreibt sie sofort ab dieser
# Adresse (ohne Busy, ohne Zaehlung fuer `cut_at_byte`).
enum FlashCmd: NONE, ERASE(sector: u32), PROGRAM(addr: u32, size: u32), READ(addr: u32, size: u32)
enum FlashStatus: IDLE, BUSY, DONE, ERROR(code: u8)

# Ein geloeschter Chunk liest 0xFF.
fn flash_blank() -> bytes<256>:
    var b : bytes<256> = default
    for i in range(256):
        b.push(0xFF)
    return b

# Flash-Modell: Sektoren zu 4096 Byte in Chunks zu 256 Byte, byteweise
# programmiert, Busy-Zeiten, Ruecklesen als ein Element von `rx`,
# Stromausfall-Injektion: `cut_at_byte > 0` bricht das Programmieren nach
# so vielen Bytes des Laufs (ueber alle PROGRAM-Kommandos gezaehlt) einmal
# mit ERROR(1) ab; geschrieben ist, was davor kam, der Rest bleibt
# geloescht. `data.sent` sind die im Tick gesendeten Bytes (8.8), `cmd`
# liest das Modell mit Unit-Delay.
machine flash_model(cmd: output FlashCmd, data: output stream<u8>, status: output FlashStatus, rx: output stream<bytes<4096>>, seed: input stream<u8>, seed_addr: input int, sectors: int in 1..4096, t_erase: Duration, t_program: Duration, cut_at_byte: int in 0..1_000_000):
    var mem     : map<int, bytes<256>, 256> = default
    var seed_at : int in 0..0xFFFF_FFFF = 0
    var seeded  : int in 0..0xFFFF_FFFF = 0
    var addr    : int in 0..0xFFFF_FFFF = 0
    var size    : int in 0..0xFFFF_FFFF = 0
    var written : int in 0..0xFFFF_FFFF = 0
    var total   : int in 0..1_000_000 = 0
    var cut     : bool = false
    var cut_done : bool = false
    var chunk   : bytes<256> = default
    var page    : bytes<4352> = default
    var out     : bytes<4096> = default
    var code    : u8 = 0
    var op      : int in 0..2 = 0
    var ok      : bool = false
    initial IDLE

    loop:
        if seed_addr.or(0) != seed_at:
            seed_at = seed_addr.or(0)
            seeded = 0
        for x in seed:
            chunk = mem.get((seed_at + seeded) / 256).or(flash_blank())
            chunk[(seed_at + seeded) % 256] = x.data
            ok = mem.insert((seed_at + seeded) / 256, chunk)
            seeded = seeded + 1

    state IDLE:
        enter:
            status = IDLE
        loop:
            match cmd:
                case ERASE(s):
                    addr = (s as int) * 4096
                    size = 4096
                    op = 0
                case PROGRAM(a, n):
                    addr = a as int
                    size = n as int
                    written = 0
                    cut = false
                    op = 1
                case READ(a, n):
                    addr = a as int
                    size = n as int
                    op = 2
                case _:
                    pass
            if cmd != NONE:
                if addr + size > sectors * 4096:
                    code = 2
                    -> FAILED
                elif op == 0:
                    -> ERASING
                elif op == 1:
                    -> PROGRAMMING
                else:
                    -> READING

    state ERASING:
        enter:
            status = BUSY
            for i in range(16):
                ok = mem.remove(addr / 256 + i)
        after t_erase: -> DONE_WAIT

    state PROGRAMMING:
        enter:
            status = BUSY
            code = 1
        loop:
            for x in data.sent.or(default):
                if written < size and not cut:
                    chunk = mem.get((addr + written) / 256).or(flash_blank())
                    chunk[(addr + written) % 256] = x
                    ok = mem.insert((addr + written) / 256, chunk)
                    written = written + 1
                    total = total + 1
                    cut = cut_at_byte > 0 and not cut_done and total >= cut_at_byte
        when cut:
            cut_done = true
            -> FAILED
        when written >= size: -> PROGRAM_DONE

    state PROGRAM_DONE:
        after t_program: -> DONE_WAIT

    state FAILED:
        enter:
            status = ERROR(code = code)
        when cmd == NONE: -> IDLE

    # Lesen ab jeder Adresse: die Chunks ab `addr / 256`, dann der
    # Ausschnitt ab `addr % 256`.
    state READING:
        enter:
            status = BUSY
            page = default
            for i in range(17):
                if page.len < addr % 256 + size:
                    ok = page.append(mem.get(addr / 256 + i).or(flash_blank()))
            out = default
            for i in range(4096):
                if i < size:
                    out.push(page[addr % 256 + i])
            send rx, out
        when true: -> DONE_WAIT

    state DONE_WAIT:
        enter:
            status = DONE
        when cmd == NONE: -> IDLE
