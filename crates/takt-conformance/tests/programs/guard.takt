system:
    language = 1
    tick     = 1 ms

# FB-331: `at T` mit `T <= now + guard` ist ein `TimingFault` (7.5, 9.8).
# Die Bruecke jedes Boards hat eine gemessene Treiberlatenz von einigen
# hundert Nanosekunden (F401) bis Mikrosekunden (C6): 1 ms voraus geht
# durch, 100 ns voraus nicht. Ohne Hardware-Konfiguration ist `guard` null
# wie in der Simulation.

output probe : bool @ hw("gpio/loop_out") with safe = false

machine m:
    initial FAR

    state FAR:
        enter:
            at now + 1 ms:
                probe = true
        after 5 ms: -> NEAR

    state NEAR:
        enter:
            at now + 100 ns:
                probe = false
