# `overrun.takt` fuer einen C-Wirt (12.11): dieselbe Last, dieselben
# Maschinen, die Ausgaenge im Sim-Build statt an Treibern, die ein C-Wirt
# nicht stellt. Ein Tick ueber seiner Periode (7.3, 5.4, FB-332): Im
# naechsten Tick bekommen alle Maschinen `Runtime(Overrun)` und nehmen ihren
# Fault-Pfad, auch die, die nichts rechnet.

system:
    language = 1
    tick     = 5 ms

output load    : int  @ sim("o/load")    with safe = -1
output tripped : bool @ sim("o/tripped") with safe = false

machine ramp:
    var n   : int in 0..1000 = 0
    var acc : int = 1
    fault -> SAFE
    initial RAMP

    state RAMP:
        loop:
            n = min(n + 1, 1000)
            load = n
            for i in range(1_000_000):
                if i >= n * 200:
                    break
                acc = (acc * 1103515245 + 12345) % 2147483648

    state SAFE:
        enter:
            tripped = true

machine bystander:
    fault -> PARKED
    initial WATCH

    state WATCH:
        loop:
            pass

    state PARKED:
        loop:
            pass
