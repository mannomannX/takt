# Neustart auf dem Board (12.7): Der erste Lauf endet nach 300 ms mit
# `next_run = NOW`, der zweite beginnt mit `previous_run = ENDED` und zeigt
# es eine Sekunde spaeter an `again` — spaet genug, dass der Wirt nach dem
# Ende des ersten Laufs wieder mitliest. Beide zeigen `previous_run` an
# `previous`; der erste kennt nach dem Flashen keinen vorigen Lauf. `safe`
# von `previous` ist ein Wert, den dieser Test nie erwartet. Der zweite
# Lauf endet nicht.

system:
    language = 1
    tick     = 10 ms

input  previous_run : PreviousRun @ hw("sys/previous_run")
output next_run     : NextRun     @ hw("sys/next_run")  with safe = NONE
output again        : bool        @ hw("ui/led")        with safe = false
output previous     : PreviousRun @ hw("test/previous") with safe = WATCHDOG

machine m:
    initial START

    state START:
        when previous_run == ENDED: -> WAITING
        after 300 ms: -> RESTARTING

    state RESTARTING:
        enter:
            previous = previous_run
            next_run = NOW

    state WAITING:
        after 1 s: -> AGAIN

    state AGAIN:
        enter:
            again = true
            previous = previous_run
