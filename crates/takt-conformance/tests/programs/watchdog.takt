# Watchdog auf dem Board (12.3, 12.7): Der erste Lauf zeigt
# `previous_run`, schlaeft eine Sekunde in `idle` — der Watchdog darf dabei
# nicht zuschlagen, die Schleife bestaetigt ihn je geschlafenem Tick — und
# rechnet dann einen Tick lang weit ueber seine Frist. Der Watchdog setzt
# zurueck, und der naechste Lauf beginnt mit `previous_run = WATCHDOG` und
# bleibt stehen. `AWAKE` haelt laenger als hundert Ticks, damit auch ein
# Board, das im Betrieb nur jeden hundertsten Tick ausgibt, `rested` zeigt.
# `safe` von `previous` ist ein Wert, den dieser Test nie erwartet.

system:
    language = 1
    tick     = 10 ms

input  previous_run : PreviousRun @ hw("sys/previous_run")
output previous     : PreviousRun @ hw("test/previous") with safe = ENDED
output rested       : bool        @ hw("ui/led")        with safe = false

machine m:
    var acc : int = 1
    initial SHOW

    state SHOW:
        enter:
            previous = previous_run
        after 200 ms: -> REST

    state REST idle:
        after 1 s: -> AWAKE

    state AWAKE:
        enter:
            rested = true
        after 1200 ms: -> DECIDE

    state DECIDE:
        when previous_run == WATCHDOG: -> DONE
        when true: -> HEAVY

    state HEAVY:
        enter:
            for i in range(1000):
                for j in range(3000):
                    acc = (acc * 1103515245 + 12345) % 2147483648

    state DONE:
        enter:
            rested = false
