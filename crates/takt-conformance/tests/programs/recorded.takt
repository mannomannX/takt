system:
    language = 1
    tick     = 10 ms

# Aufzeichnung ungebundener Kanaele (8.2, 12.5, M10 Schritt 29d): Die
# Konfiguration nennt fuenf Inputs, die das Programm nicht liest, und einen
# Output, den es nicht schreibt. Das Pruefgeraet des Bring-ups
# (`takt_board_support::edge_probe`) liefert vier der Inputs; der Rahmen
# zeichnet sie als `rec` auf, in Tick 0 und bei jeder Aenderung.

import channels from "recorded.hw"

enum Mode: IDLE, RUN, ERROR

output beat : bool @ hw("o/beat") with safe = false

machine m:
    initial RUN
    state RUN:
        loop:
            beat = true
