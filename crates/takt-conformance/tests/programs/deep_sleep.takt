# Ein Lauf, der nach einer Dauer weitergeht, auf dem Board (12.7, FB-309):
# Der erste Lauf endet mit `next_run = AFTER(delay = 2 s)`, und das Board
# schlaeft dazwischen ohne RAM. Der zweite beginnt mit
# `previous_run = ENDED` und zeigt es an `woke`; er endet nicht.

system:
    language = 1
    tick     = 10 ms

input  previous_run : PreviousRun @ hw("sys/previous_run")
output next_run     : NextRun     @ hw("sys/next_run")    with safe = NONE
output woke         : bool        @ hw("ui/led")          with safe = false

machine m:
    initial START

    state START:
        when previous_run == ENDED: -> AWAKE
        after 300 ms: -> SLEEP

    state SLEEP:
        enter:
            next_run = AFTER(delay = 2 s)

    state AWAKE:
        enter:
            woke = true
