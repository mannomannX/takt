# Ein Fuellventil (12.11): oeffnet alle 3 s fuer 2 s und zaehlt die
# Fuellungen. `examples/rust-host` bindet es als Baustein in ein
# Rust-Projekt und prueft es gegen den Interpreter.

system:
    language = 1
    tick     = 10 ms

output valve : bool @ hw("tank/valve") with safe = false
output fills : int in 0..1000 @ sim("tank/fills")

machine filler:
    var n : int in 0..1000 = 0
    initial CLOSED

    state CLOSED:
        enter:
            valve = false
        after 3 s: -> OPEN

    state OPEN:
        enter:
            valve = true
            n = (n + 1) % 1000
            fills = n
        after 2 s: -> CLOSED
