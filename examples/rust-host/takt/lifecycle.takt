# Ein Lauf durch die Huelle (12.11, GEN-028): `persist` zaehlt die Starts,
# ein Job rechnet SHA-256, ein `idle`-Zustand schlaeft bis zu seiner Frist
# (9.9), und `next_run` beendet den Lauf (12.7).

system:
    language = 1
    tick     = 10 ms

native job sha256(b: bytes<64>) -> bytes<32> with cost = 60000, stack = 640, duration = 25 ms, total

output boots    : int in 0..999 @ sim("o/boots")
output word     : u32           @ sim("o/word")
output next_run : NextRun       @ hw("sys/next_run") with safe = NONE

machine m:
    persist var starts : int in 0..999 = 0
    var msg            : bytes<64> = default

    initial START

    state START:
        sequence:
            starts = (starts + 1) % 1000
            boots = starts
            msg.push(0x61)
            job v = sha256(msg)
            until v.done timeout 1 s -> WAIT
            word = (v.result.or(default)[0] as u32) | ((v.result.or(default)[1] as u32) << 8)
            -> WAIT

    state WAIT idle:
        after 300 ms: -> END

    state END:
        enter:
            next_run = AFTER(delay = 5 s)
