__pycache__/
*.pyc
out/

# Eigene Probierdateien im Wurzelverzeichnis (nicht Teil des Korpus).
/test.takt
/scratch*.takt
# Erzeugte Flash-Abbilder des Bring-up-Programms.
*.bin

# Ein Cargo-Zielverzeichnis im Baum, etwa eines Arbeitsbaums mit eigenem
# CARGO_TARGET_DIR; der Hauptbaum baut nach G:/rust/target.
/target/
# Objekte von `takt build`, das ohne `--out` ins aktuelle Verzeichnis schreibt.
*.o
